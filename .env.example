# React Bits Pro registry key. Only needed for the @reactbits-starter and
# @reactbits-pro registries in components.json. The free @react-bits registry
# needs no key. Copy to .env.local (gitignored) or export via direnv.
REACTBITS_LICENSE_KEY=

# Contact form (/kontakt/) — see worker/README.md. The dev server always
# points at the deployed sidecar Worker, never a local one (see worker/README.md
# "Local dev"), so this must be a real workers.dev (or later, custom) URL even
# while developing.
PUBLIC_CONTACT_WORKER_URL=

# Cloudflare Turnstile site key, registered per-hostname in the dashboard.
# Until the real domain + Turnstile widget exist, Cloudflare's permanent test
# key for invisible/interaction-only mode (always passes) works end-to-end:
# 1x00000000000000000000BB
PUBLIC_TURNSTILE_SITE_KEY=
