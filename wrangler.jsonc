{
  "$schema": "https://json.schemastore.org/wrangler.json",
  // Worker name is also the workers.dev subdomain slug: this serves at
  // ellery-health.<account-subdomain>.workers.dev until a real domain is
  // attached. `site.domain` in src/config/site.ts is the canonical origin and
  // is what every canonical/hreflang/sitemap URL is built from.
  "name": "ellery-health",
  "compatibility_date": "2026-07-31",
  // Workers-with-assets shape (`wrangler deploy`). Cloudflare Pages
  // (`wrangler pages deploy`, used by deploy.yml.disabled) requires
  // `pages_build_output_dir` instead and ignores this field — confirmed
  // empirically. Custom 404 handling needs no field here either; the assets
  // binding auto-serves dist/404.html (see src/pages/404.astro) with zero
  // config.
  "assets": {
    "directory": "./dist"
  }
}
