---
import { type Locale, t, localizedPath } from "@/i18n";
import { site } from "@/config/site";
import Layout from "@/layouts/Layout.astro";
import SeoHead from "@/components/SeoHead.astro";
import Header from "@/components/sections/Header.astro";
import Footer from "@/components/sections/Footer.astro";
import ContactForm from "@/components/islands/ContactForm.tsx";
import CookieConsent from "@/components/islands/CookieConsent.tsx";
import { Image } from "astro:assets";
import officeMap from "@/assets/office-map.jpg";
import { Mail, MapPin, Phone } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const meta = d.meta.kontakt;
const content = d.kontakt;

// Deployment-specific, not locale-specific — read once at build time and
// handed down as plain props; the island itself never touches import.meta.env
// so it stays a portable, config-free component.
const workerUrl = import.meta.env.PUBLIC_CONTACT_WORKER_URL ?? "";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";

const hasAddress = Boolean(site.addressStreet && site.addressCountryCode);
// site.mapHref: a link out instead of an <iframe> embed — an embedded
// Google Maps frame sets Google's own cookies on page load, before any
// consent choice. A plain link only ever talks to Google if the visitor
// actually clicks it.
---

<Layout locale={locale} title={meta.title} description={meta.description}>
  <SeoHead slot="head" locale={locale} path="/kontakt/" />
  <Header locale={locale} />
  <main id="main" tabindex="-1" class="page-tint outline-none">
    <div class="mx-auto max-w-5xl px-4 py-20 sm:px-6 sm:py-24">
      {/* Same eyebrow + heading structure as Dienste/Über mich — eyebrow is
          allowed to say "Kontakt" (like Über mich's eyebrow saying "Über
          mich"), since it's the *heading* that must say something else. */}
      <p class="mb-3 text-xs font-bold uppercase leading-relaxed tracking-[0.28em] text-brand-700 dark:text-brand-400">
        {content.eyebrow}
      </p>
      <h1 class="text-3xl sm:text-4xl">{content.title}</h1>
      <p class="mt-3 max-w-2xl text-muted-foreground">{content.subtitle}</p>

      <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
        <div id="form" class="scroll-mt-24 rounded-2xl border border-border bg-card p-6 sm:p-8">
          <h2 class="subhead">{content.formTitle}</h2>
          <div class="mt-6">
            <ContactForm
              client:load
              workerUrl={workerUrl}
              turnstileSiteKey={turnstileSiteKey}
              labels={content.form}
              privacyHref={localizedPath(locale, "/privacy/")}
              success={content.success}
              errors={content.errors}
              phoneHref={site.phoneHref || undefined}
              phoneDisplay={site.phoneDisplay || undefined}
              mailHref={site.mailHref}
              email={site.email}
            />
          </div>
        </div>

        <aside class="flex flex-col gap-4">
          {/* One panel divided by hairlines (same treatment as the
              homepage's closing Contact block) instead of three separate
              bordered tiles. */}
          <div class="flex flex-col divide-y divide-border rounded-2xl bg-card">
            {/* Category labels (Anrufen/E-Mail/Adresse) dropped — the value
                itself (a phone number, an email address, a street address)
                is self-explanatory without one; kept as an aria-label
                instead so screen readers still get the context. */}
            {site.phoneHref && (
              <a
                href={site.phoneHref}
                aria-label={`${d.contact.phone}: ${site.phoneDisplay}`}
                class="flex items-center gap-3 py-3.5 first:pt-0 last:pb-0 hover:text-brand-700 dark:hover:text-brand-400"
              >
                <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-500/15 text-brand-700 dark:text-brand-400">
                  <Phone className="size-4" />
                </span>
                <span class="font-medium">{site.phoneDisplay}</span>
              </a>
            )}
            <a
              href={site.mailHref}
              aria-label={`${d.contact.email}: ${site.email}`}
              class="flex items-center gap-3 py-3.5 first:pt-0 last:pb-0 hover:text-brand-700 dark:hover:text-brand-400"
            >
              <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-500/15 text-brand-700 dark:text-brand-400">
                <Mail className="size-4" />
              </span>
              <span class="font-medium">{site.email}</span>
            </a>

            {hasAddress && (
              <a
                href={site.mapHref}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${d.contact.address}: ${site.addressStreet}, ${site.addressPostal} ${site.addressLocality}`}
                class="flex items-center gap-3 py-3.5 first:pt-0 last:pb-0 hover:text-brand-700 dark:hover:text-brand-400"
              >
                <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-500/15 text-brand-700 dark:text-brand-400">
                  <MapPin className="size-4" />
                </span>
                <span class="font-medium">
                  {site.addressStreet}, {site.addressPostal} {site.addressLocality}
                </span>
              </a>
            )}
          </div>

          {hasAddress && (
            <div class="flex flex-1 flex-col gap-1.5">
              {/* A pre-rendered map photo (src/assets/office-map.jpg, built by
                  `pnpm office-map` from OSM tiles), not a live embed — an
                  <iframe> Google/Maps embed sets the provider's own cookies on
                  every page load, before any consent choice; a static photo
                  behind a link only ever talks to Google if the visitor
                  actually clicks through. */}
              <a
                href={site.mapHref}
                target="_blank"
                rel="noopener noreferrer"
                class="group relative block min-h-56 flex-1 overflow-hidden rounded-2xl border border-border"
              >
                <Image
                  src={officeMap}
                  alt={`${site.name} – ${site.addressStreet}`}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  widths={[512, 768]}
                  sizes="18rem"
                />
                <span class="absolute inset-x-0 bottom-0 flex items-center justify-center gap-2 bg-gradient-to-t from-black/70 to-transparent px-3 pb-3 pt-8 text-center text-sm font-medium text-white opacity-0 transition-opacity group-hover:opacity-100">
                  <MapPin className="size-4" />
                  {content.mapCta}
                </span>
              </a>
              <p class="text-center text-[11px] text-muted-foreground">
                <a
                  href="https://www.openstreetmap.org/copyright"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-brand-700 dark:hover:text-brand-400"
                >
                  © OpenStreetMap contributors
                </a>
              </p>
            </div>
          )}
        </aside>
      </div>
    </div>
  </main>
  <Footer locale={locale} />
  <CookieConsent
    client:load
    message={d.cookieConsent.message}
    accept={d.cookieConsent.accept}
    decline={d.cookieConsent.decline}
  />
</Layout>
