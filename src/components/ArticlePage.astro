---
/**
 * One component for all three articles; the route shim passes a `slug`.
 *
 * The dictionary holds each article as a list of typed blocks (see
 * `LearnBlock` in `src/i18n/en/learn.ts`) and this file is the only thing that
 * knows how a block looks. Three reasons it is built that way rather than as
 * one HTML string per article:
 *
 * 1. NO FIGURE IS TYPED INTO COPY. `{token}` in a string is substituted here
 *    from `src/config/pricing.ts`, and every substituted figure comes out in
 *    the mono `.figure` face automatically. `{gating}` pulls the shared
 *    price-gating sentence from `common.ts` verbatim, so an article cannot
 *    paraphrase the one sentence that must not be paraphrased. A `dataTable`
 *    block goes further and takes its whole body from config — the titration
 *    ladders and the price tables below are generated, not transcribed.
 * 2. Evidence figures — trial durations, percentages, trial names — cannot
 *    come from pricing.ts but are still figures, so copy marks them `~like
 *    this~` and they render in mono too. That is what keeps a long-form page
 *    looking like the rest of this site.
 * 3. The footnote symbols are written inline in the copy and rendered as
 *    <sup> here, which means an editor cannot accidentally ship one that the
 *    compliance band does not resolve.
 *
 * THE READING EXPERIENCE, which is what the rebuild changed here. Prose is
 * capped at `.measure` (42rem, ~65 characters at this size) while tables get
 * the full `max-w-3xl`, because a four-column comparison at 42rem is
 * unreadable and this is the one page on the site with long-form text on it.
 * The table of contents grew a rail whose amber fill tracks how far through
 * the article you are — this route's ONE scroll-linked element, and it is a
 * CSS view-progress timeline rather than an island (see the style block at
 * the foot of this file). The two disclaimers were promoted rather than
 * demoted: "read this first" sits above the first paragraph with the signal
 * rule down its edge, and the clinician-review note closes the prose as a
 * labelled block instead of a grey sentence nobody reads.
 *
 * SIZES. The h1 here is a sentence-length title, so it takes `display-2`
 * rather than `display-1`, and every heading under it steps down one: the
 * article's own sections are `display-3`, and so is the "keep reading"
 * heading. That is why this page does not use `SectionHead.astro`, which
 * correctly hard-codes `display-2` for a section h2 — on this one page that
 * would tie the h1.
 */
import { type Locale, type Dictionary, t, localizedPath, htmlLang } from "@/i18n";
import { site } from "@/config/site";
import {
  fees,
  shipping,
  ladders,
  brandOptions,
  treatment,
  monthlyEquivalent,
  usd,
  usdMonthly,
  mg,
  membershipBreakEven,
} from "@/config/pricing";
import type { LearnBlock } from "@/i18n/en/learn";
import Layout from "@/layouts/Layout.astro";
import SeoHead from "@/components/SeoHead.astro";
import TrustTicker from "@/components/sections/TrustTicker.astro";
import Header from "@/components/sections/Header.astro";
import Cta from "@/components/sections/Cta.astro";
import ComplianceBand from "@/components/sections/ComplianceBand.astro";
import Footer from "@/components/sections/Footer.astro";
import { Image } from "astro:assets";
import learn01 from "@/assets/learn-01.jpg";
import learn02 from "@/assets/learn-02.jpg";
import learn03 from "@/assets/learn-03.jpg";
import { ArrowLeft, ArrowRight, ArrowUpRight } from "lucide-react";

type ArticleSlug = keyof Dictionary["meta"]["articles"];

interface Props {
  locale: Locale;
  slug: ArticleSlug;
}

const { locale, slug } = Astro.props;
const d = t(locale);

const thumbs = [learn01, learn02, learn03];
const entries = d.learn.articles.map((entry, index) => ({
  ...entry,
  image: thumbs[index % thumbs.length],
  href: localizedPath(locale, `/learn/${entry.slug}/`),
}));

const article = entries.find((entry) => entry.slug === slug);
if (!article) throw new Error(`ArticlePage: no article in the dictionary for slug "${slug}"`);
const others = entries.filter((entry) => entry.slug !== slug);

const path = `/learn/${slug}/`;
const pageMeta = d.meta.articles[slug];
const chrome = d.learn.article;

/* ------------------------------------------------------------------ */
/* Figures and shared sentences available to copy as {tokens}          */
/* ------------------------------------------------------------------ */

const sema = treatment("semaglutide");
const tirz = treatment("tirzepatide");
const nad = treatment("nad");
const semaLadder = ladders.semaglutide;
const tirzLadder = ladders.tirzepatide;
const top = (steps: typeof semaLadder) => steps[steps.length - 1].mg;

/** Substituted, then set in the mono face — every figure on this site is. */
const figures: Record<string, string> = {
  breakEvenBest: String(membershipBreakEven.best),
  breakEvenWorst: String(membershipBreakEven.worst),
  semaFrom: usdMonthly(sema.fromMonthly),
  tirzFrom: usdMonthly(tirz.fromMonthly),
  semaOne: usd(sema.oneMonth),
  tirzOne: usd(tirz.oneMonth),
  monthlyGap: usd(tirz.fromMonthly - sema.fromMonthly),
  semaTop: mg(top(semaLadder)),
  tirzTop: mg(top(tirzLadder)),
  /** The dose the diabetes head-to-head used, i.e. not the weight-management one. */
  semaMid: mg(semaLadder[2].mg),
  nadFrom: usdMonthly(nad.fromMonthly),
  nadOne: usd(nad.oneMonth),
  visit: usd(fees.visit),
  admin: usd(fees.admin),
  membership: usdMonthly(fees.membershipMonthly),
};

/** Substituted as plain prose. The gating sentences are quoted, never rewritten. */
const phrases: Record<string, string> = {
  gating: d.gating.short,
  gatingLong: d.gating.long,
  nadCadence: nad.cadence,
};

const escapeHtml = (raw: string): string =>
  raw.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

/** Inline mono runs sit a touch smaller than the sans around them: IBM Plex
    Mono is wider per character, and at 1em a figure mid-sentence reads as a
    size jump rather than as a change of voice. */
const monoSpan = (text: string): string =>
  `<span class="figure text-[0.95em]">${text}</span>`;
const supSymbol = (symbol: string): string =>
  symbol ? `<sup class="ml-px text-[0.68em] text-muted-foreground">${symbol}</sup>` : "";

/**
 * Copy -> HTML. Escapes first, then resolves the three conventions, so a
 * dictionary string can never inject markup: `{token}`, `~figure~`, and the
 * eight footnote symbols defined in `common.ts`.
 */
const rich = (raw: string): string =>
  escapeHtml(raw)
    .replace(/\{(\w+)\}/g, (whole: string, key: string) => {
      if (key in figures) return monoSpan(escapeHtml(figures[key]));
      if (key in phrases) return escapeHtml(phrases[key]);
      return whole;
    })
    .replace(/~([^~]+)~/g, (_whole: string, inner: string) => monoSpan(inner))
    .replace(/([*†‡§¶◆‖◇])/g, (_whole: string, symbol: string) => supSymbol(symbol));

/* ------------------------------------------------------------------ */
/* Blocks -> a single render model                                     */
/* ------------------------------------------------------------------ */

interface Cell {
  html: string;
  /** Rendered in the mono face and kept on one line: a price, a dose, a week. */
  mono: boolean;
}

type Rendered =
  | { kind: "h2"; text: string; id: string }
  | { kind: "p"; html: string }
  | { kind: "ul"; items: string[] }
  | { kind: "table"; caption: string; head: string[]; rows: Cell[][] }
  | { kind: "callout"; html: string }
  | { kind: "cta"; html: string; href: string; label: string };

const dash = "—";

/**
 * The rows a `dataTable` block asks for. Copy owns the caption and the column
 * headers; every cell below is generated from config, which is why an article
 * cannot quote a price or a dose the rest of the site does not charge or use.
 */
function dataRows(source: "ladders" | "metabolicPrices" | "receipt"): Cell[][] {
  if (source === "ladders") {
    const depth = Math.max(semaLadder.length, tirzLadder.length);
    return Array.from({ length: depth }, (_unused, index) => {
      const left = semaLadder[index];
      const right = tirzLadder[index];
      return [
        { html: left ? escapeHtml(left.weeks) : dash, mono: true },
        { html: left ? escapeHtml(mg(left.mg)) : dash, mono: true },
        { html: right ? escapeHtml(right.weeks) : dash, mono: true },
        { html: right ? escapeHtml(mg(right.mg)) : dash, mono: true },
      ];
    });
  }

  if (source === "metabolicPrices") {
    const compounded = [sema, tirz].map((item) => [
      { html: escapeHtml(item.display) + supSymbol("‡"), mono: false },
      { html: escapeHtml(usd(item.oneMonth)), mono: true },
      { html: escapeHtml(usd(item.threeMonth)), mono: true },
      { html: escapeHtml(usdMonthly(monthlyEquivalent(item))), mono: true },
    ]);
    const branded = brandOptions.map((option) => [
      {
        html: `${escapeHtml(option.display)} (${escapeHtml(option.molecule)})${supSymbol("‖")}`,
        mono: false,
      },
      { html: `${escapeHtml(usd(option.low))}–${escapeHtml(usd(option.high))}`, mono: true },
      { html: dash, mono: true },
      { html: dash, mono: true },
    ]);
    return [...compounded, ...branded];
  }

  // The receipt, line for line as `Receipt.astro` renders it on the homepage:
  // same rows, same amounts, same two words that are deliberately not numbers.
  const amounts = [
    usd(fees.visit),
    d.home.receipt.atCost,
    shipping.standardCost === 0 ? d.home.receipt.included : usd(shipping.standardCost),
    usd(fees.admin),
  ];
  const symbols = ["", "‡", "", "†"];
  return d.home.receipt.rows.map((row, index) => [
    { html: escapeHtml(row.item), mono: false },
    { html: escapeHtml(amounts[index]) + supSymbol(symbols[index]), mono: true },
    { html: escapeHtml(row.dest), mono: false },
  ]);
}

const slugify = (text: string): string =>
  text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const blocks: LearnBlock[] = article.body;

const rendered: Rendered[] = blocks.map((block): Rendered => {
  switch (block.type) {
    case "h2":
      return { kind: "h2", text: block.text, id: slugify(block.text) };
    case "p":
      return { kind: "p", html: rich(block.text) };
    case "ul":
      return { kind: "ul", items: block.items.map(rich) };
    case "callout":
      return { kind: "callout", html: rich(block.text) };
    case "cta":
      return {
        kind: "cta",
        html: rich(block.text),
        href: localizedPath(locale, block.to),
        label: block.label,
      };
    case "table":
      return {
        kind: "table",
        caption: block.caption,
        head: block.head,
        rows: block.rows.map((row) => row.map((cell) => ({ html: rich(cell), mono: false }))),
      };
    case "dataTable":
      return {
        kind: "table",
        caption: block.caption,
        head: block.head,
        rows: dataRows(block.source),
      };
  }
});

const contents = rendered.filter(
  (block): block is Extract<Rendered, { kind: "h2" }> => block.kind === "h2",
);

/* ------------------------------------------------------------------ */
/* Structured data                                                     */
/* ------------------------------------------------------------------ */

const canonical = new URL(localizedPath(locale, path), site.domain).href;

/**
 * `author` and `publisher` reference the Organization `SeoHead` declares
 * rather than redeclaring it — verify-dist.mjs fails on an @id that no block
 * on the page defines.
 */
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${canonical}#article`,
  headline: article.title,
  description: article.dek,
  articleSection: article.category,
  datePublished: article.publishedIso,
  dateModified: article.updatedIso,
  inLanguage: htmlLang[locale],
  isAccessibleForFree: true,
  url: canonical,
  author: { "@id": `${site.domain}/#business` },
  publisher: { "@id": `${site.domain}/#business` },
};

const crumbs = [
  { name: chrome.home, href: localizedPath(locale, "/") },
  { name: d.learn.eyebrow, href: localizedPath(locale, "/learn/") },
  { name: article.title, href: localizedPath(locale, path) },
];

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((crumb, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: crumb.name,
    item: new URL(crumb.href, site.domain).href,
  })),
};
---

<Layout locale={locale} title={pageMeta.title} description={pageMeta.description}>
  <SeoHead slot="head" locale={locale} path={path} />
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(articleJsonLd)}
  />
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbJsonLd)}
  />
  <Header locale={locale} />
  <main id="main" tabindex="-1" class="outline-none">
    <article>
      {/* Header block: the article's own metadata, then the disclaimer —
          prominent, above the first paragraph, not in small print. */}
      <section class="page-top bg-background pb-12 sm:pb-14">
        <div class="shell">
          <nav aria-label="Breadcrumb">
            <ol class="label flex flex-wrap items-center gap-2.5 text-muted-foreground">
              {
                crumbs.slice(0, 2).map((crumb, index) => (
                  <>
                    {index > 0 && <li aria-hidden="true">/</li>}
                    <li>
                      <a href={crumb.href} class="hover:text-foreground">
                        {crumb.name}
                      </a>
                    </li>
                  </>
                ))
              }
            </ol>
          </nav>

          <div class="mt-8 max-w-3xl">
            <p class="label flex flex-wrap items-center gap-3 text-muted-foreground">
              <span class="text-signal-700 dark:text-signal-500">{article.category}</span>
              <span aria-hidden="true">·</span>
              <span class="figure font-normal tracking-normal">
                {article.readMinutes} {d.learn.readTime}
              </span>
            </p>
            <h1 class="display-2 mt-5 text-balance">{article.title}</h1>
            <p class="lead mt-5 max-w-2xl text-lg text-pretty">{article.dek}</p>
            <p class="label mt-7 flex flex-wrap items-center gap-3 text-muted-foreground">
              <span>{d.learn.reviewedBy}</span>
              <span aria-hidden="true">·</span>
              <span>{d.learn.updated}</span>
              <time datetime={article.updatedIso} class="figure font-normal tracking-normal">
                {article.updated}
              </time>
            </p>
          </div>

          {/* The signal rule is the loudest thing on the page short of the
              closing plate, and it is spent on the sentence that matters most
              on a page about a prescription medication. */}
          <aside class="panel mt-9 max-w-3xl border-l-2 border-l-signal-500 p-6">
            <p class="label text-signal-700 dark:text-signal-500">{chrome.disclaimerLabel}</p>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-foreground">
              {d.learn.disclaimer}
            </p>
          </aside>
        </div>
      </section>

      {/* The ticker closes the head block, the same slot it takes under the
          hero on the homepage. It cannot sit above the nav any more: the
          header floats. */}
      <TrustTicker locale={locale} />

      {/* The article itself, with the table of contents in a rail that sticks
          beside the prose on lg and simply sits above it below that. */}
      <section class="bg-background section-tight">
        <div class="shell">
          <div class="article-grid grid gap-10 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-16">
            <aside class="lg:col-start-2 lg:row-start-1">
              <nav
                data-toc
                aria-labelledby="toc-heading"
                class="panel p-5 lg:sticky lg:top-32 lg:border-0 lg:bg-transparent lg:p-0"
              >
                <p id="toc-heading" class="label text-muted-foreground">{chrome.toc}</p>

                <div class="mt-4 flex gap-4">
                  {/* THE READING RAIL. The track is furniture; the amber fill
                      is the measurement, and amber on this site is what
                      measures time. Reading position is elapsed time, so the
                      accent is doing its declared job rather than decorating,
                      and it replaces the read-time estimate above with
                      something the reader can actually check. */}
                  <div class="relative w-0.5 shrink-0 rounded-full bg-border" aria-hidden="true">
                    <span class="toc-fill absolute inset-x-0 top-0 h-full origin-top rounded-full bg-signal-500"
                    ></span>
                  </div>

                  <ol class="flex min-w-0 flex-1 flex-col gap-3">
                    {
                      contents.map((heading, index) => (
                        <li class="toc-row flex gap-3">
                          {/* Inactive indices are muted, not amber: signal-500
                              as small text on paper is 1.9:1 and fails AA.
                              The active one steps to signal-700, which is
                              5.6:1 on this ground. */}
                          <span class="toc-index figure mt-0.5 shrink-0 text-xs text-muted-foreground">
                            {String(index + 1).padStart(2, "0")}
                          </span>
                          <a
                            href={`#${heading.id}`}
                            class="toc-link text-sm leading-snug text-muted-foreground transition-colors hover:text-foreground"
                          >
                            {heading.text}
                          </a>
                        </li>
                      ))
                    }
                  </ol>
                </div>
              </nav>
            </aside>

            {/* `data-article-prose` is the observer's hook below, and the
                subject of the rail's view-progress timeline. */}
            <div
              class="article-prose max-w-3xl lg:col-start-1 lg:row-start-1"
              data-article-prose
            >
              {
                rendered.map((block) => (
                  <>
                    {block.kind === "h2" && (
                      /* No `scroll-mt-*` here: global.css gives every `h2[id]`
                         a 7.5rem scroll margin, which is the floating
                         header's clearance, in one place for the whole site. */
                      <h2 id={block.id} class="display-3 mt-14 first:mt-0">
                        {block.text}
                      </h2>
                    )}

                    {block.kind === "p" && (
                      <p
                        class="measure mt-5 text-[1.0625rem] leading-[1.75] text-foreground sm:text-lg"
                        set:html={block.html}
                      />
                    )}

                    {block.kind === "ul" && (
                      <ul class="measure mt-6 flex flex-col gap-3.5">
                        {block.items.map((item) => (
                          <li class="flex gap-3.5 text-[1.0625rem] leading-[1.7] text-foreground">
                            <span
                              class="mt-2.5 size-1.5 shrink-0 rounded-full bg-muted-foreground"
                              aria-hidden="true"
                            />
                            <span set:html={item} />
                          </li>
                        ))}
                      </ul>
                    )}

                    {/* Recessed rather than ruled. The signal rule is already
                        spent on the disclaimer at the top of the page, and a
                        device used twice stops being a signal. */}
                    {block.kind === "callout" && (
                      <aside class="panel-flat measure mt-8 p-5 sm:p-6">
                        <p
                          class="text-[0.9375rem] leading-relaxed text-foreground"
                          set:html={block.html}
                        />
                      </aside>
                    )}

                    {block.kind === "table" && (
                      /* The table gets a card of its own. It is the widest
                         object in the column and the only one that breaks the
                         reading measure, so it should look like a deliberate
                         inset rather than like prose that ran wide. */
                      <figure class="panel mt-10 p-5 sm:p-6">
                        <figcaption class="label text-muted-foreground">{block.caption}</figcaption>

                        {/* sm and up: the real table. */}
                        <div class="mt-4 hidden overflow-x-auto sm:block">
                          <table class="w-full border-collapse text-left">
                            <thead>
                              <tr class="border-y border-border">
                                {block.head.map((cell, index) => (
                                  <th
                                    scope="col"
                                    class:list={[
                                      "label py-3 align-bottom text-muted-foreground",
                                      index === 0 ? "pr-4" : "pl-4",
                                    ]}
                                  >
                                    {cell}
                                  </th>
                                ))}
                              </tr>
                            </thead>
                            <tbody>
                              {block.rows.map((row) => (
                                <tr class="border-b border-hairline align-top last:border-0">
                                  {row.map((cell, index) =>
                                    index === 0 ? (
                                      <th
                                        scope="row"
                                        class:list={[
                                          "py-4 pr-4 text-[0.9375rem] leading-relaxed",
                                          cell.mono ? "figure font-normal whitespace-nowrap" : "font-semibold",
                                        ]}
                                        set:html={cell.html}
                                      />
                                    ) : (
                                      <td
                                        class:list={[
                                          "py-4 pl-4 text-[0.9375rem] leading-relaxed",
                                          cell.mono
                                            ? "figure whitespace-nowrap text-foreground"
                                            : "text-muted-foreground",
                                        ]}
                                        set:html={cell.html}
                                      />
                                    ),
                                  )}
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>

                        {/* Below sm: the same rows as a definition list. A
                            four-column comparison at 360px is unreadable. */}
                        <dl class="mt-4 flex flex-col sm:hidden">
                          {block.rows.map((row) => (
                            <div class="border-t border-hairline py-4">
                              {/* A name labels itself; a figure does not, so a
                                  mono first cell keeps its column heading. */}
                              {row[0].mono && (
                                <p class="label text-muted-foreground">{block.head[0]}</p>
                              )}
                              <dt
                                class:list={[
                                  row[0].mono ? "figure mt-1 text-[0.9375rem]" : "subhead",
                                ]}
                                set:html={row[0].html}
                              />
                              {row.slice(1).map((cell, index) => (
                                <dd class="mt-2.5">
                                  <span class="label block text-muted-foreground">
                                    {block.head[index + 1]}
                                  </span>
                                  <span
                                    class:list={[
                                      "mt-1 block text-sm leading-relaxed",
                                      cell.mono ? "figure text-foreground" : "text-muted-foreground",
                                    ]}
                                    set:html={cell.html}
                                  />
                                </dd>
                              ))}
                            </div>
                          ))}
                        </dl>
                      </figure>
                    )}

                    {block.kind === "cta" && (
                      <div class="measure mt-12 border-t border-border pt-6">
                        <p
                          class="text-[0.9375rem] leading-relaxed text-muted-foreground"
                          set:html={block.html}
                        />
                        <a href={block.href} class="btn-outline mt-5">
                          {block.label}
                          <ArrowRight className="size-4" />
                        </a>
                      </div>
                    )}
                  </>
                ))
              }

              {/* The review note closes the prose as a labelled block. It used
                  to be a grey sentence in the same size as a caption, which is
                  where a reader stops looking; on a page in this category the
                  provenance of the text is part of the text. */}
              <aside class="measure mt-14 border-t border-border pt-6">
                <p class="label text-signal-700 dark:text-signal-500">{d.learn.reviewedBy}</p>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                  {chrome.reviewNote}
                </p>
                <p class="label mt-4 text-muted-foreground">
                  {d.learn.updated}{" "}
                  <time datetime={article.updatedIso} class="figure font-normal tracking-normal">
                    {article.updated}
                  </time>
                </p>
              </aside>
            </div>
          </div>
        </div>
      </section>
    </article>

    {/* The other two articles, in the same row vocabulary the index uses for
        everything below its featured piece, so the two surfaces read as one
        system rather than as two card designs. */}
    <section class="bg-card section">
      <div class="shell">
        <div class="reveal flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
          <div class="max-w-2xl">
            <p class="label text-signal-700 dark:text-signal-500">{chrome.nextTitle}</p>
            {/* `display-3`, not `SectionHead`: see the SIZES note at the top
                of this file. On this one page a `display-2` section heading
                would be the same size as the h1 above it. */}
            <h2 class="display-3 mt-4">{d.learn.title}</h2>
            <p class="lead mt-4">{chrome.nextLead}</p>
          </div>
          <a
            href={localizedPath(locale, "/learn/")}
            class="group inline-flex shrink-0 items-center gap-2 text-[0.9375rem] font-semibold text-foreground transition-colors hover:text-signal-700 dark:hover:text-signal-500"
          >
            <ArrowLeft className="size-4 transition-transform group-hover:-translate-x-1" />
            {chrome.backToIndex}
          </a>
        </div>

        <ul class="reveal mt-10 max-w-3xl">
          {
            others.map((entry) => (
              <li class="group relative grid grid-cols-[auto_1fr_auto] items-center gap-4 border-t border-border py-5 last:border-b sm:gap-5 sm:py-6">
                <div class="aspect-[4/3] w-24 shrink-0 overflow-hidden rounded-lg bg-muted sm:w-28">
                  <Image
                    src={entry.image}
                    alt=""
                    widths={[112, 224, 336]}
                    sizes="7rem"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </div>

                <div class="min-w-0">
                  <p class="label flex flex-wrap items-center gap-2.5 text-muted-foreground">
                    <span class="text-signal-700 dark:text-signal-500">{entry.category}</span>
                    <span aria-hidden="true">·</span>
                    <span class="figure font-normal tracking-normal">
                      {entry.readMinutes} {d.learn.readTime}
                    </span>
                  </p>
                  {/* The link wraps the title only, so a screen reader hears
                      the headline rather than the headline with a category and
                      a read time read out in front of it; the overlay keeps
                      the whole row clickable. */}
                  <h3 class="subhead mt-2 text-pretty">
                    <a
                      href={entry.href}
                      class="transition-colors after:absolute after:inset-0 group-hover:text-signal-700 dark:group-hover:text-signal-500"
                    >
                      {entry.title}
                    </a>
                  </h3>
                </div>

                <ArrowUpRight
                  className="size-4 shrink-0 text-muted-foreground transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                  aria-hidden="true"
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <Cta locale={locale} />
    <ComplianceBand locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>

<style>
  /* ===============================================================
     THE READING RAIL — this route's one scroll-linked element, and
     it is CSS.

     The rail's amber fill is driven by a VIEW-PROGRESS TIMELINE on
     the prose column, not by the document scroll position: the
     `contain` range runs from "the prose top reaches the viewport
     top" to "the prose bottom reaches the viewport bottom", which is
     exactly the range in which the reader is reading. A root scroll
     timeline would count the header, the ticker, the next-reads band
     and the footer, and the rail would sit at two thirds when the
     last paragraph ended.

     `timeline-scope` is what lets the fill — which lives in the
     sticky aside — read a timeline declared on its sibling. Both are
     descendants of `.article-grid`.

     The plan for this rail was a Motion island using useScroll. That
     would have been the only hydrated island on these three routes
     and, since `motion` is in no other bundle on this site, it would
     have created a 34 KB vendor chunk to fill one hairline. This is
     the same visual for no bytes.

     The fill is DECORATION (`aria-hidden`), and it is the one thing
     on the site allowed to be absent in its base state: with no
     scroll-timeline support, or with reduced motion, the track
     simply stays empty. Nothing that carries text is hidden, which
     is the rule that matters.
     =============================================================== */
  .article-grid {
    timeline-scope: --article-read;
  }
  .article-prose {
    view-timeline: --article-read block;
  }
  .toc-fill {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) and (timeline-scope: --probe) {
      .toc-fill {
        display: block;
        /* Order matters: the `animation` shorthand resets
           `animation-timeline` to `auto`, so the timeline is assigned
           after it. */
        animation: toc-fill linear both;
        animation-timeline: --article-read;
        animation-range: contain 0% contain 100%;
      }
    }
  }
  @keyframes toc-fill {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  /* The heading you are currently in, set by the observer below. An instant
     colour swap, so there is nothing here for reduced motion to turn off. */
  .toc-row.is-current .toc-link {
    color: var(--foreground);
  }
  .toc-row.is-current .toc-index {
    color: var(--color-signal-700);
  }
  :global(.dark) .toc-row.is-current .toc-index {
    color: var(--color-signal-500);
  }
</style>

<script>
  /**
   * Marks the table-of-contents row for the heading being read.
   *
   * An IntersectionObserver rather than a scroll listener: the callback only
   * runs when a heading crosses the header line, so scrolling through a long
   * section costs nothing. The rect arithmetic inside it is what makes "the
   * last heading you passed" correct when two headings are on screen at once
   * — an observer alone only knows which elements intersect, not which one
   * you are under.
   *
   * The list itself is server-rendered and works without this: every row is a
   * real in-page anchor. This only adds the highlight.
   */
  const nav = document.querySelector<HTMLElement>("[data-toc]");
  const headings = Array.from(
    document.querySelectorAll<HTMLElement>("[data-article-prose] h2[id]"),
  );

  if (nav && headings.length > 0) {
    const rows = new Map<string, HTMLElement>();
    nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      const row = link.closest("li");
      if (row) rows.set(decodeURIComponent(link.hash.slice(1)), row);
    });

    /* The floating header's clearance, matching the `scroll-margin-top` that
       global.css gives every `h2[id]`: a heading above this line has been
       scrolled past. */
    const headerLine = 120;
    let current = "";

    const sync = () => {
      const passed = headings.filter((h) => h.getBoundingClientRect().top <= headerLine);
      const id = (passed[passed.length - 1] ?? headings[0]).id;
      if (id === current) return;
      current = id;
      rows.forEach((row, key) => {
        const on = key === id;
        row.classList.toggle("is-current", on);
        const link = row.querySelector("a");
        if (!link) return;
        /* `location`, not `page`: these anchors point inside the current
           document rather than to the page you are on. */
        if (on) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };

    const observer = new IntersectionObserver(sync, {
      rootMargin: `-${headerLine}px 0px 0px 0px`,
    });
    headings.forEach((heading) => observer.observe(heading));
    sync();
  }
</script>
