---
/**
 * /pricing/ — the page the site's positioning stands or falls on.
 *
 * Structure, and why it is this order:
 *
 *  1. Header — the model in one sentence, plus the three amounts as figures.
 *  2. The receipt in full — the homepage's four lines, each one now also
 *     justifying its own shape. The administration-fee paragraph is the
 *     load-bearing one on the whole site.
 *  3. Per-preparation prices — all six preparations at both supply lengths,
 *     plus the brand-name alternatives as a range. Publishing the whole grid,
 *     including the expensive rows, is the opposite of a "from" price and is
 *     the clearest premium signal available on a pricing page.
 *  4. Membership — a comparison across the rows a buyer actually feels, then
 *     a break-even computed from `fees` that argues against buying it.
 *  5. Delivery.
 *  6. The two boundary lists, on the page's one fixed-dark band.
 *  7. Eligibility thresholds, so a reader can check themselves before paying.
 *
 * EVERY figure on this page is read from `src/config/pricing.ts`. Nothing
 * numeric is typed here or in the dictionary, and the sentences that need a
 * number carry a token the component substitutes — the same mechanism
 * `TrustTicker.astro` uses.
 */
import { type Locale, t, localizedPath } from "@/i18n";
import { anchors } from "@/config/site";
import {
  fees,
  shipping,
  sla,
  coverage,
  eligibility,
  treatmentsIn,
  brandOptions,
  monthlyEquivalent,
  usd,
  usdMonthly,
  membershipBreakEvenOrders,
  type ProgramId,
} from "@/config/pricing";
import Layout from "@/layouts/Layout.astro";
import SeoHead from "@/components/SeoHead.astro";
import TrustTicker from "@/components/sections/TrustTicker.astro";
import Header from "@/components/sections/Header.astro";
import Cta from "@/components/sections/Cta.astro";
import ComplianceBand from "@/components/sections/ComplianceBand.astro";
import Footer from "@/components/sections/Footer.astro";
import { ArrowRight, Check, Clock, Minus } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const c = d.pricingPage;

/* ---------------------------------------------------------------- */
/* Header figures                                                    */
/* ---------------------------------------------------------------- */

const headerValues = [usd(fees.admin), usd(fees.visit), c.receipt.atCost];
const headerFigures = c.header.figures.map((figure, index) => ({
  ...figure,
  value: headerValues[index],
}));

/* ---------------------------------------------------------------- */
/* The receipt                                                       */
/* ---------------------------------------------------------------- */

/**
 * Positionally matched to `c.receipt.rows`, exactly as `Receipt.astro` does
 * it on the homepage — the same four lines from the same two constants, so
 * the preview and the full page cannot disagree.
 */
const receiptAmounts = [
  usd(fees.visit),
  c.receipt.atCost,
  shipping.standardCost === 0 ? c.receipt.included : usd(shipping.standardCost),
  usd(fees.admin),
];
const receiptSymbols = ["*", "‡", "", "†"];
const receiptRows = c.receipt.rows.map((row, index) => ({
  ...row,
  amount: receiptAmounts[index],
  symbol: receiptSymbols[index],
}));

/* ---------------------------------------------------------------- */
/* Per-preparation prices                                            */
/* ---------------------------------------------------------------- */

/** Ids are declared here, typed, rather than in the dictionary as strings. */
const programIds: ProgramId[] = ["metabolic", "longevity"];
const programGroups = programIds.map((id, index) => ({
  id,
  copy: c.treatments.programs[index],
  href: localizedPath(locale, id === "metabolic" ? "/weight-loss/" : "/longevity/"),
  linkLabel: d.programs.items[index].cta,
  /** `‡` on both, plus the program's own note symbol. */
  symbols: id === "metabolic" ? ["‡", "§"] : ["‡", "¶"],
  rows: treatmentsIn(id),
}));

const brandRows = brandOptions.map((option) => ({
  ...option,
  range: `${usd(option.low)}–${usd(option.high)}`,
}));

/* ---------------------------------------------------------------- */
/* Membership                                                        */
/* ---------------------------------------------------------------- */

const m = c.membership;

/**
 * Positionally matched to `m.rows`. `changed` marks the three rows where
 * membership actually alters something; the other three say "the same" out
 * loud, because a comparison table where every row favours the upsell is a
 * sales sheet rather than a comparison.
 */
const membershipValues = [
  { payg: usd(fees.admin), member: m.waived, changed: true },
  { payg: usd(shipping.overnightCost), member: m.includedWord, changed: true },
  { payg: m.atPharmacyCost, member: m.theSame, changed: false },
  { payg: usd(fees.visit), member: m.theSame, changed: false },
  { payg: m.queueOrder, member: m.theSame, changed: false },
  { payg: m.nothingToCancel, member: m.cancelAnyTime, changed: true },
];
const membershipRows = m.rows.map((row, index) => ({ ...row, ...membershipValues[index] }));

/**
 * THE BREAK-EVEN. Membership waives the administration fee and includes
 * overnight, so its value per order is those two amounts — but only the first
 * counts for a reader who was happy with standard delivery. Both cases are
 * computed and both are published, on both billing periods, because the
 * friendliest of the four is the only one this category ever quotes.
 */
const withOvernight = fees.admin + shipping.overnightCost;
const yearlyCost = fees.membershipYearly;
const monthlyCost = fees.membershipMonthly * 12;
// Same arithmetic as the homepage's membership card, from one shared function
// in pricing.ts rather than repeated here — the two surfaces previously
// disagreed (four orders a year vs seven).
const breakEvenOrders = membershipBreakEvenOrders();
const breakEvenCaseValues = [
  Math.ceil(monthlyCost / withOvernight),
  Math.ceil(yearlyCost / fees.admin),
  Math.ceil(monthlyCost / fees.admin),
];
const breakEvenCases = m.breakEven.cases.map((label, index) => ({
  label,
  value: breakEvenCaseValues[index],
}));
const breakEvenNote = m.breakEven.headlineNote.replaceAll(
  "{weeks}",
  String(Math.round(52 / breakEvenOrders)),
);

/* ---------------------------------------------------------------- */
/* Delivery                                                          */
/* ---------------------------------------------------------------- */

const shippingValues = [
  {
    cost: shipping.standardCost === 0 ? c.receipt.included : usd(shipping.standardCost),
    window: shipping.standardDays,
  },
  { cost: usd(shipping.overnightCost), window: shipping.overnightDays },
  { cost: `+${usd(shipping.remoteSurcharge)}`, window: shipping.remoteDays },
];
const shippingRows = c.shipping.rows.map((row, index) => ({ ...row, ...shippingValues[index] }));
const cutoffNote = c.shipping.cutoffNote.replaceAll("{cutoff}", sla.dispatchCutoff);

/* ---------------------------------------------------------------- */
/* Eligibility                                                       */
/* ---------------------------------------------------------------- */

const eligibilityThresholds = [
  `≥ ${eligibility.bmiAlone}`,
  `≥ ${eligibility.bmiWithCondition}`,
  `${eligibility.minAge}+ yrs`,
  `${eligibility.minAgeSermorelin}+ yrs`,
  `${coverage.states}${coverage.includesDC ? " + DC" : ""}`,
];
const eligibilityRows = c.eligibility.rows.map((row, index) => ({
  ...row,
  threshold: eligibilityThresholds[index],
}));
---

<Layout locale={locale} title={d.meta.pricing.title} description={d.meta.pricing.description}>
  <SeoHead slot="head" locale={locale} path="/pricing/" />
  <Header locale={locale} />
  <main id="main" tabindex="-1" class="outline-none">
    {/* 1. HEADER ------------------------------------------------------- */}
    <section class="bg-background page-top pb-14 sm:pb-16">
      <div class="shell">
        <p class="label text-brand-700 dark:text-brand-400">{c.header.eyebrow}</p>
        <h1 class="display-1 mt-5 max-w-4xl">{c.header.title}</h1>
        <p class="lead mt-6 text-lg">{c.header.lead}</p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={localizedPath(locale, "/start/")} class="btn-solid">
            {d.nav.cta}
            <ArrowRight className="size-4" />
          </a>
          <a href={localizedPath(locale, "/how-it-works/")} class="btn-outline">
            {c.header.ctaSecondary}
          </a>
        </div>

        <dl class="mt-12 grid gap-x-8 gap-y-8 sm:grid-cols-3">
          {
            headerFigures.map((figure) => (
              <div class="border-t border-border pt-4">
                <dd class="figure text-2xl text-foreground sm:text-[1.75rem]">{figure.value}</dd>
                <dt class="mt-2">
                  <span class="subhead block text-[0.9375rem]">{figure.label}</span>
                  <span class="mt-1 block text-sm text-muted-foreground">{figure.note}</span>
                </dt>
              </div>
            ))
          }
        </dl>

        <p class="mt-10 max-w-2xl border-t border-border pt-5 text-sm text-muted-foreground">
          {d.gating.short}
        </p>
      </div>
    </section>

    {/* The ticker closes the head block, the same slot it takes under the
        hero on the homepage. It cannot sit above the nav any more: the
        header floats. */}
    <TrustTicker locale={locale} />

    {/* 2. THE RECEIPT, IN FULL ---------------------------------------- */}
    <section id={anchors.pricing} class="bg-card section">
      <div class="shell">
        <div class="max-w-3xl">
          <p class="label text-brand-700 dark:text-brand-400">{c.receipt.eyebrow}</p>
          <h2 class="display-2 mt-4">{c.receipt.title}</h2>
          <p class="lead mt-4">{c.receipt.lead}</p>
        </div>

        <table class="mt-10 w-full border-collapse text-left">
          <thead>
            <tr class="border-y border-border">
              <th scope="col" class="label py-3 pr-4 text-muted-foreground sm:w-[30%]">
                {c.receipt.header.item}
              </th>
              <th scope="col" class="label py-3 pr-4 text-right text-muted-foreground sm:pr-8">
                {c.receipt.header.amount}
              </th>
              <th scope="col" class="label hidden py-3 text-muted-foreground sm:table-cell">
                {c.receipt.header.dest}
              </th>
            </tr>
          </thead>
          <tbody>
            {
              receiptRows.map((row) => (
                <tr class="border-b border-border align-top">
                  <th scope="row" class="py-6 pr-4 font-normal">
                    <span class="subhead">{row.item}</span>
                    {/* Below sm the third column is dropped, so both the
                        destination and the reasoning ride under the line name
                        rather than being lost. */}
                    <span class="mt-2 block text-sm leading-relaxed text-foreground sm:hidden">
                      {row.dest}
                    </span>
                    <span class="mt-2 block text-sm leading-relaxed text-muted-foreground sm:hidden">
                      {row.why}
                    </span>
                  </th>
                  <td class="figure py-6 pr-4 text-right text-base whitespace-nowrap sm:pr-8">
                    {row.amount}
                    {row.symbol && <sup class="ml-0.5 text-muted-foreground">{row.symbol}</sup>}
                  </td>
                  <td class="hidden py-6 sm:table-cell">
                    <span class="block text-[0.9375rem] leading-relaxed text-foreground">
                      {row.dest}
                    </span>
                    <span class="mt-2 block max-w-2xl text-sm leading-relaxed text-muted-foreground">
                      {row.why}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr class="border-b border-border">
              <th scope="row" class="label py-5 pr-4 text-muted-foreground">
                {c.receipt.totalLabel}
              </th>
              <td
                class="figure py-5 pr-4 text-right text-base whitespace-nowrap text-brand-700 sm:pr-8 dark:text-brand-400"
              >
                {c.receipt.totalValue}
              </td>
              <td class="hidden sm:table-cell"></td>
            </tr>
          </tfoot>
        </table>

        <p class="mt-6 max-w-3xl text-sm text-muted-foreground">{c.receipt.note}</p>
      </div>
    </section>

    {/* 3. PER-PREPARATION PRICES -------------------------------------- */}
    <section class="bg-background section">
      <div class="shell">
        <div class="max-w-3xl">
          <p class="label text-brand-700 dark:text-brand-400">{c.treatments.eyebrow}</p>
          <h2 class="display-2 mt-4">{c.treatments.title}</h2>
          <p class="lead mt-4">{c.treatments.lead}</p>
        </div>

        {
          programGroups.map((group) => (
            <div class="mt-12 first:mt-14">
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
                <h3 class="display-3">
                  {group.copy.title}
                  <sup class="figure ml-1 text-xs text-muted-foreground">
                    {group.symbols.join("")}
                  </sup>
                </h3>
                <a
                  href={group.href}
                  class="inline-flex items-center gap-2 text-sm font-semibold text-brand-700 dark:text-brand-400"
                >
                  {group.linkLabel}
                  <ArrowRight className="size-4" />
                </a>
              </div>
              <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground">
                {group.copy.note}
              </p>

              {/* sm and up: the full grid. */}
              <div class="mt-7 hidden sm:block">
                <table class="w-full border-collapse text-left">
                  <thead>
                    <tr class="border-y border-border">
                      <th scope="col" class="label py-3 pr-4 text-muted-foreground sm:w-[34%]">
                        {c.treatments.header.name}
                      </th>
                      <th scope="col" class="label py-3 pr-4 text-muted-foreground">
                        {c.treatments.header.cadence}
                      </th>
                      <th scope="col" class="label py-3 pr-4 text-right text-muted-foreground">
                        {c.treatments.header.one}
                      </th>
                      <th scope="col" class="label py-3 pr-4 text-right text-muted-foreground">
                        {c.treatments.header.three}
                      </th>
                      <th scope="col" class="label py-3 text-right text-muted-foreground">
                        {c.treatments.header.equiv}
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {group.rows.map((row) => (
                      <tr class="border-b border-border align-top">
                        <th scope="row" class="py-4 pr-4 font-normal">
                          <span class="subhead text-[0.9375rem]">{row.display}</span>
                          <span class="mt-1 block text-sm text-muted-foreground">{row.form}</span>
                        </th>
                        <td class="py-4 pr-4 text-sm text-muted-foreground">{row.cadence}</td>
                        <td class="figure py-4 pr-4 text-right text-[0.9375rem] whitespace-nowrap">
                          {usd(row.oneMonth)}
                        </td>
                        <td class="figure py-4 pr-4 text-right text-[0.9375rem] whitespace-nowrap">
                          {usd(row.threeMonth)}
                        </td>
                        <td class="figure py-4 text-right text-[0.9375rem] whitespace-nowrap text-brand-700 dark:text-brand-400">
                          {usdMonthly(monthlyEquivalent(row))}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              {/* Below sm: five columns become a stack. */}
              <dl class="mt-7 flex flex-col sm:hidden">
                {group.rows.map((row) => (
                  <div class="border-t border-border py-5">
                    <dt class="subhead text-[0.9375rem]">{row.display}</dt>
                    <dd class="mt-1 text-sm text-muted-foreground">
                      {row.form} · {row.cadence}
                    </dd>
                    <dd class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
                      <span class="flex flex-col">
                        <span class="label text-muted-foreground">{c.treatments.header.one}</span>
                        <span class="figure mt-1 text-[0.9375rem]">{usd(row.oneMonth)}</span>
                      </span>
                      <span class="flex flex-col">
                        <span class="label text-muted-foreground">{c.treatments.header.three}</span>
                        <span class="figure mt-1 text-[0.9375rem]">{usd(row.threeMonth)}</span>
                      </span>
                      <span class="flex flex-col">
                        <span class="label text-muted-foreground">{c.treatments.header.equiv}</span>
                        <span class="figure mt-1 text-[0.9375rem] text-brand-700 dark:text-brand-400">
                          {usdMonthly(monthlyEquivalent(row))}
                        </span>
                      </span>
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }

        <p class="mt-8 max-w-3xl text-sm leading-relaxed text-muted-foreground">
          {c.treatments.supplyNote}
        </p>

        {/* Brand-name alternatives, as a range. */}
        <div class="panel mt-12 p-6 sm:p-8">
          <h3 class="subhead text-lg">
            {c.treatments.brand.title}
            <sup class="figure ml-1 text-xs text-muted-foreground">‖</sup>
          </h3>
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground">
            {c.treatments.brand.lead}
          </p>

          <table class="mt-6 w-full border-collapse text-left">
            <thead>
              <tr class="border-y border-border">
                <th scope="col" class="label py-3 pr-4 text-muted-foreground">
                  {c.treatments.brand.header.name}
                </th>
                <th scope="col" class="label hidden py-3 pr-4 text-muted-foreground sm:table-cell">
                  {c.treatments.brand.header.molecule}
                </th>
                <th scope="col" class="label py-3 text-right text-muted-foreground">
                  {c.treatments.brand.header.price}
                </th>
              </tr>
            </thead>
            <tbody>
              {
                brandRows.map((row) => (
                  <tr class="border-b border-border">
                    <th scope="row" class="py-4 pr-4 font-normal">
                      <span class="subhead text-[0.9375rem]">{row.display}</span>
                      <span class="mt-1 block text-sm text-muted-foreground sm:hidden">
                        {row.molecule}
                      </span>
                    </th>
                    <td class="hidden py-4 pr-4 text-sm text-muted-foreground sm:table-cell">
                      {row.molecule}
                    </td>
                    <td class="figure py-4 text-right text-[0.9375rem] whitespace-nowrap">
                      {row.range}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>

          <p class="mt-5 max-w-3xl text-sm leading-relaxed text-muted-foreground">
            {c.treatments.brand.note}
          </p>
        </div>

        <p class="mt-8 max-w-2xl border-t border-border pt-5 text-sm text-muted-foreground">
          {d.gating.short}
        </p>
      </div>
    </section>

    {/* 4. MEMBERSHIP -------------------------------------------------- */}
    <section class="bg-card section">
      <div class="shell">
        <div class="max-w-3xl">
          <p class="label text-brand-700 dark:text-brand-400">{m.eyebrow}</p>
          <h2 class="display-2 mt-4">{m.title}</h2>
          <p class="lead mt-4">{m.lead}</p>
        </div>

        <div class="mt-9 flex flex-wrap gap-x-14 gap-y-6">
          <div>
            <p class="figure text-3xl text-foreground">{usdMonthly(fees.membershipMonthly)}</p>
            <p class="label mt-2.5 text-muted-foreground">{m.monthlyLabel}</p>
          </div>
          <div>
            <p class="figure text-3xl text-foreground">{usd(fees.membershipYearly)}</p>
            <p class="label mt-2.5 text-muted-foreground">{m.yearlyLabel}</p>
            <p class="mt-2 text-sm text-muted-foreground">{m.yearlyNote}</p>
          </div>
        </div>

        {/* sm and up: the comparison. */}
        <div class="mt-10 hidden sm:block">
          <table class="w-full border-collapse text-left">
            <thead>
              <tr class="border-y border-border">
                <th scope="col" class="label w-[52%] py-3 pr-6 text-muted-foreground">
                  {m.header.row}
                </th>
                <th scope="col" class="label py-3 pr-6 text-muted-foreground">{m.header.payg}</th>
                <th scope="col" class="label py-3 text-muted-foreground">{m.header.member}</th>
              </tr>
            </thead>
            <tbody>
              {
                membershipRows.map((row) => (
                  <tr class="border-b border-border align-top">
                    <th scope="row" class="py-5 pr-6 font-normal">
                      <span class="subhead text-[0.9375rem]">{row.label}</span>
                      <span class="mt-1.5 block max-w-xl text-sm leading-relaxed text-muted-foreground">
                        {row.gloss}
                      </span>
                    </th>
                    <td class="figure py-5 pr-6 text-[0.9375rem] text-muted-foreground">
                      {row.payg}
                    </td>
                    <td
                      class:list={[
                        "figure py-5 text-[0.9375rem]",
                        row.changed ? "text-brand-700 dark:text-brand-400" : "text-muted-foreground",
                      ]}
                    >
                      {row.member}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        {/* Below sm: the same pairs, stacked. */}
        <dl class="mt-10 flex flex-col sm:hidden">
          {
            membershipRows.map((row) => (
              <div class="border-t border-border py-5">
                <dt class="subhead text-[0.9375rem]">{row.label}</dt>
                <dd class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{row.gloss}</dd>
                <dd class="mt-3 grid grid-cols-2 gap-x-4">
                  <span class="flex flex-col">
                    <span class="label text-muted-foreground">{m.header.payg}</span>
                    <span class="figure mt-1 text-[0.9375rem]">{row.payg}</span>
                  </span>
                  <span class="flex flex-col">
                    <span class="label text-muted-foreground">{m.header.member}</span>
                    <span
                      class:list={[
                        "figure mt-1 text-[0.9375rem]",
                        row.changed && "text-brand-700 dark:text-brand-400",
                      ]}
                    >
                      {row.member}
                    </span>
                  </span>
                </dd>
              </div>
            ))
          }
        </dl>

        {/* The arithmetic, including the three cases that argue against it. */}
        <div class="panel mt-10 bg-background p-6 sm:p-8">
          <p class="label text-muted-foreground">{m.breakEven.title}</p>
          <p class="figure mt-4 text-3xl text-foreground sm:text-4xl">
            {breakEvenOrders}
            {" "}
            <span class="text-base text-muted-foreground">{m.breakEven.unit}</span>
          </p>
          <p class="mt-4 max-w-2xl text-[0.9375rem] leading-relaxed text-muted-foreground">
            {breakEvenNote}
          </p>

          <dl class="mt-7 grid gap-x-8 gap-y-6 sm:grid-cols-3">
            {
              breakEvenCases.map((item) => (
                <div class="border-t border-border pt-4">
                  <dd class="figure text-xl text-foreground">
                    {item.value}
                    {" "}
                    <span class="label text-muted-foreground">{m.breakEven.unit}</span>
                  </dd>
                  <dt class="mt-2 text-sm text-muted-foreground">{item.label}</dt>
                </div>
              ))
            }
          </dl>

          <p class="mt-7 max-w-3xl border-t border-border pt-6 text-[0.9375rem] leading-relaxed">
            {m.breakEven.verdict}
          </p>
        </div>
      </div>
    </section>

    {/* 5. DELIVERY ---------------------------------------------------- */}
    <section class="bg-background section">
      <div class="shell">
        <div class="max-w-3xl">
          <p class="label text-brand-700 dark:text-brand-400">{c.shipping.eyebrow}</p>
          <h2 class="display-2 mt-4">{c.shipping.title}</h2>
          <p class="lead mt-4">{c.shipping.lead}</p>
        </div>

        <table class="mt-10 w-full border-collapse text-left">
          <thead>
            <tr class="border-y border-border">
              <th scope="col" class="label py-3 pr-4 text-muted-foreground sm:w-[46%]">
                {c.shipping.header.option}
              </th>
              <th scope="col" class="label py-3 pr-4 text-right text-muted-foreground sm:text-left">
                {c.shipping.header.cost}
              </th>
              <th scope="col" class="label hidden py-3 text-muted-foreground sm:table-cell">
                {c.shipping.header.window}
              </th>
            </tr>
          </thead>
          <tbody>
            {
              shippingRows.map((row) => (
                <tr class="border-b border-border align-top">
                  <th scope="row" class="py-5 pr-4 font-normal">
                    <span class="subhead text-[0.9375rem]">{row.option}</span>
                    <span class="mt-1.5 block max-w-xl text-sm leading-relaxed text-muted-foreground">
                      {row.note}
                    </span>
                    <span class="figure mt-2 block text-sm text-signal-700 sm:hidden dark:text-signal-500">
                      {row.window}
                    </span>
                  </th>
                  <td
                    class="figure py-5 pr-4 text-right text-[0.9375rem] whitespace-nowrap sm:text-left"
                  >
                    {row.cost}
                  </td>
                  <td
                    class="figure hidden py-5 text-[0.9375rem] whitespace-nowrap text-signal-700 sm:table-cell dark:text-signal-500"
                  >
                    {row.window}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <div class="panel mt-8 flex max-w-3xl gap-3 p-5">
          <Clock className="mt-0.5 size-4 shrink-0 text-signal-700 dark:text-signal-500" />
          <p class="text-sm leading-relaxed text-muted-foreground">{cutoffNote}</p>
        </div>
      </div>
    </section>

    {/* 6. THE TWO BOUNDARY LISTS — the page's fixed-dark band --------- */}
    <section class="border-b border-brand-50/10 bg-brand-800 py-16 text-brand-50 sm:py-20">
      <div class="shell">
        <div class="max-w-3xl">
          <p class="label text-brand-300">{c.boundaries.eyebrow}</p>
          <h2 class="display-2 mt-4 text-brand-50">{c.boundaries.title}</h2>
          <p class="mt-4 max-w-2xl text-[1.0625rem] leading-relaxed text-brand-50/65">
            {c.boundaries.lead}
          </p>
        </div>

        <div class="mt-10 grid gap-6 lg:grid-cols-2 lg:gap-8">
          <div class="panel-invert p-6 sm:p-8">
            <h3 class="label text-brand-300">{c.boundaries.notIncluded.title}</h3>
            <ul class="mt-5 flex flex-col">
              {
                c.boundaries.notIncluded.items.map((item) => (
                  <li class="flex gap-3 border-t border-brand-50/12 py-4 first:border-t-0 first:pt-0">
                    <Minus className="mt-1 size-4 shrink-0 text-brand-50/60" />
                    <span class="text-[0.9375rem] leading-relaxed text-brand-50/75">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="panel-invert p-6 sm:p-8">
            <h3 class="label text-brand-300">{c.boundaries.neverCharged.title}</h3>
            <ul class="mt-5 flex flex-col">
              {
                c.boundaries.neverCharged.items.map((item) => (
                  <li class="flex gap-3 border-t border-brand-50/12 py-4 first:border-t-0 first:pt-0">
                    <Check className="mt-1 size-4 shrink-0 text-brand-300" />
                    <span class="text-[0.9375rem] leading-relaxed text-brand-50/75">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* 7. ELIGIBILITY THRESHOLDS ------------------------------------- */}
    <section class="bg-card section">
      <div class="shell">
        <div class="grid gap-10 lg:grid-cols-[1fr_20rem] lg:gap-14">
          <div>
            <p class="label text-brand-700 dark:text-brand-400">{c.eligibility.eyebrow}</p>
            <h2 class="display-2 mt-4">{c.eligibility.title}</h2>
            <p class="lead mt-4">{c.eligibility.lead}</p>

            <table class="mt-10 w-full border-collapse text-left">
              <thead>
                <tr class="border-y border-border">
                  <th scope="col" class="label py-3 pr-4 text-muted-foreground sm:w-[34%]">
                    {c.eligibility.header.criterion}
                  </th>
                  <th scope="col" class="label py-3 pr-4 text-right text-muted-foreground">
                    {c.eligibility.header.threshold}
                  </th>
                  <th scope="col" class="label hidden py-3 text-muted-foreground sm:table-cell">
                    {c.eligibility.header.note}
                  </th>
                </tr>
              </thead>
              <tbody>
                {
                  eligibilityRows.map((row) => (
                    <tr class="border-b border-border align-top">
                      <th scope="row" class="py-4 pr-4 font-normal">
                        <span class="subhead text-[0.9375rem]">{row.criterion}</span>
                        <span class="mt-1.5 block text-sm leading-relaxed text-muted-foreground sm:hidden">
                          {row.note}
                        </span>
                      </th>
                      <td class="figure py-4 pr-4 text-right text-[0.9375rem] whitespace-nowrap text-brand-700 dark:text-brand-400">
                        {row.threshold}
                      </td>
                      <td class="hidden py-4 text-sm leading-relaxed text-muted-foreground sm:table-cell">
                        {row.note}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>

            <p class="mt-6 max-w-3xl text-sm leading-relaxed text-muted-foreground">
              {c.eligibility.note}
            </p>
          </div>

          <aside class="panel h-fit bg-background p-6 lg:sticky lg:top-24">
            <p class="label text-muted-foreground">{c.eligibility.asideLabel}</p>
            <p class="mt-4 text-[0.9375rem] leading-relaxed text-muted-foreground">
              {d.gating.long}
            </p>
            <a href={localizedPath(locale, "/start/")} class="btn-solid mt-6">
              {d.nav.cta}
              <ArrowRight className="size-4" />
            </a>
            <a
              href={localizedPath(locale, "/faq/")}
              class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-700 dark:text-brand-400"
            >
              {c.eligibility.faqLink}
              <ArrowRight className="size-4" />
            </a>
          </aside>
        </div>
      </div>
    </section>

    <Cta locale={locale} />
    <ComplianceBand locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
