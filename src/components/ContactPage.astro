---
/**
 * /contact/ — a published number, published hours, and routing.
 *
 * WHY THERE IS NO FORM. This is a static build with no endpoint, and a form
 * that posts nowhere is worse than no form; a `mailto:` dressed up as one is
 * the same lie with more markup. The reference block this page borrows its
 * shape from (`.rb-source/pro/contact-11.tsx`) is a two-pole layout: routing
 * on the left, one panel on the right holding a nine-field enquiry form and a
 * "Send message" button. The layout is right and the panel's contents are not,
 * so the panel keeps the slot and holds the thing that is actually true — the
 * number, the hours a person is on it, and the address of the inbox. Everything
 * else in that block is discarded: the four named "desks" with stock portraits
 * would attach a face and a personal name to "clinical questions", which reads
 * as Ellery's clinician and collapses the three-party separation this page
 * exists to draw (and the Unsplash licence forbids implying endorsement).
 *
 * WHY THE ROUTING TABLE IS THE DARK BAND. Three licensed parties touch an
 * order and only one of them is Ellery, so the most valuable thing this page
 * can do is say which question belongs to which party. That is the same
 * argument `Roles.astro` makes on the homepage, so it gets the same treatment:
 * a real table on the page's one `.slab` band, with a definition-list fallback
 * below `sm` where three columns would be twelve characters wide.
 *
 * WHY THE ACCOUNT THREAD IS NOT A LINK. It carries medical information and
 * lives behind a login this build does not have. A link to a login that does
 * not exist is the same defect as an href="#" safety link, so the row says
 * where the thread lives instead of pointing at nothing.
 *
 * HOURS are derived from `site.openingHours` (weekdays, the block schema.org
 * also gets) plus the weekend half of `footer.supportHours`, and they are
 * PUBLISHED ONCE, in the header panel. They used to appear in the header row,
 * again in the phone card and again in the office aside — three copies of one
 * constant is how the reference sites in this category ended up quoting two
 * different support schedules on the same page.
 */
import { type Locale, t, localizedPath } from "@/i18n";
import { site } from "@/config/site";
import { partners, sla } from "@/config/pricing";
import Layout from "@/layouts/Layout.astro";
import SeoHead from "@/components/SeoHead.astro";
import Headline from "@/components/Headline.astro";
import SectionHead from "@/components/SectionHead.astro";
import TrustTicker from "@/components/sections/TrustTicker.astro";
import Header from "@/components/sections/Header.astro";
import Cta from "@/components/sections/Cta.astro";
import ComplianceBand from "@/components/sections/ComplianceBand.astro";
import Footer from "@/components/sections/Footer.astro";
import { Image } from "astro:assets";
import contactImage from "@/assets/contact.jpg";
import { ArrowRight, ArrowUpRight, ExternalLink, MapPin, TriangleAlert } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const c = d.contact;

/* --- Hours, from one source ---------------------------------------- */

/** "08:00" -> "8am", "16:30" -> "4:30pm". */
const clock = (value: string): string => {
  const [hour, minute] = value.split(":").map(Number);
  const suffix = hour >= 12 ? "pm" : "am";
  const hour12 = hour % 12 === 0 ? 12 : hour % 12;
  return minute === 0 ? `${hour12}${suffix}` : `${hour12}:${String(minute).padStart(2, "0")}${suffix}`;
};

const openingHours = site.openingHours;
const weekdayHours = openingHours
  ? `${openingHours.days[0].slice(0, 3)}–${openingHours.days[openingHours.days.length - 1].slice(0, 3)} ${clock(openingHours.opens)}–${clock(openingHours.closes)} ET`
  : d.footer.supportHours;
/** The weekend block is narrower and lives in copy, not in schema.org. */
const supportHoursParts = d.footer.supportHours.split(" · ");
const weekendHours = supportHoursParts.length > 1 ? supportHoursParts[1] : d.footer.supportHours;

/* --- Figures referenced by the copy -------------------------------- */

const figures: Record<string, string> = {
  practice: partners.practice,
  cutoff: sla.dispatchCutoff,
  locality: site.addressLocality,
};

const fill = (text: string): string =>
  text.replace(/\{(\w+)\}/g, (_match, token: string) => {
    const value = figures[token];
    if (value === undefined) {
      throw new Error(`/contact/ copy references an unknown figure token: {${token}}`);
    }
    return value;
  });

/* --- The three channels -------------------------------------------- */

interface Channel {
  label: string;
  title: string;
  /** The channel's address, as a link. Absent for the account thread. */
  href?: string;
  value?: string;
  where?: string;
  body: string;
  note: string;
}

const channels: Channel[] = [
  {
    label: c.channels.phone.label,
    title: c.channels.phone.title,
    href: site.phoneHref,
    value: site.phoneDisplay,
    body: c.channels.phone.body,
    note: fill(c.channels.phone.note),
  },
  {
    label: c.channels.email.label,
    title: c.channels.email.title,
    href: site.mailHref,
    value: site.email,
    body: c.channels.email.body,
    note: fill(c.channels.email.note),
  },
  {
    label: c.channels.thread.label,
    title: c.channels.thread.title,
    where: c.channels.thread.where,
    body: c.channels.thread.body,
    note: fill(c.channels.thread.note),
  },
];

/* --- Routing -------------------------------------------------------- */

const routingRows = c.routing.rows.map((row) => ({
  ...row,
  topic: fill(row.topic),
  party: fill(row.party),
  how: fill(row.how),
  /** "911" is a figure, so it is set in the data face; a party name is not. */
  partyIsFigure: /^[\d\s]+$/.test(row.party),
}));

const responseRows = c.response.rows.map((row) => ({ ...row, detail: fill(row.detail) }));

const hasAddress = Boolean(site.addressStreet && site.addressCountryCode);
---

<Layout locale={locale} title={d.meta.contact.title} description={d.meta.contact.description}>
  <SeoHead slot="head" locale={locale} path="/contact/" />
  <Header locale={locale} />
  <main id="main" tabindex="-1" class="outline-none">
    <section class="bg-background page-top pb-14 sm:pb-16">
      <div class="shell">
        <p class="label text-signal-700 dark:text-signal-500">{c.header.eyebrow}</p>
        <Headline
          as="h1"
          reveal
          text={c.header.title}
          accent={c.header.titleAccent}
          class="display-1 mt-5 max-w-3xl"
        />

        <div class="mt-9 grid gap-10 lg:grid-cols-[1fr_21rem] lg:gap-14">
          <div>
            <p class="lead">{c.header.lead}</p>
            <p class="mt-7 max-w-xl text-sm leading-relaxed text-muted-foreground">
              {c.header.noForm}
            </p>
            <p class="mt-6 max-w-xl text-[0.9375rem] leading-relaxed">{c.header.against}</p>
            <a
              href={localizedPath(locale, "/pricing/")}
              class="group mt-3 inline-flex items-center gap-2 text-sm font-semibold text-foreground hover:text-signal-700 dark:hover:text-signal-500"
            >
              {c.header.againstCta}
              <ArrowRight className="size-4 transition-transform group-hover:translate-x-1" />
            </a>
          </div>

          {/* The panel the reference block fills with an enquiry form. */}
          <aside class="panel h-fit p-6">
            <p class="label text-muted-foreground">{c.header.figures.phone}</p>
            <a
              href={site.phoneHref}
              class="figure mt-2 block text-[1.75rem] hover:text-signal-700 dark:hover:text-signal-500"
            >
              {site.phoneDisplay}
            </a>

            <p class="label mt-7 text-muted-foreground">{c.office.hoursLabel}</p>
            <dl class="mt-3">
              {
                [
                  { label: c.header.figures.weekday, value: weekdayHours },
                  { label: c.header.figures.weekend, value: weekendHours },
                ].map((row) => (
                  <div class="flex items-baseline justify-between gap-4 border-t border-hairline py-2.5">
                    <dt class="text-[0.8125rem] text-muted-foreground">{row.label}</dt>
                    <dd class="figure shrink-0 text-[0.8125rem]">{row.value}</dd>
                  </div>
                ))
              }
            </dl>

            <p class="label mt-7 text-muted-foreground">{c.header.figures.email}</p>
            <a
              href={site.mailHref}
              class="figure mt-2 block break-words text-[0.9375rem] hover:text-signal-700 dark:hover:text-signal-500"
            >
              {site.email}
            </a>
          </aside>
        </div>
      </div>
    </section>

    {/* The ticker closes the head block, the same slot it takes under the
        hero on the homepage. It cannot sit above the nav any more: the
        header floats. */}
    <TrustTicker locale={locale} />

    <section class="bg-card section">
      <div class="shell">
        <SectionHead
          eyebrow={c.channels.eyebrow}
          title={c.channels.title}
          lead={c.channels.lead}
        />

        {/* HAIRLINE ROWS, not three equal cards. The three channels are not
            three equal things — the phone reaches Ellery, the thread reaches
            the practice, and their explanations are of very different lengths.
            A row lets the second column run as long as it needs to; a card
            grid would pad two of them to match the third. Each address is one
            link whose accessible name is the address itself, with the arrow
            hidden from assistive tech. */}
        <ul class="mt-12 flex flex-col">
          {
            channels.map((channel) => (
              <li class="grid gap-x-10 gap-y-5 border-t border-border py-8 last:border-b sm:grid-cols-[15rem_1fr] sm:py-10">
                <div>
                  <p class="label text-muted-foreground">{channel.label}</p>
                  <h3 class="subhead mt-2.5">{channel.title}</h3>

                  {channel.href && channel.value && (
                    <a
                      href={channel.href}
                      class="figure group mt-4 inline-flex items-baseline gap-1.5 break-words text-[0.9375rem] hover:text-signal-700 dark:hover:text-signal-500"
                    >
                      {channel.value}
                      <ArrowUpRight
                        aria-hidden="true"
                        className="size-3.5 shrink-0 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                      />
                    </a>
                  )}

                  {channel.where && (
                    <div class="mt-4">
                      <p class="label text-muted-foreground">{c.channels.whereLabel}</p>
                      <p class="mt-1.5 text-[0.8125rem] leading-relaxed">{channel.where}</p>
                    </div>
                  )}
                </div>

                <div>
                  <p class="text-[0.9375rem] leading-relaxed text-muted-foreground">
                    {channel.body}
                  </p>
                  <p class="label mt-6 text-muted-foreground">{c.channels.repliesLabel}</p>
                  <p class="mt-2 text-sm leading-relaxed">{channel.note}</p>
                </div>
              </li>
            ))
          }
        </ul>

        {/* THE FRAMED SPECIMEN. The photograph used to run full-bleed as its
            own band, which made it the loudest thing on a page whose argument
            is a table. In the frame it is what it should be — evidence for the
            sentence beside it, mounted the way the whole site is mounted. */}
        <figure class="panel mt-16 bg-background p-2">
          <div class="overflow-hidden rounded-lg">
            <Image
              src={contactImage}
              alt={c.plate.alt}
              widths={[768, 1280, 1920]}
              sizes="(min-width: 1024px) 62rem, 100vw"
              class="aspect-[4/3] w-full object-cover sm:aspect-[21/9]"
              loading="lazy"
            />
          </div>
          <figcaption class="flex flex-col gap-3 px-4 py-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
            <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground">
              <span class="label mr-2 text-signal-700 dark:text-signal-500">{c.plate.label}</span>
              {fill(c.plate.caption)}
            </p>
          </figcaption>
        </figure>
      </div>
    </section>

    {/* Routing. This table is the page, and it gets the page's one slab. */}
    <section class="slab on-slab section">
      <div class="shell">
        <SectionHead
          on="slab"
          eyebrow={c.routing.eyebrow}
          title={c.routing.title}
          lead={c.routing.lead}
        />

        {/* sm and up: the table. */}
        <div class="reveal mt-12 hidden sm:block">
          <table class="w-full border-collapse text-left">
            <thead>
              <tr class="border-y border-brand-50/15">
                <th scope="col" class="label w-[34%] py-3 pr-6 text-brand-50/70">
                  {c.routing.header.topic}
                </th>
                <th scope="col" class="label w-[20%] py-3 pr-6 text-brand-50/70">
                  {c.routing.header.party}
                </th>
                <th scope="col" class="label py-3 text-brand-50/70">{c.routing.header.how}</th>
              </tr>
            </thead>
            <tbody>
              {
                routingRows.map((row) => (
                  <tr
                    class:list={[
                      "border-b border-brand-50/12 align-top",
                      row.urgent && "bg-brand-50/6",
                    ]}
                  >
                    <th scope="row" class="py-5 pr-6 font-normal">
                      <span class="subhead inline text-brand-50">{row.topic}</span>
                      {row.symbols && <sup class="ml-0.5 text-signal-500">{row.symbols}</sup>}
                    </th>
                    <td class="py-5 pr-6">
                      <span class="flex items-baseline gap-2">
                        {row.urgent && (
                          <TriangleAlert className="mt-0.5 size-4 shrink-0 text-brand-50" />
                        )}
                        <span
                          class:list={[
                            "text-brand-50",
                            row.partyIsFigure ? "figure text-lg" : "subhead",
                          ]}
                        >
                          {row.party}
                        </span>
                      </span>
                    </td>
                    <td class="py-5 text-[0.9375rem] leading-relaxed text-brand-50/70">{row.how}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        {/* Below sm: the same three fields, stacked. */}
        <dl class="reveal mt-12 flex flex-col sm:hidden">
          {
            routingRows.map((row) => (
              <div
                class:list={[
                  "border-t border-brand-50/12 py-5",
                  row.urgent && "-mx-4 bg-brand-50/6 px-4",
                ]}
              >
                <dt class="subhead text-brand-50">
                  {row.topic}
                  {row.symbols && <sup class="ml-0.5 text-signal-500">{row.symbols}</sup>}
                </dt>
                <dd class="mt-2.5">
                  <span
                    class:list={[
                      "flex items-baseline gap-2 text-brand-50",
                      row.partyIsFigure ? "figure text-base" : "subhead text-[0.9375rem]",
                    ]}
                  >
                    {row.urgent && <TriangleAlert className="size-4 shrink-0" />}
                    {row.party}
                  </span>
                  <span class="mt-1.5 block text-sm leading-relaxed text-brand-50/70">
                    {row.how}
                  </span>
                </dd>
              </div>
            ))
          }
        </dl>

        <p class="mt-10 max-w-3xl border-t border-brand-50/12 pt-6 text-sm leading-relaxed text-brand-50/70">
          {c.routing.note}
        </p>
      </div>
    </section>

    <section class="bg-background section">
      <div class="shell">
        <SectionHead
          eyebrow={c.response.eyebrow}
          title={c.response.title}
          lead={c.response.lead}
        />

        {/* sm and up: what / when / detail. */}
        <table class="reveal mt-12 hidden w-full border-collapse text-left sm:table">
          <thead>
            <tr class="border-y border-border">
              <th scope="col" class="label py-3 pr-4 text-muted-foreground">
                {c.response.header.what}
              </th>
              <th scope="col" class="label w-[11rem] py-3 pr-8 text-muted-foreground">
                {c.response.header.when}
              </th>
              <th scope="col" class="label py-3 text-muted-foreground">
                {c.response.header.detail}
              </th>
            </tr>
          </thead>
          <tbody>
            {
              responseRows.map((row) => (
                <tr class="border-b border-border align-top">
                  <th scope="row" class="py-5 pr-4 font-normal">
                    <span class="subhead">{row.what}</span>
                  </th>
                  {/* Amber, because this column is the only thing on the page
                      that measures time — which is the whole of what the
                      signal colour is allowed to mean. */}
                  <td class="figure py-5 pr-8 text-[0.8125rem] text-signal-700 dark:text-signal-500">
                    {row.when}
                  </td>
                  <td class="py-5 text-sm leading-relaxed text-muted-foreground">{row.detail}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        {/* Below sm: the same three fields as a definition list. Three columns
            at 360px is twelve characters wide, and dropping one of them loses
            the window the row exists to publish. */}
        <dl class="reveal mt-12 flex flex-col sm:hidden">
          {
            responseRows.map((row) => (
              <div class="border-t border-border py-5">
                <dt class="subhead">{row.what}</dt>
                <dd>
                  <span class="figure mt-2 block text-[0.9375rem] text-signal-700 dark:text-signal-500">
                    {row.when}
                  </span>
                  <span class="mt-1.5 block text-sm leading-relaxed text-muted-foreground">
                    {row.detail}
                  </span>
                </dd>
              </div>
            ))
          }
        </dl>

        <p class="mt-9 max-w-3xl text-sm leading-relaxed text-muted-foreground">
          {c.response.note}
        </p>
      </div>
    </section>

    <section class="bg-card section">
      <div class="shell">
        <div class="grid gap-10 lg:grid-cols-[1fr_22rem] lg:gap-14">
          <div class="reveal">
            <p class="label text-signal-700 dark:text-signal-500">{c.office.eyebrow}</p>
            <h2 class="display-2 mt-4">{c.office.title}</h2>
            <p class="lead mt-5">{c.office.body}</p>
            <p class="mt-5 max-w-2xl text-sm leading-relaxed text-muted-foreground">
              {c.office.postNote}
            </p>
          </div>

          {
            hasAddress && (
              <aside class="panel h-fit bg-background p-6">
                <p class="label text-muted-foreground">{c.office.addressLabel}</p>
                <address class="figure mt-3 text-[0.9375rem] leading-relaxed not-italic">
                  <span class="block">{site.legalName}</span>
                  <span class="block">{site.addressStreet}</span>
                  <span class="block">
                    {site.addressLocality}, {site.addressRegion} {site.addressPostal}
                  </span>
                </address>

                {site.mapHref && (
                  <a
                    href={site.mapHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-6 inline-flex items-center gap-2 border-t border-hairline pt-5 text-sm font-semibold text-foreground hover:text-signal-700 dark:hover:text-signal-500"
                  >
                    <MapPin className="size-4" />
                    {c.office.mapCta}
                    <ExternalLink className="size-3.5" />
                  </a>
                )}
              </aside>
            )
          }
        </div>
      </div>
    </section>

    <Cta locale={locale} />
    <ComplianceBand locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
