---
/**
 * /contact/ — a published number, published hours, and routing.
 *
 * WHY THERE IS NO FORM. This is a static build with no endpoint, and a form
 * that posts nowhere is worse than no form; a `mailto:` dressed up as one is
 * the same lie with more markup. So the page publishes the channels instead
 * and says so in the copy. The category's premium end publishes a number and
 * its hours for exactly this reason: the top anxiety in a mail-order
 * prescription flow is "will anyone answer".
 *
 * WHY THE ROUTING TABLE IS THE DARK BAND. Three licensed parties touch an
 * order and only one of them is Ellery, so the most valuable thing this page
 * can do is say which question belongs to which party. That is the same
 * argument `Roles.astro` makes on the homepage, so it gets the same treatment:
 * a real table on the one fixed-dark band, with a definition-list fallback
 * below `sm` where three columns would be twelve characters wide.
 *
 * WHY THE ACCOUNT THREAD IS NOT A LINK. It carries medical information and
 * lives behind a login this build does not have. A link to a login that does
 * not exist is the same defect as an href="#" safety link, so the panel says
 * where the thread lives instead of pointing at nothing.
 *
 * HOURS are derived from `site.openingHours` (weekdays, the block schema.org
 * also gets) plus the weekend half of `footer.supportHours`, so the header,
 * the phone panel and the footer cannot quote different hours.
 */
import { type Locale, t, localizedPath } from "@/i18n";
import { site } from "@/config/site";
import { partners, sla } from "@/config/pricing";
import Layout from "@/layouts/Layout.astro";
import SeoHead from "@/components/SeoHead.astro";
import TrustTicker from "@/components/sections/TrustTicker.astro";
import Header from "@/components/sections/Header.astro";
import Cta from "@/components/sections/Cta.astro";
import ComplianceBand from "@/components/sections/ComplianceBand.astro";
import Footer from "@/components/sections/Footer.astro";
import { Image } from "astro:assets";
import contactImage from "@/assets/contact.jpg";
import { ArrowRight, ExternalLink, MapPin, TriangleAlert } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const c = d.contact;

/* --- Hours, from one source ---------------------------------------- */

/** "08:00" -> "8am", "16:30" -> "4:30pm". */
const clock = (value: string): string => {
  const [hour, minute] = value.split(":").map(Number);
  const suffix = hour >= 12 ? "pm" : "am";
  const hour12 = hour % 12 === 0 ? 12 : hour % 12;
  return minute === 0 ? `${hour12}${suffix}` : `${hour12}:${String(minute).padStart(2, "0")}${suffix}`;
};

const openingHours = site.openingHours;
const weekdayHours = openingHours
  ? `${openingHours.days[0].slice(0, 3)}–${openingHours.days[openingHours.days.length - 1].slice(0, 3)} ${clock(openingHours.opens)}–${clock(openingHours.closes)} ET`
  : d.footer.supportHours;
/** The weekend block is narrower and lives in copy, not in schema.org. */
const supportHoursParts = d.footer.supportHours.split(" · ");
const weekendHours = supportHoursParts.length > 1 ? supportHoursParts[1] : d.footer.supportHours;

/* --- Figures referenced by the copy -------------------------------- */

const figures: Record<string, string> = {
  practice: partners.practice,
  cutoff: sla.dispatchCutoff,
  locality: site.addressLocality,
};

const fill = (text: string): string =>
  text.replace(/\{(\w+)\}/g, (_match, token: string) => {
    const value = figures[token];
    if (value === undefined) {
      throw new Error(`/contact/ copy references an unknown figure token: {${token}}`);
    }
    return value;
  });

/* --- The three channels -------------------------------------------- */

interface Channel {
  label: string;
  title: string;
  /** The channel's address, as a link. Absent for the account thread. */
  href?: string;
  value?: string;
  where?: string;
  body: string;
  availabilityLabel: string;
  availabilityLines: string[];
  note: string;
}

const channels: Channel[] = [
  {
    label: c.channels.phone.label,
    title: c.channels.phone.title,
    href: site.phoneHref,
    value: site.phoneDisplay,
    body: c.channels.phone.body,
    availabilityLabel: c.channels.hoursLabel,
    availabilityLines: [weekdayHours, weekendHours],
    note: fill(c.channels.phone.note),
  },
  {
    label: c.channels.email.label,
    title: c.channels.email.title,
    href: site.mailHref,
    value: site.email,
    body: c.channels.email.body,
    availabilityLabel: c.channels.repliesLabel,
    availabilityLines: [],
    note: fill(c.channels.email.note),
  },
  {
    label: c.channels.thread.label,
    title: c.channels.thread.title,
    where: c.channels.thread.where,
    body: c.channels.thread.body,
    availabilityLabel: c.channels.repliesLabel,
    availabilityLines: [],
    note: fill(c.channels.thread.note),
  },
];

/* --- Routing -------------------------------------------------------- */

const routingRows = c.routing.rows.map((row) => ({
  ...row,
  topic: fill(row.topic),
  party: fill(row.party),
  how: fill(row.how),
  /** "911" is a figure, so it is set in the data face; a party name is not. */
  partyIsFigure: /^[\d\s]+$/.test(row.party),
}));

const responseRows = c.response.rows.map((row) => ({ ...row, detail: fill(row.detail) }));

const headerFacts = [
  { value: site.phoneDisplay, href: site.phoneHref, label: c.header.figures.phone },
  { value: weekdayHours, label: c.header.figures.weekday },
  { value: weekendHours, label: c.header.figures.weekend },
];

const hasAddress = Boolean(site.addressStreet && site.addressCountryCode);
---

<Layout locale={locale} title={d.meta.contact.title} description={d.meta.contact.description}>
  <SeoHead slot="head" locale={locale} path="/contact/" />
  <Header locale={locale} />
  <main id="main" tabindex="-1" class="outline-none">
    <section class="bg-background page-top pb-14 sm:pb-16">
      <div class="shell">
        <p class="label text-brand-700 dark:text-brand-400">{c.header.eyebrow}</p>
        <h1 class="display-1 mt-5 max-w-4xl">{c.header.title}</h1>
        <p class="lead mt-6 text-lg">{c.header.lead}</p>

        <dl class="mt-10 grid max-w-3xl gap-x-8 gap-y-6 sm:grid-cols-3">
          {
            headerFacts.map((fact) => (
              <div class="border-t border-border pt-4">
                <dd class="figure text-base text-foreground sm:text-lg">
                  {fact.href ? (
                    <a href={fact.href} class="hover:text-brand-700 dark:hover:text-brand-400">
                      {fact.value}
                    </a>
                  ) : (
                    fact.value
                  )}
                </dd>
                <dt class="mt-1.5 text-sm text-muted-foreground">{fact.label}</dt>
              </div>
            ))
          }
        </dl>

        <p class="mt-8 max-w-3xl text-sm leading-relaxed text-muted-foreground">
          {c.header.noForm}
        </p>
        <p class="mt-6 max-w-3xl text-[0.9375rem] leading-relaxed text-foreground">
          {c.header.against}
        </p>
        <a
          href={localizedPath(locale, "/pricing/")}
          class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-brand-700 dark:text-brand-400"
        >
          {c.header.againstCta}
          <ArrowRight className="size-4" />
        </a>
      </div>
    </section>

    {/* The ticker closes the head block, the same slot it takes under the
        hero on the homepage. It cannot sit above the nav any more: the
        header floats. */}
    <TrustTicker locale={locale} />

    <section class="bg-card section">
      <div class="shell">
        <div class="max-w-3xl">
          <p class="label text-brand-700 dark:text-brand-400">{c.channels.eyebrow}</p>
          <h2 class="display-2 mt-4">{c.channels.title}</h2>
          <p class="lead mt-4">{c.channels.lead}</p>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-3 lg:gap-8">
          {
            channels.map((channel) => (
              <div class="panel flex flex-col bg-background p-6">
                <p class="label text-muted-foreground">{channel.label}</p>
                <h3 class="subhead mt-3 text-lg">{channel.title}</h3>

                {channel.href && channel.value && (
                  <a
                    href={channel.href}
                    class="figure mt-4 block break-words text-lg text-foreground hover:text-brand-700 dark:hover:text-brand-400"
                  >
                    {channel.value}
                  </a>
                )}

                {channel.where && (
                  <div class="mt-4">
                    <p class="label text-muted-foreground">{c.channels.whereLabel}</p>
                    <p class="figure mt-1.5 text-[0.8125rem] leading-relaxed text-foreground">
                      {channel.where}
                    </p>
                  </div>
                )}

                <p class="mt-5 text-[0.9375rem] leading-relaxed text-muted-foreground">
                  {channel.body}
                </p>

                <div class="mt-auto border-t border-border pt-4">
                  <p class="label text-muted-foreground">{channel.availabilityLabel}</p>
                  {channel.availabilityLines.map((line) => (
                    <p class="figure mt-1.5 text-xs text-foreground">{line}</p>
                  ))}
                  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{channel.note}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* The plate: one wide band of photography with a cutline, rather than a
        scrim over a headline — the page already has a dark band and this is
        not a hero. */}
    <section class="bg-background">
      <div class="aspect-[4/3] w-full sm:aspect-[21/9]">
        <Image
          src={contactImage}
          alt={c.plate.alt}
          widths={[768, 1280, 1920]}
          sizes="100vw"
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="shell py-6">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-baseline sm:justify-between">
          <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground">
            <span class="label mr-2 text-brand-700 dark:text-brand-400">{c.plate.label}</span>
            {fill(c.plate.caption)}
          </p>
          <p class="figure shrink-0 text-xs text-muted-foreground">{weekdayHours}</p>
        </div>
      </div>
    </section>

    {/* Routing. This table is the page. */}
    <section class="border-b border-brand-50/10 bg-brand-800 py-16 text-brand-50 sm:py-20">
      <div class="shell">
        <div class="max-w-3xl">
          <p class="label text-brand-300">{c.routing.eyebrow}</p>
          <h2 class="display-2 mt-4 text-brand-50">{c.routing.title}</h2>
          <p class="mt-4 max-w-2xl text-[1.0625rem] leading-relaxed text-brand-50/65">
            {c.routing.lead}
          </p>
        </div>

        {/* sm and up: the table. */}
        <div class="mt-10 hidden sm:block">
          <table class="w-full border-collapse text-left">
            <thead>
              <tr class="border-y border-brand-50/15">
                <th scope="col" class="label w-[34%] py-3 pr-6 text-brand-50/60">
                  {c.routing.header.topic}
                </th>
                <th scope="col" class="label w-[20%] py-3 pr-6 text-brand-50/60">
                  {c.routing.header.party}
                </th>
                <th scope="col" class="label py-3 text-brand-50/60">{c.routing.header.how}</th>
              </tr>
            </thead>
            <tbody>
              {
                routingRows.map((row) => (
                  <tr
                    class:list={[
                      "border-b border-brand-50/12 align-top",
                      row.urgent && "bg-brand-50/6",
                    ]}
                  >
                    <th scope="row" class="py-5 pr-6 font-normal">
                      <span class="subhead inline text-brand-50">{row.topic}</span>
                      {row.symbols && <sup class="ml-0.5 text-brand-300">{row.symbols}</sup>}
                    </th>
                    <td class="py-5 pr-6">
                      <span class="flex items-baseline gap-2">
                        {row.urgent && (
                          <TriangleAlert className="mt-0.5 size-4 shrink-0 text-brand-300" />
                        )}
                        <span
                          class:list={[
                            "text-brand-50",
                            row.partyIsFigure ? "figure text-lg" : "subhead",
                          ]}
                        >
                          {row.party}
                        </span>
                      </span>
                    </td>
                    <td class="py-5 text-[0.9375rem] leading-relaxed text-brand-50/60">{row.how}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        {/* Below sm: the same three fields, stacked. */}
        <dl class="mt-10 flex flex-col sm:hidden">
          {
            routingRows.map((row) => (
              <div
                class:list={[
                  "border-t border-brand-50/12 py-5",
                  row.urgent && "-mx-4 bg-brand-50/6 px-4",
                ]}
              >
                <dt class="subhead text-brand-50">
                  {row.topic}
                  {row.symbols && <sup class="ml-0.5 text-brand-300">{row.symbols}</sup>}
                </dt>
                <dd class="mt-2.5">
                  <span
                    class:list={[
                      "flex items-baseline gap-2 text-brand-300",
                      row.partyIsFigure ? "figure text-base" : "subhead text-[0.9375rem]",
                    ]}
                  >
                    {row.urgent && <TriangleAlert className="size-4 shrink-0" />}
                    {row.party}
                  </span>
                  <span class="mt-1.5 block text-sm leading-relaxed text-brand-50/60">
                    {row.how}
                  </span>
                </dd>
              </div>
            ))
          }
        </dl>

        <p class="mt-9 max-w-3xl border-t border-brand-50/12 pt-6 text-sm leading-relaxed text-brand-50/55">
          {c.routing.note}
        </p>
      </div>
    </section>

    <section class="bg-background section">
      <div class="shell">
        <div class="max-w-3xl">
          <p class="label text-brand-700 dark:text-brand-400">{c.response.eyebrow}</p>
          <h2 class="display-2 mt-4">{c.response.title}</h2>
          <p class="lead mt-4">{c.response.lead}</p>
        </div>

        <table class="mt-10 w-full border-collapse text-left">
          <thead>
            <tr class="border-y border-border">
              <th scope="col" class="label py-3 pr-4 text-muted-foreground">
                {c.response.header.what}
              </th>
              <th scope="col" class="label py-3 pr-4 text-muted-foreground sm:w-[11rem] sm:pr-8">
                {c.response.header.when}
              </th>
              <th scope="col" class="label hidden py-3 text-muted-foreground sm:table-cell">
                {c.response.header.detail}
              </th>
            </tr>
          </thead>
          <tbody>
            {
              responseRows.map((row) => (
                <tr class="border-b border-border align-top">
                  <th scope="row" class="py-5 pr-4 font-normal">
                    <span class="subhead">{row.what}</span>
                    {/* Below sm the detail column is dropped, so it rides
                        under the row label instead of being lost. */}
                    <span class="mt-1.5 block text-sm leading-relaxed text-muted-foreground sm:hidden">
                      {row.detail}
                    </span>
                  </th>
                  <td class="figure py-5 pr-4 text-[0.8125rem] text-signal-700 sm:pr-8 dark:text-signal-500">
                    {row.when}
                  </td>
                  <td class="hidden py-5 text-sm leading-relaxed text-muted-foreground sm:table-cell">
                    {row.detail}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <p class="mt-8 max-w-3xl text-sm leading-relaxed text-muted-foreground">
          {c.response.note}
        </p>
      </div>
    </section>

    <section class="bg-card section">
      <div class="shell">
        <div class="grid gap-10 lg:grid-cols-[1fr_22rem] lg:gap-14">
          <div>
            <p class="label text-brand-700 dark:text-brand-400">{c.office.eyebrow}</p>
            <h2 class="display-2 mt-4">{c.office.title}</h2>
            <p class="lead mt-4">{c.office.body}</p>
            <p class="mt-5 max-w-2xl text-sm leading-relaxed text-muted-foreground">
              {c.office.postNote}
            </p>
          </div>

          {
            hasAddress && (
              <aside class="panel h-fit bg-background p-6">
                <p class="label text-muted-foreground">{c.office.addressLabel}</p>
                <address class="figure mt-3 text-[0.9375rem] not-italic leading-relaxed text-foreground">
                  <span class="block">{site.legalName}</span>
                  <span class="block">{site.addressStreet}</span>
                  <span class="block">
                    {site.addressLocality}, {site.addressRegion} {site.addressPostal}
                  </span>
                </address>

                <div class="mt-5 border-t border-border pt-4">
                  <p class="label text-muted-foreground">{c.office.hoursLabel}</p>
                  <p class="figure mt-1.5 text-xs text-foreground">{weekdayHours}</p>
                  <p class="figure mt-1 text-xs text-foreground">{weekendHours}</p>
                </div>

                {site.mapHref && (
                  <a
                    href={site.mapHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-700 dark:text-brand-400"
                  >
                    <MapPin className="size-4" />
                    {c.office.mapCta}
                    <ExternalLink className="size-3.5" />
                  </a>
                )}
              </aside>
            )
          }
        </div>
      </div>
    </section>

    <Cta locale={locale} />
    <ComplianceBand locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
