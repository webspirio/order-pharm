---
import { type Locale, t } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import SeoHead from "@/components/SeoHead.astro";
import Header from "@/components/sections/Header.astro";
import PhoneCta from "@/components/sections/PhoneCta.astro";
import Footer from "@/components/sections/Footer.astro";
import { Landmark, Compass, Briefcase, Scale, CheckCircle2 } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const meta = d.meta.dienste;
const content = d.dienste;

// Positional by the fixed practice-area order (steuerrecht, migrationsrecht,
// arbeitsrecht, zivilrecht) — matches the topic pills on the contact form.
const icons = [Landmark, Compass, Briefcase, Scale];

// Chunked into rows of 2 rather than one flat 4-item grid: a single grid
// with both divide-x and divide-y would add a stray top border to the
// second item too (Tailwind's divide-* only tracks DOM order, not grid
// row/column position), so each row gets its own 2-item divide-x pair —
// trivially correct since "all but the first of two" is unambiguous — and
// the rows themselves are separated by an outer divide-y between exactly
// two rows.
const rows = [
  content.items.map((item, index) => ({ item, index })).slice(0, 2),
  content.items.map((item, index) => ({ item, index })).slice(2, 4),
];
---

<Layout locale={locale} title={meta.title} description={meta.description}>
  <SeoHead slot="head" locale={locale} path="/dienste/" />
  <Header locale={locale} />
  <main id="main" tabindex="-1" class="page-tint outline-none">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <p class="mb-3 text-xs font-bold uppercase leading-relaxed tracking-[0.28em] text-brand-700 dark:text-brand-400">
        {content.eyebrow}
      </p>
      <h1 class="text-3xl sm:text-4xl">{content.title}</h1>
      <p class="mt-3 max-w-prose text-muted-foreground">{content.subtitle}</p>

      <div class="mt-14 flex flex-col divide-y divide-border">
        {rows.map((row) => (
          <div class="grid gap-x-10 py-10 first:pt-0 last:pb-0 sm:grid-cols-2 sm:divide-x sm:divide-border">
            {row.map(({ item, index }) => {
              const Icon = icons[index % icons.length];
              return (
                <section id={item.id} class="scroll-mt-24 sm:px-8 sm:first:pl-0 sm:last:pr-0">
                  <div class="flex items-center gap-3">
                    <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-brand-500/15 text-brand-700 dark:text-brand-400">
                      <Icon className="size-4" />
                    </span>
                    <h2 class="subhead text-xl">{item.title}</h2>
                  </div>
                  <p class="mt-3 whitespace-pre-line leading-relaxed text-muted-foreground">
                    {item.intro}
                  </p>
                  <ul class="mt-5 flex flex-col gap-2.5">
                    {item.bullets.map((bullet) => (
                      <li class="flex gap-2.5 text-sm">
                        <CheckCircle2 className="mt-0.5 size-4 shrink-0 text-brand-600 dark:text-brand-400" />
                        <span class="text-muted-foreground">{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </section>
              );
            })}
          </div>
        ))}
      </div>
    </div>
    <PhoneCta locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
