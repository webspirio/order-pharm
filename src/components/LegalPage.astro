---
/**
 * Both legal documents, from one component: `doc="terms"` and `doc="privacy"`
 * render `d.legal.terms` and `d.legal.privacy` through the same layout.
 *
 * WHY IT IS BUILT THIS WAY. A legal page in this category is where design
 * gives up — 4,000 words of 13px grey, no navigation, an all-caps arbitration
 * wall, and a "last updated" line nobody maintains. Everything here is aimed
 * at the opposite: a numbered document with a contents rail so a reader can
 * get to clause six directly, real `<table>`s where the content is rows of
 * pairs (the fee schedule, the HIPAA buckets, the transmission list), a
 * definition list where the content is defined terms, and the two clauses
 * that matter most — arbitration and the class-action waiver — set on the
 * pale signal surface in ordinary sentences rather than shouted in capitals.
 * Conspicuousness is a design property; capitals stopped supplying it decades
 * ago.
 *
 * THREE THINGS THE REBUILD ADDED, and the reason for each:
 *
 * 1. THE COLOPHON. The masthead is now two poles — the title and lead on the
 *    left, a panel on the right that states the effective date, the clause
 *    count and the length. All three are COUNTED from the document rather
 *    than typed, so the page cannot claim a size it does not have. Telling a
 *    reader it is four thousand words before they start is the same courtesy
 *    as publishing the fee before the intake.
 * 2. THE DRAWN RAIL. The contents list is ruled and ticked, one graduation
 *    per clause — the same ruler language as the Relay and the CTA plate's
 *    tick scale, which is what a numbered document actually is.
 * 3. THE DEFINITION LIST. Every list in these documents is written
 *    "Term — explanation". A `<ul>` of those is rows of pairs pretending to
 *    be prose; where every item in a list is a pair it is rendered as a real
 *    `<dl>`, which is both the correct semantics and the only way the terms
 *    become skimmable. A list with any non-pair item stays a `<ul>`.
 *
 * THE DICTIONARY IS TOKENISED. Every `{token}` in `src/i18n/en/legal.ts` is
 * substituted here from `src/config/pricing.ts` and `src/config/site.ts`, and
 * a figure token is wrapped in `.figure` so a fee quoted in the Terms is the
 * same glyphs as the same fee on /pricing/. An unknown token throws at build
 * time rather than rendering a brace to a visitor, and a footnote token is
 * looked up in `d.compliance.notes` so a symbol that the compliance band does
 * not define cannot ship.
 *
 * THESE ARE THE TWO PAGES PEOPLE PRINT. The print rules at the foot of this
 * file drop the navigation furniture — a contents list and a "read this next"
 * block are dead ink on paper — and keep tables and panels off page breaks.
 *
 * The sales `Cta` is deliberately absent. A page whose job is to disclose
 * should not close with a button.
 */
import { type Locale, t, localizedPath } from "@/i18n";
import { site } from "@/config/site";
import {
  fees,
  shipping,
  coverage,
  eligibility,
  partners,
  usd,
  usdMonthly,
  membershipBreakEven,
} from "@/config/pricing";
import Layout from "@/layouts/Layout.astro";
import SeoHead from "@/components/SeoHead.astro";
import TrustTicker from "@/components/sections/TrustTicker.astro";
import Header from "@/components/sections/Header.astro";
import ComplianceBand from "@/components/sections/ComplianceBand.astro";
import Footer from "@/components/sections/Footer.astro";
import { ArrowRight, ChevronDown, TriangleAlert } from "lucide-react";

interface Props {
  locale: Locale;
  doc: "terms" | "privacy";
}

const { locale, doc } = Astro.props;
const d = t(locale);

/**
 * DOCUMENT PARAMETERS. Every business figure on this site comes from
 * `src/config/pricing.ts`, and none of these are business figures — they are
 * parameters of the documents themselves (the effective date, the notice
 * periods, the retention schedule). They are declared once, here, so the two
 * documents cannot disagree with each other, and they are rendered through
 * the same mono figure treatment as a price.
 *
 * Before launch they belong in `src/config/` beside the rest of the site's
 * data, set by whoever's counsel signs the documents off; that file is shared
 * and outside this task, so the values live here for now.
 */
const docParams = {
  /** ISO, deliberately: an unambiguous date on a document that has legal force. */
  effective: "2026-07-01",
  renewalNotice: "3 days",
  changeNotice: "30 days",
  informalWindow: "30 days",
  optOutWindow: "30 days",
  liabilityWindow: "12 months",
  rightsDays: "45 days",
  accountRetention: "3 years",
  clinicalRetention: "7 to 10 years",
  dispensingRetention: "5 to 10 years",
  taxRetention: "7 years",
  logRetention: "90 days",
  supportRetention: "3 years",
} as const;

/* ------------------------------------------------------------------ */
/* Token substitution                                                  */
/* ------------------------------------------------------------------ */

const escapeHtml = (value: string) =>
  value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

/** Any number the reader is meant to trust, in the site's data face. */
const figure = (value: string) => `<span class="figure">${escapeHtml(value)}</span>`;

/**
 * A duration in prose: the numeral in the data face, the unit in the sans,
 * joined by a non-breaking space. Setting "30 days" wholly in a monospace
 * inside a running sentence reads as a double space; setting only the figure
 * is also what the type system asks for — mono is for the number, and the
 * unit beside it is a word.
 */
const duration = (value: string) => {
  const parts = value.match(/^([\d.,]+(?:\s+to\s+[\d.,]+)?)\s+(.+)$/);
  if (!parts) return figure(value);
  return `${figure(parts[1])}\u00a0${escapeHtml(parts[2])}`;
};

/**
 * An inline link inside grey prose. INK, not a colour — the site has three
 * text tones per ground and a fourth invented for links would be one too
 * many, so the link is distinguished by weight and a rule rather than by hue.
 * The rule warms to the signal on hover, which is the only place amber is
 * spent inside the running text.
 */
const link = (href: string, label: string, mono = false) =>
  `<a href="${href}" class="${
    mono ? "figure " : ""
  }font-medium text-foreground underline decoration-border decoration-1 underline-offset-4 transition-colors hover:decoration-signal-500">${escapeHtml(
    label,
  )}</a>`;

/**
 * A footnote reference, verified against the compliance band. A symbol that
 * resolves nowhere is the category's signature defect, so referencing one that
 * `common.ts` does not define fails the build instead of shipping.
 */
const verifySymbol = (symbol: string) => {
  const defined = d.compliance.notes.some((note) => note.symbol === symbol);
  if (!defined) {
    throw new Error(
      `LegalPage: footnote "${symbol}" is not defined in common.ts's compliance.notes.`,
    );
  }
  return symbol;
};

const footnote = (symbol: string) =>
  `<sup class="ml-0.5 text-signal-700 dark:text-signal-500">${verifySymbol(symbol)}</sup>`;

const pharmacyNames = partners.pharmacies.map((pharmacy) => pharmacy.name);
const officeLine = `${site.addressStreet}, ${site.addressLocality}, ${site.addressRegion} ${site.addressPostal}`;

const tokens: Record<string, string> = {
  /* Parties and contact */
  legalName: escapeHtml(site.legalName),
  practice: escapeHtml(partners.practice),
  pharmacies: escapeHtml(
    `${pharmacyNames.slice(0, -1).join(", ")} and ${pharmacyNames[pharmacyNames.length - 1]}`,
  ),
  office: escapeHtml(officeLine),
  email: link(site.mailHref, site.email),
  phone: link(site.phoneHref, site.phoneDisplay, true),
  supportHours: figure(d.footer.supportHours),

  /* Money and thresholds — from pricing.ts, never typed */
  visit: figure(usd(fees.visit)),
  admin: figure(usd(fees.admin)),
  overnight: figure(usd(shipping.overnightCost)),
  remote: figure(usd(shipping.remoteSurcharge)),
  memberMonthly: figure(usdMonthly(fees.membershipMonthly)),
  memberYearly: figure(usd(fees.membershipYearly)),
  breakEvenBest: figure(String(membershipBreakEven.best)),
  breakEvenWorst: figure(String(membershipBreakEven.worst)),
  minAge: figure(String(eligibility.minAge)),
  minAgeSermorelin: figure(String(eligibility.minAgeSermorelin)),
  states: `${figure(String(coverage.states))} states${
    coverage.includesDC ? " and the District of Columbia" : ""
  }`,

  /* Document parameters */
  effective: figure(docParams.effective),
  renewalNotice: duration(docParams.renewalNotice),
  changeNotice: duration(docParams.changeNotice),
  informalWindow: duration(docParams.informalWindow),
  optOutWindow: duration(docParams.optOutWindow),
  liabilityWindow: duration(docParams.liabilityWindow),
  rightsDays: duration(docParams.rightsDays),
  accountRetention: duration(docParams.accountRetention),
  clinicalRetention: duration(docParams.clinicalRetention),
  dispensingRetention: duration(docParams.dispensingRetention),
  taxRetention: duration(docParams.taxRetention),
  logRetention: duration(docParams.logRetention),
  supportRetention: duration(docParams.supportRetention),

  /* The gating sentence, borrowed rather than rewritten */
  gatingLong: escapeHtml(d.gating.long),
  gatingShort: escapeHtml(d.gating.short),

  /* Footnotes, resolved by the compliance band at the foot of the page */
  n_provider: footnote("*"),
  n_fee: footnote("†"),
  n_compound: footnote("‡"),
  n_glp1: footnote("§"),
  n_longevity: footnote("¶"),
  n_hipaa: footnote("◆"),
  n_marks: footnote("‖"),
  n_demo: footnote("◇"),
};

/** Escape first, then substitute, so a token's own markup survives. */
const render = (value: string) =>
  escapeHtml(value).replace(/\{(\w+)\}/g, (_match, key: string) => {
    const replacement = tokens[key];
    if (replacement === undefined) {
      throw new Error(`LegalPage: unknown token {${key}} in the legal dictionary.`);
    }
    return replacement;
  });

const paragraphs = (value: string) => render(value).split("\n\n");

/**
 * Lists are written "Term — explanation". Where EVERY item in a list is a
 * pair, the list is rendered as a `<dl>` (see `pairsOf` below). Where one is
 * not — the "what you may not do" list is six plain prohibitions — the list
 * stays a `<ul>`, and any pair inside it still gets its term promoted, which
 * is what turns an enumerated legal list into something a reader can skim.
 */
const PAIR = " — ";

const listItem = (value: string) => {
  const at = value.indexOf(PAIR);
  if (at === -1) return render(value);
  return `<strong class="font-semibold text-foreground">${render(
    value.slice(0, at),
  )}</strong> — ${render(value.slice(at + PAIR.length))}`;
};

const pairsOf = (items: string[]) =>
  items.every((item) => item.includes(PAIR))
    ? items.map((item) => {
        const at = item.indexOf(PAIR);
        return { term: render(item.slice(0, at)), def: render(item.slice(at + PAIR.length)) };
      })
    : null;

/* ------------------------------------------------------------------ */
/* The document                                                        */
/* ------------------------------------------------------------------ */

interface TableBlock {
  label: string;
  head: string[];
  rows: string[][];
  note?: string;
}

interface PanelBlock {
  label: string;
  title: string;
  body: string;
}

/** A block renders whichever of these it carries, in this order. */
interface Block {
  subheading?: string;
  text?: string;
  items?: string[];
  table?: TableBlock;
  panel?: PanelBlock;
  /** Small print under the block — the gating sentence, a caveat. */
  note?: string;
}

interface Section {
  id: string;
  heading: string;
  /** Footnote symbols the whole section carries. */
  symbols?: string[];
  blocks: Block[];
}

const docData = doc === "terms" ? d.legal.terms : d.legal.privacy;
const sections: Section[] = docData.sections;
const meta = doc === "terms" ? d.meta.terms : d.meta.privacy;
const path = doc === "terms" ? "/terms/" : "/privacy/";

const index = (position: number) => String(position + 1).padStart(2, "0");

/**
 * THE LENGTH, COUNTED. Every string the reader will actually read, with the
 * tokens resolved and the markup stripped, at a flat 200 words per minute —
 * the ordinary convention, and deliberately not adjusted downward to make the
 * document look shorter than it is. `tokens` is populated after it is
 * declared because `render()` reads it at call time, and the count itself has
 * to be rendered before it can be counted.
 */
const readable = (value: string) => render(value).replace(/<[^>]*>/g, " ");

const documentWords = sections
  .flatMap((section) => [
    section.heading,
    ...section.blocks.flatMap((block) => [
      block.subheading ?? "",
      block.text ?? "",
      ...(block.items ?? []),
      ...(block.table ? [block.table.label, ...block.table.rows.flat(), block.table.note ?? ""] : []),
      ...(block.panel ? [block.panel.label, block.panel.title, block.panel.body] : []),
      block.note ?? "",
    ]),
  ])
  .reduce((total, value) => total + readable(value).split(/\s+/).filter(Boolean).length, 0);

const readingMinutes = Math.max(1, Math.round(documentWords / 200));

tokens.words = figure(documentWords.toLocaleString("en-US"));
tokens.minutes = figure(String(readingMinutes));

/** The other document first, then the pages a reader of this one asks for. */
const related = [
  doc === "terms"
    ? { label: d.footer.privacy, href: localizedPath(locale, "/privacy/") }
    : { label: d.footer.terms, href: localizedPath(locale, "/terms/") },
  { label: d.nav.contact, href: localizedPath(locale, "/contact/") },
  { label: d.nav.pricing, href: localizedPath(locale, "/pricing/") },
  { label: d.nav.faq, href: localizedPath(locale, "/faq/") },
];
---

<Layout locale={locale} title={meta.title} description={meta.description}>
  <SeoHead slot="head" locale={locale} path={path} />
  <Header locale={locale} />
  <main id="main" tabindex="-1" class="outline-none">
    {/* MASTHEAD. Two poles: the document on the left, what it is on the
        right. The effective date is mono because it is a figure with legal
        force, and it is repeated at the foot of the document, which is where
        the text itself refers to it. */}
    <section class="bg-card page-top pb-14 sm:pb-16">
      <div class="shell">
        <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between lg:gap-16">
          <div class="max-w-2xl">
            <p class="label text-signal-700 dark:text-signal-500">{docData.eyebrow}</p>
            <h1 class="display-1 mt-5">{docData.title}</h1>
            <p class="lead mt-6 text-lg" set:html={render(docData.lead)} />

            <a
              href={related[0].href}
              class="group mt-8 inline-flex items-center gap-2 text-[0.9375rem] font-semibold text-foreground transition-colors hover:text-signal-700 dark:hover:text-signal-500"
            >
              {related[0].label}
              <ArrowRight className="size-4 transition-transform group-hover:translate-x-1" />
            </a>
          </div>

          {/* THE COLOPHON. Three counted facts about the document itself, on
              `bg-background` — a card the colour of the band it sits on is
              not a card. The heading is outside the `<dl>` because `<p>` is
              not a permitted child of one. */}
          <div class="panel w-full shrink-0 bg-background p-6 lg:w-[19rem]">
            <p class="label text-muted-foreground">{d.legal.spec.label}</p>

            <dl class="mt-5">
              <div class="border-t border-hairline pt-3.5">
                <dt class="label text-muted-foreground">{d.legal.effectiveLabel}</dt>
                <dd class="figure mt-1.5 text-[1.0625rem] text-foreground">
                  {docParams.effective}
                </dd>
              </div>
              <div class="mt-3.5 border-t border-hairline pt-3.5">
                <dt class="label text-muted-foreground">{d.legal.spec.sectionsLabel}</dt>
                <dd class="figure mt-1.5 text-[1.0625rem] text-foreground">{sections.length}</dd>
              </div>
              <div class="mt-3.5 border-t border-hairline pt-3.5">
                <dt class="label text-muted-foreground">{d.legal.spec.lengthLabel}</dt>
                <dd
                  class="mt-1.5 text-[0.9375rem] text-muted-foreground"
                  set:html={render(d.legal.spec.lengthValue)}
                />
              </div>
            </dl>
          </div>
        </div>

        {/* The document's status, once, designed. Not a marker sprinkled
            through the body: a reader either knows this before they start or
            the notice has failed. */}
        <div class="panel mt-10 max-w-3xl border-l-2 border-l-signal-500 bg-background p-5 sm:p-6">
          <div class="flex gap-3.5">
            <TriangleAlert className="mt-0.5 size-4 shrink-0 text-signal-700 dark:text-signal-500" />
            <div>
              <p class="label text-signal-700 dark:text-signal-500">{d.legal.notice.label}</p>
              <p class="subhead mt-2.5">{d.legal.notice.title}</p>
              <p
                class="mt-2 text-[0.875rem] leading-relaxed text-muted-foreground"
                set:html={render(d.legal.notice.body)}
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* The ticker closes the head block, the same slot it takes under the
        hero on the homepage. It cannot sit above the nav any more: the
        header floats. */}
    <TrustTicker locale={locale} />

    <section class="bg-background section">
      <div class="shell">
        <div class="grid gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-14">
          {/* THE CONTENTS RAIL, drawn. A 4,000-word document without one is a
              document you are expected not to read. The rule with a
              graduation per clause is the same ruler the Relay and the CTA
              plate use — a numbered document is a scale, and this is what it
              looks like when you admit that. */}
          <nav
            aria-labelledby="toc-label"
            class="legal-toc hidden lg:sticky lg:top-32 lg:block lg:self-start"
          >
            <p id="toc-label" class="label text-muted-foreground">{d.legal.tocLabel}</p>
            <ol class="mt-5 border-l border-border">
              {
                sections.map((section, position) => (
                  <li>
                    <a
                      href={`#${section.id}`}
                      class="group relative flex gap-3 py-2 pl-5 text-[0.8125rem] leading-snug text-muted-foreground transition-colors hover:text-foreground"
                    >
                      <span
                        aria-hidden="true"
                        class="absolute top-[0.95rem] left-0 h-px w-3 bg-border transition-colors group-hover:bg-signal-500"
                      />
                      <span aria-hidden="true" class="figure shrink-0 text-[0.6875rem] leading-5">
                        {index(position)}
                      </span>
                      <span>{section.heading}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>

          <article class="max-w-3xl">
            {/* Same contents, collapsed, below lg. */}
            <details class="panel legal-toc-mobile group mb-12 p-4 lg:hidden">
              <summary
                class="label flex cursor-pointer list-none items-center justify-between gap-4 text-muted-foreground marker:hidden [&::-webkit-details-marker]:hidden"
              >
                {d.legal.tocMobileLabel}
                <ChevronDown className="size-4 transition-transform group-open:rotate-180" />
              </summary>
              <ol class="mt-2 flex flex-col">
                {
                  sections.map((section, position) => (
                    <li class="border-t border-hairline">
                      <a
                        href={`#${section.id}`}
                        class="flex gap-3 py-2.5 text-[0.8125rem] leading-snug text-muted-foreground"
                      >
                        <span aria-hidden="true" class="figure shrink-0 text-[0.6875rem] leading-5">
                          {index(position)}
                        </span>
                        <span>{section.heading}</span>
                      </a>
                    </li>
                  ))
                }
              </ol>
            </details>

            <div class="flex flex-col gap-14">
              {
                sections.map((section, position) => (
                  <section id={section.id} class="legal-clause border-t border-border pt-9">
                    <div class="flex items-baseline gap-4">
                      <span
                        aria-hidden="true"
                        class="figure shrink-0 text-sm text-signal-700 dark:text-signal-500"
                      >
                        {index(position)}
                      </span>
                      {/* The visible numeral is aria-hidden, so the clause
                          number reaches heading navigation through this
                          prefix instead — "Section 6. Prescriptions…". */}
                      <h2 class="display-3">
                        <span class="sr-only">{`${d.legal.sectionLabel} ${position + 1}. `}</span>
                        {section.heading}
                        {section.symbols?.map((symbol) => (
                          <sup class="ml-1 align-super text-[0.4em] text-signal-700 dark:text-signal-500">
                            {verifySymbol(symbol)}
                          </sup>
                        ))}
                      </h2>
                    </div>

                    {
                      section.blocks.map((block) => (
                        <div>
                          {block.subheading && (
                            <h3 class="subhead mt-8 text-foreground">{block.subheading}</h3>
                          )}

                          {block.text &&
                            paragraphs(block.text).map((paragraph) => (
                              <p
                                class="mt-5 whitespace-pre-line text-[0.9375rem] leading-[1.72] text-muted-foreground"
                                set:html={paragraph}
                              />
                            ))}

                          {block.items &&
                            (pairsOf(block.items) ? (
                              /* DEFINED TERMS. Rows of pairs, so a real
                                 definition list: the term is the row's
                                 heading at sm and up, and stacks above its
                                 explanation below that, where a 13rem column
                                 would leave four words per line. */
                              <dl class="mt-6">
                                {pairsOf(block.items)!.map((pair) => (
                                  <div class="grid gap-1 border-t border-hairline py-4 last:border-b sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-6">
                                    <dt
                                      class="text-[0.9375rem] leading-snug font-semibold text-foreground"
                                      set:html={pair.term}
                                    />
                                    <dd
                                      class="text-[0.9375rem] leading-[1.72] text-muted-foreground"
                                      set:html={pair.def}
                                    />
                                  </div>
                                ))}
                              </dl>
                            ) : (
                              <ul class="mt-6 flex flex-col">
                                {block.items.map((item, itemIndex) => (
                                  <li class="flex gap-4 border-t border-hairline py-3.5 last:border-b">
                                    <span
                                      aria-hidden="true"
                                      class="figure mt-[0.15rem] shrink-0 text-[0.6875rem] text-muted-foreground"
                                    >
                                      {index(itemIndex)}
                                    </span>
                                    <p
                                      class="text-[0.9375rem] leading-[1.72] text-muted-foreground"
                                      set:html={listItem(item)}
                                    />
                                  </li>
                                ))}
                              </ul>
                            ))}

                          {block.table && (
                            <div class="panel mt-7 overflow-hidden">
                              {/* sm and up: a real table. Below it, the same
                                  pairs as a definition list — a four-column
                                  table at 360px produces unreadable columns. */}
                              <div class="hidden overflow-x-auto sm:block">
                                <table class="w-full border-collapse text-left">
                                  <caption class="label px-5 pt-5 pb-4 text-left text-muted-foreground">
                                    {block.table.label}
                                  </caption>
                                  <thead>
                                    <tr class="border-y border-border">
                                      {block.table.head.map((heading) => (
                                        <th
                                          scope="col"
                                          class="label px-5 py-3 align-bottom text-muted-foreground"
                                        >
                                          {heading}
                                        </th>
                                      ))}
                                    </tr>
                                  </thead>
                                  <tbody>
                                    {block.table.rows.map((row) => (
                                      <tr class="border-b border-hairline align-top last:border-b-0">
                                        {row.map((cell, cellIndex) =>
                                          cellIndex === 0 ? (
                                            <th
                                              scope="row"
                                              class="px-5 py-4 text-[0.875rem] leading-snug font-semibold text-foreground"
                                              set:html={render(cell)}
                                            />
                                          ) : (
                                            <td
                                              class="px-5 py-4 text-[0.8125rem] leading-relaxed text-muted-foreground"
                                              set:html={render(cell)}
                                            />
                                          ),
                                        )}
                                      </tr>
                                    ))}
                                  </tbody>
                                </table>
                              </div>

                              <div class="p-5 sm:hidden">
                                <p class="label text-muted-foreground">{block.table.label}</p>
                                <dl class="mt-2 flex flex-col">
                                  {block.table.rows.map((row) => (
                                    <div class="border-t border-hairline py-4 last:pb-0">
                                      <dt
                                        class="text-[0.9375rem] leading-snug font-semibold text-foreground"
                                        set:html={render(row[0])}
                                      />
                                      {row.slice(1).map((cell, cellIndex) => (
                                        <dd class="mt-3">
                                          <span class="label block text-muted-foreground">
                                            {block.table?.head[cellIndex + 1]}
                                          </span>
                                          <span
                                            class="mt-1 block text-[0.8125rem] leading-relaxed text-muted-foreground"
                                            set:html={render(cell)}
                                          />
                                        </dd>
                                      ))}
                                    </div>
                                  ))}
                                </dl>
                              </div>
                            </div>
                          )}

                          {block.table?.note && (
                            <p
                              class="mt-3.5 text-[0.8125rem] leading-relaxed text-muted-foreground"
                              set:html={render(block.table.note)}
                            />
                          )}

                          {block.panel && (
                            /* THE ONE CLAUSE THAT MUST NOT BE MISSED — the
                               arbitration and class-action waiver in the
                               Terms, the HIPAA split in the Privacy Policy.
                               On the pale signal surface rather than in
                               capitals: the category's convention is a wall
                               of upper case, which is unreadable and stopped
                               being conspicuous decades ago. */
                            <div class="plate-soft mt-8 p-5 sm:p-7">
                              <p class="label">{block.panel.label}</p>
                              <h3 class="subhead mt-3 text-lg">{block.panel.title}</h3>
                              {paragraphs(block.panel.body).map((paragraph) => (
                                <p
                                  class="mt-4 whitespace-pre-line text-[0.9375rem] leading-[1.72]"
                                  set:html={paragraph}
                                />
                              ))}
                            </div>
                          )}

                          {block.note && (
                            <p
                              class="mt-6 border-l-2 border-border pl-4 text-[0.8125rem] leading-relaxed text-muted-foreground"
                              set:html={render(block.note)}
                            />
                          )}
                        </div>
                      ))
                    }
                  </section>
                ))
              }
            </div>

            <p
              class="mt-14 border-t border-border pt-6 text-[0.8125rem] leading-relaxed text-muted-foreground"
              set:html={render(d.legal.effectiveNote)}
            />

            <div class="legal-related mt-12">
              <p class="label text-muted-foreground">{d.legal.relatedLabel}</p>
              <ul class="mt-4 grid gap-x-8 sm:grid-cols-2">
                {
                  related.map((item) => (
                    <li class="border-b border-border">
                      <a
                        href={item.href}
                        class="group flex items-center justify-between gap-4 py-3 text-[0.9375rem] font-medium transition-colors hover:text-signal-700 dark:hover:text-signal-500"
                      >
                        {item.label}
                        <ArrowRight
                          aria-hidden="true"
                          className="size-4 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-1"
                        />
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <ComplianceBand locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>

<style>
  /**
   * PRINT. These are the two pages people actually print, and the global
   * print block in global.css already flattens the slab, the plate and every
   * panel. What is left is this document's own furniture.
   *
   * A contents list and a "read this next" block are navigation: on paper
   * they are ink spent on links nobody can follow. The clause rule is kept —
   * it is what makes the printout look like a document rather than a dump —
   * and tables, defined-term rows and the two notice panels are held off page
   * breaks, because a table split across a sheet loses its header row.
   */
  @media print {
    .legal-toc,
    .legal-toc-mobile,
    .legal-related {
      display: none;
    }
    .legal-clause {
      break-inside: auto;
    }
    .legal-clause h2 {
      break-after: avoid;
    }
    .legal-clause table,
    .legal-clause dl > div,
    .legal-clause .plate-soft {
      break-inside: avoid;
    }
  }
</style>
