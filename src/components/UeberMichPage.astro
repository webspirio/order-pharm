---
import { type Locale, t } from "@/i18n";
import { site } from "@/config/site";
import Layout from "@/layouts/Layout.astro";
import SeoHead from "@/components/SeoHead.astro";
import Header from "@/components/sections/Header.astro";
import PhoneCta from "@/components/sections/PhoneCta.astro";
import Footer from "@/components/sections/Footer.astro";
import { Image } from "astro:assets";
import portrait from "@/assets/olga-gatlin-portrait.png";
import { CheckCircle2 } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const meta = d.meta.ueberMich;
const content = d.ueberMich;
---

<Layout locale={locale} title={meta.title} description={meta.description}>
  <SeoHead slot="head" locale={locale} path="/ueber-mich/" />
  <Header locale={locale} />
  <main id="main" tabindex="-1" class="page-tint outline-none">
    <section class="border-b border-border/60 py-20 sm:py-24">
      <div class="mx-auto grid max-w-5xl items-start gap-10 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div>
          <p class="mb-3 text-xs font-bold uppercase leading-relaxed tracking-[0.28em] text-brand-700 dark:text-brand-400">
            {content.eyebrow}
          </p>
          <h1 class="text-3xl sm:text-4xl">{content.title}</h1>
          <p class="mt-5 text-base leading-relaxed text-muted-foreground sm:text-lg">
            {content.intro}
          </p>
          <p class="mt-4 whitespace-pre-line leading-relaxed text-muted-foreground">
            {content.body}
          </p>

          {/* Two separate timelines rather than one merged list: the
              Werdegang path is a strict 1996→2014 chronology, while the
              additional qualifications are an ongoing/ad-hoc mix (some
              dated, some not) that doesn't sit on that same timeline —
              merging them used to put "since 2018" ahead of "since 2013". */}
          <h2 class="mt-10 subhead">{content.qualifications.title}</h2>
          <ul class="mt-4 flex flex-col gap-3">
            {content.qualifications.items.map((item) => (
              <li class="flex gap-3">
                <CheckCircle2 className="mt-0.5 size-5 shrink-0 text-brand-600 dark:text-brand-400" />
                <span class="text-muted-foreground">{item}</span>
              </li>
            ))}
          </ul>

          <h2 class="mt-10 subhead">{content.additionalQualifications.title}</h2>
          <ul class="mt-4 flex flex-col gap-3">
            {content.additionalQualifications.items.map((item) => (
              <li class="flex gap-3">
                <CheckCircle2 className="mt-0.5 size-5 shrink-0 text-brand-600 dark:text-brand-400" />
                <span class="text-muted-foreground">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col gap-6">
          <div class="relative">
            <Image
              src={portrait}
              alt={site.name}
              widths={[320, 480, 640]}
              sizes="20rem"
              class="aspect-[4/5] w-full rounded-2xl border border-border object-cover shadow-xl"
              loading="eager"
            />
            {/* The source photo's warm, slightly grey-yellow cast reads as
                mismatched against the site's blue palette — a light brand-500
                wash (not a blend mode, just a flat translucent fill, matching
                the Hero scrim's own technique) pulls it back toward the site's
                colour temperature without hiding the photo underneath. */}
            <div class="pointer-events-none absolute inset-0 rounded-2xl bg-brand-500/8"></div>
            <div
              class="absolute bottom-5 left-5 rounded-xl border border-white/15 bg-black/55 px-4 py-3 text-white shadow-lg backdrop-blur-md"
            >
              <p class="text-2xl leading-none">{d.hero.badge.value}</p>
              <p class="mt-1 text-xs font-medium uppercase tracking-wide text-white/80">
                {d.hero.badge.label}
              </p>
            </div>
          </div>

          {/* Borderless, like the Hero tiles/Contact channels — sub-sections
              separated by a hairline (divide-y) instead of each living in
              its own bordered box, and the focus-area pills are filled
              chips (no border) rather than outlined tags. */}
          <div class="flex flex-col divide-y divide-border rounded-2xl bg-card">
            <div class="pb-5">
              <h2 class="font-sans text-sm font-bold uppercase tracking-wide text-muted-foreground">
                {content.focus.title}
              </h2>
              <div class="mt-3 flex flex-wrap gap-2">
                {content.focus.items.map((item) => (
                  <span class="rounded-full bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-700 dark:text-brand-400">
                    {item}
                  </span>
                ))}
              </div>
            </div>

            <div class="py-5">
              <h2 class="font-sans text-sm font-bold uppercase tracking-wide text-muted-foreground">
                {content.languages.title}
              </h2>
              <p class="mt-2 text-sm">{content.languages.text}</p>
            </div>

            <div class="py-5">
              <h2 class="font-sans text-sm font-bold uppercase tracking-wide text-muted-foreground">
                {content.membership.title}
              </h2>
              <p class="mt-2 text-sm">{content.membership.text}</p>
            </div>

            <div class="pt-5">
              <h2 class="font-sans text-sm font-bold uppercase tracking-wide text-muted-foreground">
                {content.achievements.title}
              </h2>
              <ul class="mt-2 flex flex-col gap-1.5">
                {content.achievements.items.map((item) => (
                  <li class="text-sm">{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
    <PhoneCta locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
