---
import { type Locale, t, localizedPath } from "@/i18n";
import { site } from "@/config/site";
import { Mail, MapPin, Phone } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

// Evaluated at build time; rebuilding refreshes it.
const year = new Date().getFullYear();

const navLinks = [
  { label: d.nav.services, href: localizedPath(locale, "/dienste/") },
  { label: d.nav.about, href: localizedPath(locale, "/ueber-mich/") },
  { label: d.nav.contact, href: localizedPath(locale, "/kontakt/") },
];

const hasAddress = Boolean(site.addressStreet && site.addressCountryCode);
---

<footer class="border-t border-brand-50/10 bg-brand-800 text-brand-50">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <p class="font-extrabold tracking-tight text-brand-50">{site.name}</p>
        <p class="mt-2 text-sm text-brand-50/65">{d.footer.tagline}</p>
        {(site.facebookUrl || site.youtubeUrl) && (
          <div class="mt-4 flex items-center gap-3">
            {site.facebookUrl && (
              <a
                href={site.facebookUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
                class="inline-flex size-8 items-center justify-center rounded-full bg-brand-50/10 text-brand-50/70 transition-colors hover:bg-brand-50/20 hover:text-brand-50"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
                  <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"
                  ></path>
                </svg>
              </a>
            )}
            {site.youtubeUrl && (
              <a
                href={site.youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="YouTube"
                class="inline-flex size-8 items-center justify-center rounded-full bg-brand-50/10 text-brand-50/70 transition-colors hover:bg-brand-50/20 hover:text-brand-50"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
                  <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M23 12s0-3.6-.46-5.32a2.9 2.9 0 0 0-2.05-2.05C18.78 4.17 12 4.17 12 4.17s-6.78 0-8.49.46A2.9 2.9 0 0 0 1.46 6.68 30.6 30.6 0 0 0 1 12s0 3.6.46 5.32a2.9 2.9 0 0 0 2.05 2.05c1.71.46 8.49.46 8.49.46s6.78 0 8.49-.46a2.9 2.9 0 0 0 2.05-2.05C23 15.6 23 12 23 12ZM10 15.5l6-3.5-6-3.5v7Z"
                  ></path>
                </svg>
              </a>
            )}
          </div>
        )}
      </div>

      <div>
        <h2 class="text-xs font-bold uppercase tracking-widest text-brand-50/50">{d.footer.navTitle}</h2>
        <nav class="mt-3 flex flex-col gap-2 text-sm text-brand-50/70">
          <a href={localizedPath(locale, "/")} class="w-fit transition-colors hover:text-brand-50">
            {d.footer.home}
          </a>
          {navLinks.map((link) => (
            <a href={link.href} class="w-fit transition-colors hover:text-brand-50">
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <div>
        <h2 class="text-xs font-bold uppercase tracking-widest text-brand-50/50">{d.footer.contactTitle}</h2>
        <div class="mt-3 flex flex-col gap-2.5 text-sm text-brand-50/70">
          {site.phoneHref && (
            <a href={site.phoneHref} class="flex items-center gap-2 w-fit transition-colors hover:text-brand-50">
              <Phone className="size-3.5 shrink-0" />
              {site.phoneDisplay}
            </a>
          )}
          <a href={site.mailHref} class="flex items-center gap-2 w-fit transition-colors hover:text-brand-50">
            <Mail className="size-3.5 shrink-0" />
            {site.email}
          </a>
          {hasAddress && (
            <span class="flex items-start gap-2">
              <MapPin className="mt-0.5 size-3.5 shrink-0" />
              {site.addressStreet}, {site.addressPostal} {site.addressLocality}
            </span>
          )}
        </div>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-brand-50/10 pt-6 text-sm text-brand-50/65 sm:flex-row sm:items-center sm:justify-between"
    >
      {/* No literal period after legalName — it may already end in one
          ("Acme Ltd."), which would render "Acme Ltd..". */}
      <span>© {year} {site.legalName} · {d.footer.rights}</span>
      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a href={localizedPath(locale, "/imprint/")} class="transition-colors hover:text-brand-50">
          {d.footer.imprint}
        </a>
        <a href={localizedPath(locale, "/privacy/")} class="transition-colors hover:text-brand-50">
          {d.footer.privacy}
        </a>
      </nav>
    </div>
  </div>
</footer>
