---
import { type Locale, t, localizedPath } from "@/i18n";
import { site } from "@/config/site";
import { partners } from "@/config/pricing";
import Mark from "@/components/Mark.astro";
import { Mail, MapPin, Phone } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

// Evaluated at build time; rebuilding refreshes it.
const year = new Date().getFullYear();

/**
 * Each column used to render `d.footer.home` above its own links, which put
 * three identical "Home" links in three adjacent columns. Home now appears
 * once, at the head of the first column, where the wordmark to its left
 * already links there anyway.
 */
const columns = [
  {
    title: d.footer.columns.programs,
    links: [
      { label: d.footer.home, href: localizedPath(locale, "/") },
      { label: d.nav.weightLoss, href: localizedPath(locale, "/weight-loss/") },
      { label: d.nav.longevity, href: localizedPath(locale, "/longevity/") },
      { label: d.nav.cta, href: localizedPath(locale, "/start/") },
    ],
  },
  {
    title: d.footer.columns.company,
    links: [
      { label: d.nav.howItWorks, href: localizedPath(locale, "/how-it-works/") },
      { label: d.nav.pricing, href: localizedPath(locale, "/pricing/") },
      { label: d.nav.learn, href: localizedPath(locale, "/learn/") },
    ],
  },
  {
    title: d.footer.columns.support,
    links: [
      { label: d.nav.faq, href: localizedPath(locale, "/faq/") },
      { label: d.nav.contact, href: localizedPath(locale, "/contact/") },
    ],
  },
];

const hasAddress = Boolean(site.addressStreet && site.addressCountryCode);

/**
 * The not-a-provider sentence, in the footer of every page rather than in
 * §14 of the Terms. This is the one disclosure the category's own convergence
 * says must be plain and findable, and it is the first thing a regulator or a
 * careful patient looks for.
 */
const pharmacyNames = partners.pharmacies.map((p) => p.name).join(", ");
---

<footer class="site-footer slab on-slab">
  <div class="shell pt-14 pb-16 sm:pt-16 sm:pb-20">
    <div class="grid gap-10 md:grid-cols-[1.4fr_repeat(3,1fr)] lg:gap-12">
      <div>
        <div class="flex items-center gap-2.5 leading-none">
          <Mark class="size-7 shrink-0 text-signal-500" />
          <span class="text-xl font-semibold tracking-[-0.04em]">{site.name}</span>
        </div>
        <p class="mt-3 max-w-xs text-sm text-brand-50/70">{d.footer.tagline}</p>

        <div class="mt-7 flex flex-col gap-2.5 text-sm text-brand-50/75">
          {
            site.phoneHref && (
              <a href={site.phoneHref} class="flex w-fit items-center gap-2 hover:text-brand-50">
                <Phone className="size-3.5 shrink-0" />
                <span class="figure">{site.phoneDisplay}</span>
              </a>
            )
          }
          <a href={site.mailHref} class="flex w-fit items-center gap-2 hover:text-brand-50">
            <Mail className="size-3.5 shrink-0" />
            {site.email}
          </a>
          {
            hasAddress && (
              <span class="flex items-start gap-2 text-brand-50/60">
                <MapPin className="mt-0.5 size-3.5 shrink-0" />
                <span>
                  <span class="label block text-[0.5625rem] text-brand-50/60">
                    {d.footer.address}
                  </span>
                  {site.addressStreet}, {site.addressLocality} {site.addressRegion}{" "}
                  {site.addressPostal}
                </span>
              </span>
            )
          }
        </div>

        <div class="mt-7 border-t border-brand-50/12 pt-4">
          <p class="figure text-xs text-brand-50/70">{d.footer.supportHours}</p>
          <p class="mt-1 text-xs text-brand-50/65">{d.footer.supportNote}</p>
        </div>
      </div>

      {
        columns.map((column) => (
          <div>
            <h2 class="label text-brand-50/60">{column.title}</h2>
            {/* Named, because a screen reader listing landmarks otherwise
                announces four anonymous "navigation" regions per page. */}
            <nav aria-label={column.title} class="mt-4 flex flex-col gap-2.5 text-sm text-brand-50/75">
              {column.links.map((link) => (
                <a href={link.href} class="w-fit hover:text-brand-50">
                  {link.label}
                </a>
              ))}
            </nav>
          </div>
        ))
      }
    </div>

    {/* The load-bearing disclosure. Not small print, not a link to small
        print — the sentence itself, at reading size, above the copyright. */}
    <div class="mt-14 border-t border-brand-50/12 pt-8">
      <h2 class="label text-brand-50/60">{d.footer.disclosures}</h2>
      <p class="mt-3 max-w-4xl text-sm leading-relaxed text-brand-50/65">
        {site.legalName} does not provide medical services and is not a pharmacy. All professional
        medical services are provided by clinicians licensed in your state and affiliated with{" "}
        {partners.practice}, an independent professional entity. All prescriptions are dispensed by
        independent, state-licensed pharmacies — {pharmacyNames}. Using this site does not create a
        clinician-patient relationship with {site.shortName}.
      </p>
      <p class="mt-3 max-w-4xl text-sm leading-relaxed text-brand-50/65">
        {d.compliance.emergency}
      </p>
    </div>

    <div
      class="mt-8 flex flex-col gap-3 border-t border-brand-50/12 pt-6 text-sm text-brand-50/60 sm:flex-row sm:items-center sm:justify-between"
    >
      {/* No literal period after legalName — it may already end in one. */}
      <span>© {year} {site.legalName} · {d.footer.rights}</span>
      <nav aria-label={d.footer.columns.legal} class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a href={localizedPath(locale, "/terms/")} class="hover:text-brand-50">
          {d.footer.terms}
        </a>
        <a href={localizedPath(locale, "/privacy/")} class="hover:text-brand-50">
          {d.footer.privacy}
        </a>
      </nav>
    </div>
  </div>
</footer>

<style>
  /* Inset to the frame, like the compliance band above it, so the two read as
     one plate. No bottom radius: the frame's own fixed corner fillets round
     the viewport's bottom corners over it, which is what makes the page look
     mounted rather than merely bordered. */
  .site-footer {
    margin-inline: var(--frame-w);
  }
  @media (max-width: 849px) {
    .site-footer {
      margin-inline: 0;
    }
  }
</style>
