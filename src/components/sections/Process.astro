---
import { type Locale, t } from "@/i18n";
import { Phone, Users, ClipboardCheck } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

// Thematic icon per step, indexed positionally (Kontaktaufnahme, Gespräch,
// Ergebnis) — a single row of 3, so plain divide-x/divide-y is unambiguous
// (no 2-column intermediate breakpoint to trip over, unlike Dienste's 2x2).
const icons = [Phone, Users, ClipboardCheck];
---

<section class="border-b border-border/60 bg-background py-14 sm:py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-3xl sm:text-4xl">{d.process.title}</h2>

    <div class="mt-10 grid divide-y divide-border sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {d.process.items.map((item, index) => {
        const Icon = icons[index];
        return (
          <div class="py-6 first:pt-0 last:pb-0 sm:px-8 sm:py-0 sm:first:pl-0 sm:last:pr-0">
            <div class="flex items-center gap-3">
              <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-brand-500/15 text-brand-700 dark:text-brand-400">
                <Icon className="size-4" />
              </span>
              <h3 class="subhead">{item.title}</h3>
            </div>
            <p class="mt-2.5 text-sm text-muted-foreground">{item.desc}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
