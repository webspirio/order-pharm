---
/**
 * The hero is the thesis.
 *
 * Every site in this category opens on the outcome — "Expert Care for a
 * Healthier, More Confident You". This one opens on the thing the reader is
 * actually anxious about and nobody addresses: the middle. The headline poses
 * it ("Nothing hidden in the middle.") and the Relay bar on the photo's lower
 * edge answers it in the same screen, which is why the two are one component
 * and not two sections.
 *
 * The scrim is a petrol sweep inside the brand ramp (brand-800 -> brand-700),
 * not the brand-to-amber duotone an earlier pass used: teal and warm brown
 * mix through olive, and the midpoint read as a printing error. Amber survives
 * as accent only — the Relay's ticks, the rule under a heading — which is
 * also what keeps it readable as this site's colour for "clock".
 */
import { type Locale, t, localizedPath } from "@/i18n";
import { Image } from "astro:assets";
import heroBg from "@/assets/hero.jpg";
import Relay from "@/components/sections/Relay.astro";
import { ArrowRight } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
---

<section class="relative isolate overflow-hidden border-b border-border/70">
  <div class="relative isolate flex min-h-[34rem] flex-col overflow-hidden lg:min-h-[40rem]">
    <Image
      src={heroBg}
      alt=""
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    {/* Stronger on the left, where the headline column sits, so the photo's
        own window highlight there cannot ride up under the type. Light mode
        stays lighter than dark mode's because the page around it is already
        pale; a text-shadow on the headline is the legibility backstop. */}
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-800/88 via-brand-800/62 to-brand-700/38 dark:from-brand-800/94 dark:via-brand-800/80 dark:to-brand-700/58"
    >
    </div>

    {/* flex-1 on this row rather than centring the outer box, so the headline
        centres in the space ABOVE the Relay bar. The bar is a normal flow
        sibling, not an absolute overlay, so the two can never collide on a
        short viewport however tall the copy gets. */}
    <div class="relative flex flex-1 items-center">
      <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
        <p class="label text-brand-300">{d.home.hero.kicker}</p>
        <h1
          class="hero-type display-1 mt-5 whitespace-pre-line text-brand-50"
        >
          {d.home.hero.title}
        </h1>
        <p class="hero-type mt-6 max-w-xl text-base text-brand-50/80 sm:text-lg">
          {d.home.hero.subtitle}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={localizedPath(locale, "/start/")} class="btn-solid-invert">
            {d.home.hero.ctaPrimary}
            <ArrowRight className="size-4" />
          </a>
          <a href={localizedPath(locale, "/pricing/")} class="btn-outline-invert">
            {d.home.hero.ctaSecondary}
          </a>
        </div>
        <p class="mt-5 max-w-md text-xs text-brand-50/60">{d.home.hero.note}</p>
      </div>
    </div>

    {/* The Relay, on the photo's own bottom edge as a translucent blurred bar
        rather than on a separate solid strip below it — the photo keeps
        showing through, and the four handoffs read as part of the same claim
        the headline makes. */}
    <div class="relative border-t border-brand-50/10 bg-brand-800/55 backdrop-blur-sm dark:bg-brand-800/75">
      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-9">
        <Relay locale={locale} variant="compact" />
      </div>
    </div>
  </div>
</section>

<style>
  /* With the scrim kept light enough for the photograph to read through, the
     image's bright spots can come close to the brand-50 type. A soft shadow
     buys a legibility margin without darkening the whole band. */
  .hero-type {
    text-shadow: 0 1px 18px color-mix(in oklab, var(--color-brand-800) 65%, transparent);
  }
</style>
