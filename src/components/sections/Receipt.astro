---
/**
 * THE RECEIPT — pricing as an itemised bill with a destination column.
 *
 * The category standard is one bundled price and an asterisk. Two of the three
 * reference sites publish a "no membership" marquee above a page that charges
 * a membership fee. Showing every line and who receives it is both the honest
 * form and the only way a fixed-administration-fee model reads as defensible
 * rather than as a hidden markup.
 *
 * Amounts come from `fees` and `shipping`; the dictionary supplies the line
 * name and the destination sentence. Nothing here is typed.
 *
 * THE CHASSIS is React Bits `comparison-5`, which is the only block in the
 * shortlist that keeps real table semantics instead of rendering a grid of
 * divs: a rounded panel wrapped AROUND the table, a tinted header row, an
 * `sr-only` caption, `<th scope="row">` on the line name, and a stacked-card
 * fallback below the breakpoint. Its emerald "savings" heat ramp is discarded
 * — green reads as approved in a medical context and a deepening tone is a
 * persuasion gradient. What is kept from it is the one honest idea in that
 * ramp: a cell that is NOT a figure looks different from one that is.
 *
 * THE ASIDE is React Bits `pricing-14`'s sticky summary panel — label/amount
 * pairs closed by a dashed rule and one oversized figure — with two
 * deliberate inversions. Its four `aria-pressed` add-on toggles summing to a
 * live "Your total" do not ship: an interactive configurator that returns a
 * number for a prescription-gated product is an implied offer of medication.
 * And where it closes on a total, this closes on the break-even — the number
 * of orders a year above which membership stops being a waste of money — with
 * no "Most popular" chip and no accent halo, because the panel's own heading
 * tells the reader not to buy it.
 */
import { type Locale, t, localizedPath } from "@/i18n";
import { anchors } from "@/config/site";
import { fees, membershipBreakEven, shipping, usd } from "@/config/pricing";
import SectionHead from "@/components/SectionHead.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const m = d.home.receipt.membership;

/**
 * Positionally matched to `d.home.receipt.rows` — the same pairing
 * `ArticlePage.astro` and `PricingPage.astro` make from the same constants.
 *
 * `numeric` is what the comparison-5 heat ramp is reduced to. Two of these
 * four "amounts" are deliberately words: the pharmacy sets one and the other
 * is zero, and writing "$0" for something included reads as a trick. A word
 * set in the figure face would quietly claim to be a number, so the words are
 * set in the reading face instead and the reader can see at a glance which
 * two lines Ellery does not control.
 */
const amounts: { text: string; numeric: boolean }[] = [
  { text: usd(fees.visit), numeric: true },
  { text: d.home.receipt.atCost, numeric: false },
  shipping.standardCost === 0
    ? { text: d.home.receipt.included, numeric: false }
    : { text: usd(shipping.standardCost), numeric: true },
  { text: usd(fees.admin), numeric: true },
];

/** `‡` compounding, `†` the administration fee. Both resolve in ComplianceBand. */
const symbols = ["", "‡", "", "†"];

const rows = d.home.receipt.rows.map((row, index) => ({
  ...row,
  amount: amounts[index],
  symbol: symbols[index],
}));

/** What membership costs, then what it removes. Every figure imported. */
const membershipCosts = [
  { label: m.monthly, amount: usd(fees.membershipMonthly) },
  { label: m.yearly, amount: usd(fees.membershipYearly) },
];
const membershipCovers = [
  { label: m.adminFee, amount: usd(fees.admin) },
  { label: m.overnight, amount: usd(shipping.overnightCost) },
];
---

<section id={anchors.pricing} class="bg-background section">
  <div class="shell">
    <SectionHead
      eyebrow={d.home.receipt.eyebrow}
      title={d.home.receipt.title}
      lead={d.home.receipt.lead}
      actionHref={localizedPath(locale, "/pricing/")}
      actionLabel={d.home.receipt.cta}
    />

    <div class="mt-12 grid gap-10 lg:mt-14 lg:grid-cols-[1fr_19rem] lg:gap-14">
      {/* The reveal is on this column and not on the grid, because the aside
          is `lg:sticky` and an ancestor mid-transform is a containing block. */}
      <div class="reveal">
        {/* md and up: the table. Three columns of which one is a full
            sentence, so the fallback breaks a step later than the two-column
            table in Roles.astro — at 640px this would be a 24-character
            destination column. */}
        <div class="panel hidden overflow-hidden md:block">
          <table class="w-full table-fixed border-collapse text-left">
            <caption class="sr-only">{d.home.receipt.header.caption}</caption>
            <thead>
              <tr class="border-b border-border bg-background">
                <th scope="col" class="label w-[36%] px-5 py-4 text-muted-foreground lg:px-7">
                  {d.home.receipt.header.item}
                </th>
                <th
                  scope="col"
                  class="label w-[15%] px-5 py-4 text-right text-muted-foreground lg:px-7"
                >
                  {d.home.receipt.header.amount}
                </th>
                <th scope="col" class="label px-5 py-4 text-muted-foreground lg:px-7">
                  {d.home.receipt.header.dest}
                </th>
              </tr>
            </thead>
            <tbody>
              {
                rows.map((row) => (
                  <tr class="border-b border-hairline align-top last:border-b-0">
                    <th scope="row" class="px-5 py-6 font-normal lg:px-7">
                      <span class="subhead">{row.item}</span>
                    </th>
                    <td
                      class:list={[
                        "px-5 py-6 text-right whitespace-nowrap lg:px-7",
                        row.amount.numeric
                          ? "figure text-base text-foreground"
                          : "text-[0.9375rem] text-muted-foreground",
                      ]}
                    >
                      {row.amount.text}
                      {row.symbol && (
                        <sup class="figure ml-0.5 text-xs text-muted-foreground">{row.symbol}</sup>
                      )}
                    </td>
                    <td class="px-5 py-6 text-sm leading-relaxed text-muted-foreground lg:px-7">
                      {row.dest}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        {/* Below md: one line per block, the destination beneath rather than
            beside it. Not a second table — a table whose third column is a
            forty-word sentence cannot survive 390px. */}
        <div class="panel overflow-hidden md:hidden">
          {
            rows.map((row) => (
              <div class="border-t border-border px-5 py-5 first:border-t-0">
                <div class="flex items-baseline justify-between gap-4">
                  <p class="subhead">{row.item}</p>
                  <p
                    class:list={[
                      "shrink-0 whitespace-nowrap",
                      row.amount.numeric
                        ? "figure text-base text-foreground"
                        : "text-[0.9375rem] text-muted-foreground",
                    ]}
                  >
                    {row.amount.text}
                    {row.symbol && (
                      <sup class="figure ml-0.5 text-xs text-muted-foreground">{row.symbol}</sup>
                    )}
                  </p>
                </div>
                <dl class="mt-3 border-t border-hairline pt-2.5">
                  <dt class="label text-muted-foreground">{d.home.receipt.header.dest}</dt>
                  <dd class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{row.dest}</dd>
                </dl>
              </div>
            ))
          }
        </div>

        {/* Every surface that shows a price carries the condition the price is
            subject to, in the words `common.ts` fixes so no section can invent
            a friendlier version. */}
        <p class="mt-8 max-w-2xl border-t border-border pt-5 text-sm leading-relaxed text-muted-foreground">
          {d.gating.long}
        </p>
      </div>

      <aside class="panel h-fit p-6 sm:p-7 lg:sticky lg:top-28">
        <p class="label text-muted-foreground">{d.home.receipt.optionalLabel}</p>
        <h3 class="subhead mt-3 text-lg">{m.title}</h3>

        <p class="label mt-7 text-muted-foreground">{m.costsLabel}</p>
        <dl class="mt-2">
          {
            membershipCosts.map((line) => (
              <div class="flex items-baseline justify-between gap-4 border-t border-hairline py-2.5">
                <dt class="text-sm text-muted-foreground">{line.label}</dt>
                <dd class="figure text-sm text-foreground">{line.amount}</dd>
              </div>
            ))
          }
        </dl>

        <p class="label mt-6 text-muted-foreground">{m.coversLabel}</p>
        <dl class="mt-2">
          {
            membershipCovers.map((line) => (
              <div class="flex items-baseline justify-between gap-4 border-t border-hairline py-2.5">
                <dt class="text-sm text-muted-foreground">{line.label}</dt>
                <dd class="figure text-sm text-foreground">{line.amount}</dd>
              </div>
            ))
          }
        </dl>

        {/* Dashed, because the figure below it is not an amount. It is a count
            of orders, and a solid rule in a column of dollars would read as a
            total. */}
        <div class="mt-6 border-t border-dashed border-border pt-5">
          <p class="label text-muted-foreground">{m.breakEvenLabel}</p>
          <p class="figure mt-2 text-[1.75rem] leading-none text-foreground">
            {`${membershipBreakEven.best}–${membershipBreakEven.worst}`}
          </p>
          <p class="mt-2 text-sm text-muted-foreground">{m.breakEvenUnit}</p>
        </div>

        <p class="mt-5 text-sm leading-relaxed text-muted-foreground">{m.body}</p>
      </aside>
    </div>
  </div>
</section>
