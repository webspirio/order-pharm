---
import { type Locale, t } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
---

<section class="border-b border-border/60 bg-background py-14 sm:py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-3xl sm:text-4xl">{d.ukraineFocus.title}</h2>
    {/* max-w-prose (65ch) — unconstrained, this lead ran the full 1104px of
        the max-w-6xl wrapper, about 138 characters per line, roughly double
        the 45–75 comfortable-measure range. */}
    <p class="mt-3 max-w-prose text-muted-foreground">{d.ukraineFocus.lead}</p>

    {/* Same borderless, line-divided treatment as the Hero tiles — one row
        split by hairlines instead of three boxed cards. */}
    <div class="mt-10 grid divide-y divide-border sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {d.ukraineFocus.items.map((item) => (
        <div class="py-6 first:pt-0 last:pb-0 sm:px-8 sm:py-0 sm:first:pl-0 sm:last:pr-0">
          <h3 class="subhead">{item.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
