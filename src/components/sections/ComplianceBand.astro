---
/**
 * Where every footnote symbol on the site resolves.
 *
 * The premium tell in this category is a symbol system that actually
 * resolves: Hims runs † for the medication caveat and * for trial data and
 * gives both a real citation; the cheap version is a bare asterisk that
 * resolves nowhere, which two of the three reference sites ship. So this band
 * exists on every page, carries every symbol used anywhere on the site, and
 * is designed rather than dumped — one of the reference sites drops the full
 * pharma safety text as a wall of unstyled paragraphs at the bottom of its
 * pricing page, which is legally sufficient and the last impression it leaves.
 *
 * On a fixed brand-800 band so it reads as a deliberate part of the page in
 * both themes rather than inverting with it.
 */
import { type Locale, t } from "@/i18n";
import { site } from "@/config/site";
import { TriangleAlert } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
---

<section class="bg-brand-800 text-brand-50">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
    <div class="grid gap-8 lg:grid-cols-[18rem_1fr] lg:gap-14">
      <div>
        <h2 class="display-3 text-brand-50">{d.compliance.title}</h2>
        <p class="mt-4 text-sm leading-relaxed text-brand-50/65">{d.compliance.lead}</p>

        <div class="panel-invert mt-6 flex gap-3 p-4">
          <TriangleAlert className="mt-0.5 size-4 shrink-0 text-glow-500" />
          <p class="text-sm leading-relaxed text-brand-50/80">{d.compliance.emergency}</p>
        </div>
      </div>

      {/* A definition list, not paragraphs: each symbol is the term and its
          note is the definition, which is exactly the semantics of a footnote
          key and gives a screen reader something better than "asterisk". */}
      <dl class="grid gap-x-10 gap-y-0 sm:grid-cols-2">
        {
          d.compliance.notes.map((note) => (
            <div class="border-t border-brand-50/12 py-4">
              <dt class="figure text-sm text-glow-500">{note.symbol}</dt>
              <dd class="mt-1.5 text-[0.8125rem] leading-relaxed text-brand-50/60">{note.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <p class="figure mt-10 border-t border-brand-50/12 pt-6 text-xs text-brand-50/60">
      {site.legalName} · {site.addressLocality}, {site.addressRegion}
    </p>
  </div>
</section>
