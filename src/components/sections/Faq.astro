---
import { type Locale, t } from "@/i18n";
import { anchors, site } from "@/config/site";
import { ChevronDown } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  // Reference the business declared by SeoHead instead of redeclaring it.
  about: { "@id": `${site.domain}/#business` },
  mainEntity: d.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<section id={anchors.faq} class="border-b border-border/60 bg-background py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-3xl sm:text-4xl">{d.faq.title}</h2>

    <div class="mt-10 grid gap-x-10 sm:grid-cols-2">
      {d.faq.items.map((item) => (
        <details class="group border-b border-border py-5">
          <summary
            class="flex cursor-pointer list-none items-center justify-between gap-4 marker:hidden"
          >
            {/* A heading here, not bare text, so screen-reader heading
                navigation (e.g. NVDA/JAWS "H" key) surfaces every question
                instead of skipping straight past them. */}
            <h3 class="subhead">{item.q}</h3>
            <ChevronDown
              className="size-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180"
            />
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
