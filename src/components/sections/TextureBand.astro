---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<section aria-hidden="true" class="relative isolate overflow-hidden border-b border-border/60">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <p class="text-center text-xs font-bold uppercase leading-relaxed tracking-[0.4em] text-muted-foreground">
      {label}
    </p>
  </div>
</section>
