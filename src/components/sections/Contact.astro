---
import { type Locale, t, localizedPath } from "@/i18n";
import { anchors, site } from "@/config/site";
import { Image } from "astro:assets";
import contactBg from "@/assets/contact-bg.jpg";
import { ArrowRight, HeartHandshake, Mail, MapPin, MessageCircle, Phone } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const kontaktHref = `${localizedPath(locale, "/kontakt/")}#form`;

/**
 * Seam: this template ships no form endpoint on purpose — the site is fully
 * static. To add one, see the "Adding a contact form" section of README.md.
 */
const channels = [
  site.phoneHref && {
    href: site.phoneHref,
    icon: Phone,
    label: d.contact.phone,
    value: site.phoneDisplay,
  },
  {
    href: site.mailHref,
    icon: Mail,
    label: d.contact.email,
    value: site.email,
  },
  site.messengerHref && {
    href: site.messengerHref,
    icon: MessageCircle,
    label: d.contact.messenger,
    value: site.phoneDisplay || site.name,
  },
  // Opens Google Maps in a new tab (site.mapHref), unlike the tel:/mailto:
  // links above — external is what flags that in the render below.
  site.addressStreet &&
    site.mapHref && {
      href: site.mapHref,
      icon: MapPin,
      label: d.contact.address,
      value: `${site.addressStreet}, ${site.addressPostal} ${site.addressLocality}`,
      external: true,
    },
].filter(Boolean) as {
  href: string;
  icon: typeof Mail;
  label: string;
  value: string;
  external?: boolean;
}[];
---

<section
  id={anchors.contact}
  class="relative isolate flex min-h-[22rem] items-center overflow-hidden py-10 sm:py-12 lg:min-h-[26rem]"
>
  {/* Themed full-bleed backdrop — a warm desk/books/pen still life (same
      family as Dienste's background photo, different crop), so the closing
      contact/Anfrageformular block reads as a deliberate "bookend" rather
      than trailing off on a plain background, echoing the Hero desk photo's
      warm tones. Same fixed brand-800 scrim family as Hero/PhoneCta/Footer:
      light 35–45% in light mode and a stronger 60–70% in dark mode,
      matching Hero's split — legible here because the panel below is
      itself translucent brand-800 too (see its own comment), not because
      the backdrop is dimmed enough on its own. Standard Unsplash License,
      no attribution required. */}
  <Image
    src={contactBg}
    alt=""
    widths={[640, 960, 1280, 1920]}
    sizes="100vw"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    loading="lazy"
  />
  <div class="absolute inset-0 -z-10 bg-brand-800/40 dark:bg-brand-800/65"></div>

  {/* One translucent glass panel (same brand-800/backdrop-blur treatment as
      the Hero tiles bar) instead of two separate near-opaque cards — the
      photo now shows through behind both halves, which are divided by a
      single hairline instead of living in their own boxes: divide-y while
      stacked on narrow screens, divide-x once they sit side by side. */}
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div
      class="grid divide-y divide-brand-50/15 rounded-2xl border border-brand-50/10 bg-brand-800/38 backdrop-blur-sm dark:bg-brand-800/65 lg:grid-cols-2 lg:divide-x lg:divide-y-0"
    >
    <div class="flex flex-col p-6 sm:p-8">
      {/* No "Kontakt" heading here — the page already says it in the nav,
          the footer column, and (once) the /kontakt/ page itself; this
          panel's own subtitle stands alone as the lead-in line. */}
      <p class="text-brand-50/70">{d.contact.subtitle}</p>

      {/* Category labels (Anrufen/E-Mail/Ehrenamt) dropped — same as the
          /kontakt/ page's own channel list — kept as aria-label on each
          link/row instead, so screen readers still get the context. */}
      <div class="mt-6 flex flex-col divide-y divide-brand-50/15">
        {channels.map((channel) => {
          const Icon = channel.icon;
          return (
            <a
              href={channel.href}
              aria-label={`${channel.label}: ${channel.value}`}
              class="flex items-center gap-3 py-3.5 first:pt-0 last:pb-0 hover:text-brand-50"
              {...(channel.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-brand-50/15 text-brand-50">
                <Icon className="size-4" />
              </span>
              <span class="font-medium text-brand-50">{channel.value}</span>
            </a>
          );
        })}
        {/* Not a channel (no href) — a trust signal alongside the contact
            methods rather than another way to reach her, so it's a <div>,
            not an <a>. "solidUArity e.V." is a proper noun (the internal
            "UA" capitalisation nods to Ukraine on purpose), so it keeps its
            own case rather than being run through an uppercase label
            style. */}
        <div class="flex items-center gap-3 py-3.5 last:pb-0">
          <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-brand-50/15 text-brand-50">
            <HeartHandshake className="size-4" />
          </span>
          <span class="font-medium text-brand-50">
            {d.contact.trust.org}
            <span class="font-normal text-brand-50/70"> · {d.contact.trust.role}</span>
          </span>
        </div>
      </div>

      <p class="mt-auto pt-6 text-sm text-brand-50/60">{d.contact.hours}</p>
    </div>

    <div class="flex flex-col items-center justify-center p-6 text-center sm:p-8">
      <p class="text-xs font-bold uppercase leading-relaxed tracking-[0.28em] text-brand-300">{d.contact.formCard.eyebrow}</p>
      <h3 class="mt-3 text-2xl text-brand-50 sm:text-3xl">{d.contact.formCard.title}</h3>
      <p class="mt-3 text-brand-50/70">{d.contact.formCard.body}</p>
      <a
        href={kontaktHref}
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3.5 font-semibold text-primary-foreground"
      >
        {d.contact.formCard.cta}
        <ArrowRight className="size-4" />
      </a>
    </div>
  </div>
  </div>
</section>
