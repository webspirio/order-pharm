---
import {
  type Locale,
  t,
  locales,
  localizedPath,
  unlocalizedPath,
  localeName,
  htmlLang,
  localeSegment,
} from "@/i18n";
import { site } from "@/config/site";
import Mark from "@/components/Mark.astro";
import ThemeToggle from "@/components/islands/ThemeToggle.tsx";
import LanguageSwitcher from "@/components/islands/LanguageSwitcher.tsx";
import PaletteSwitcher from "@/components/islands/PaletteSwitcher.tsx";
import MobileMenu from "@/components/islands/MobileMenu.tsx";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

const home = localizedPath(locale, "/");
const startPath = localizedPath(locale, "/start/");

const navLinks = [
  { label: d.nav.weightLoss, href: localizedPath(locale, "/weight-loss/") },
  { label: d.nav.longevity, href: localizedPath(locale, "/longevity/") },
  { label: d.nav.howItWorks, href: localizedPath(locale, "/how-it-works/") },
  { label: d.nav.pricing, href: localizedPath(locale, "/pricing/") },
  { label: d.nav.learn, href: localizedPath(locale, "/learn/") },
];

/** The mobile sheet has room for the whole map, so it carries two more. */
const mobileLinks = [
  ...navLinks,
  { label: d.nav.faq, href: localizedPath(locale, "/faq/") },
  { label: d.nav.contact, href: localizedPath(locale, "/contact/") },
];

// Recover this page's default-locale path so every language link stays on it,
// and so the current-page check below works regardless of locale prefix.
const currentPath = unlocalizedPath(Astro.url.pathname);
const langOptions = locales.map((l) => ({
  code: htmlLang[l],
  name: localeName[l],
  href: localizedPath(l, currentPath),
}));
const currentLabel = (localeSegment[locale] || htmlLang[locale]).toUpperCase();

// On /start/ itself, a CTA that re-links to /start/ is dead weight — swap it
// for the support number, which is the actual next thing a stuck visitor wants.
const onStart = currentPath === "/start/";
const ctaHref = onStart ? site.phoneHref : startPath;
const ctaLabel = onStart ? site.phoneDisplay : d.nav.cta;
---

<header
  class="sticky top-0 z-50 border-b border-border/70 bg-background/85 backdrop-blur supports-[backdrop-filter]:bg-background/70"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6">
    <a href={home} class="group flex shrink-0 items-center gap-2.5 leading-none">
      <Mark class="size-8 shrink-0 text-brand-600 dark:text-brand-400" />
      {/* Two-row lockup. The second row is a flex row of single characters
          inside justify-between: its own natural width is just the packed
          letters, so once the flex-col parent resolves to the wider row above
          and stretches this one to match, justify-between distributes the
          characters across exactly that width. The rows therefore start and
          end at the same x by construction, rather than via a tracking value
          eyeballed against one particular word. */}
      <span class="flex flex-col gap-[3px]">
        <span class="font-heading text-[1.4rem] leading-none tracking-tight text-foreground">
          {site.shortName}
        </span>
        <span class="label flex justify-between text-[0.5rem] text-brand-600 dark:text-brand-400">
          {"HEALTH".split("").map((char) => <span>{char}</span>)}
        </span>
      </span>
    </a>

    <nav
      aria-label={d.a11y.primaryNav}
      class="ml-auto hidden items-center lg:flex"
    >
      {
        navLinks.map((link) => {
          const active = currentPath === unlocalizedPath(link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "nav-link relative px-3 py-2 text-sm font-medium transition-colors",
                active ? "text-foreground" : "text-foreground/65 hover:text-foreground",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-4">
      {/* A "2H REVIEW" micro-label used to sit here. It said the same thing
          as the ticker two rows above it and read as clutter beside the CTA —
          the header's job is the map and one action. */}
      <a href={ctaHref} class="btn-solid hidden !py-2.5 !text-sm sm:inline-flex">{ctaLabel}</a>
      {
        locales.length > 1 && (
          <LanguageSwitcher
            client:load
            current={htmlLang[locale]}
            currentLabel={currentLabel}
            options={langOptions}
            label={d.a11y.langNav}
          />
        )
      }
      {/* `client:idle`, not `client:load`. Both header controls are
          nice-to-haves that a first-time visitor never touches, and
          `client:load` on either one pulls the React runtime into the critical
          path on all fourteen pages. Deferred, LCP is 235ms with CLS 0. */}
      <PaletteSwitcher client:idle label={d.palette.label} options={d.palette.options} />
      <ThemeToggle client:idle label={d.nav.toggleTheme} />
      <MobileMenu
        client:idle
        links={mobileLinks}
        primaryHref={startPath}
        primaryLabel={d.nav.cta}
        secondaryHref={site.phoneHref}
        secondaryLabel={site.phoneDisplay}
        menuLabel={d.a11y.openMenu}
        navLabel={d.a11y.primaryNav}
        sheetLabel={d.a11y.menu}
        closeLabel={d.a11y.close}
      />
    </div>
  </div>
</header>

<style>
  /* A hairline that grows from the left on hover, and stays put on the
     current page. The nav is the one place a little motion earns its keep;
     everything else on this site recolours and nothing moves. */
  .nav-link::after {
    content: "";
    position: absolute;
    right: 0.75rem;
    bottom: 0.35rem;
    left: 0.75rem;
    height: 1px;
    background: var(--color-glow-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }
</style>
