---
/**
 * THE FLOATING HEADER.
 *
 * Ported from the reference template: a fixed pill that sits exactly on the
 * site frame's top rail, in the frame colour, with its bottom corners swept
 * and two fillets growing sideways so it reads as cut from the same sheet as
 * the frame rather than laid on top of it.
 *
 * Width is `min(64rem, 100vw - 8rem)`. The 8rem of side room is what the two
 * 50px fillets need; without it they clip against the rails on mid-size
 * laptops, which is the one way this device visibly breaks.
 *
 * Below 850px the frame is hidden (a 10px rail is only a bezel on a phone), so
 * the header goes edge to edge and keeps only its bottom sweep.
 *
 * It is a plain Astro element, not an island: the nav is five links and the
 * only stateful controls are the three small islands on the right. The mount
 * animation is a CSS fade — deliberately NOT a transform that persists, since
 * a transformed ancestor becomes a containing block for `position: fixed`
 * descendants and would clip the mobile sheet.
 */
import {
  type Locale,
  t,
  locales,
  localizedPath,
  unlocalizedPath,
  localeName,
  htmlLang,
  localeSegment,
} from "@/i18n";
import { site } from "@/config/site";
import Mark from "@/components/Mark.astro";
import ThemeToggle from "@/components/islands/ThemeToggle.tsx";
import LanguageSwitcher from "@/components/islands/LanguageSwitcher.tsx";
import PaletteSwitcher from "@/components/islands/PaletteSwitcher.tsx";
import MobileMenu from "@/components/islands/MobileMenu.tsx";
import { ArrowDownRight } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

const home = localizedPath(locale, "/");
const startPath = localizedPath(locale, "/start/");

const navLinks = [
  { label: d.nav.weightLoss, href: localizedPath(locale, "/weight-loss/") },
  { label: d.nav.longevity, href: localizedPath(locale, "/longevity/") },
  { label: d.nav.howItWorks, href: localizedPath(locale, "/how-it-works/") },
  { label: d.nav.pricing, href: localizedPath(locale, "/pricing/") },
  { label: d.nav.learn, href: localizedPath(locale, "/learn/") },
];

/** The mobile sheet has room for the whole map, so it carries two more. */
const mobileLinks = [
  ...navLinks,
  { label: d.nav.faq, href: localizedPath(locale, "/faq/") },
  { label: d.nav.contact, href: localizedPath(locale, "/contact/") },
];

// Recover this page's default-locale path so every language link stays on it,
// and so the current-page check below works regardless of locale prefix.
const currentPath = unlocalizedPath(Astro.url.pathname);
const langOptions = locales.map((l) => ({
  code: htmlLang[l],
  name: localeName[l],
  href: localizedPath(l, currentPath),
}));
const currentLabel = (localeSegment[locale] || htmlLang[locale]).toUpperCase();

// On /start/ itself, a CTA that re-links to /start/ is dead weight — swap it
// for the support number, which is the actual next thing a stuck visitor
// wants. It also stops the page carrying two competing primary buttons.
const onStart = currentPath === "/start/";
---

<header class="site-header">
  <div class="flex h-18 items-center gap-3 px-5 sm:px-6">
    <a href={home} class="flex shrink-0 items-center gap-2.5 leading-none">
      <Mark class="size-7 shrink-0 text-signal-700 dark:text-signal-500" />
      {/* Two-row lockup. The second row is a flex row of single characters
          inside justify-between: its own natural width is just the packed
          letters, so once the flex-col parent resolves to the wider row above
          and stretches this one to match, justify-between distributes the
          characters across exactly that width. The rows therefore start and
          end at the same x by construction, rather than via a tracking value
          eyeballed against one particular word. */}
      <span class="flex flex-col gap-[3px]">
        <span class="text-[1.3rem] leading-none font-semibold tracking-[-0.04em] text-foreground">
          {site.shortName}
        </span>
        <span class="label flex justify-between text-[0.5rem] text-muted-foreground">
          {"HEALTH".split("").map((char) => <span>{char}</span>)}
        </span>
      </span>
    </a>

    <nav aria-label={d.a11y.primaryNav} class="mx-auto hidden items-center lg:flex">
      {
        navLinks.map((link) => {
          const active = currentPath === unlocalizedPath(link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "nav-link relative rounded-lg px-3 py-2 text-[0.9375rem] font-medium transition-colors",
                active ? "text-foreground" : "text-muted-foreground hover:text-foreground",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      {
        onStart ? (
          <a href={site.phoneHref} class="btn-outline hidden !py-2.5 !text-sm sm:inline-flex">
            {site.phoneDisplay}
          </a>
        ) : (
          <a href={startPath} class="btn-split hidden sm:inline-flex">
            <span class="btn-split-label !py-2.5 !text-sm">{d.nav.cta}</span>
            <span class="btn-split-tile !h-10 !w-10">
              <ArrowDownRight className="size-4" />
            </span>
          </a>
        )
      }
      {
        locales.length > 1 && (
          <LanguageSwitcher
            client:load
            current={htmlLang[locale]}
            currentLabel={currentLabel}
            options={langOptions}
            label={d.a11y.langNav}
          />
        )
      }
      {/* `client:idle`, not `client:load`. All three are nice-to-haves a
          first-time visitor never touches, and `client:load` on any of them
          pulls the React runtime into the critical path on all fourteen
          pages. */}
      <PaletteSwitcher client:idle label={d.palette.label} options={d.palette.options} />
      <ThemeToggle client:idle label={d.nav.toggleTheme} />
      <MobileMenu
        client:idle
        links={mobileLinks}
        primaryHref={startPath}
        primaryLabel={d.nav.cta}
        secondaryHref={site.phoneHref}
        secondaryLabel={site.phoneDisplay}
        menuLabel={d.a11y.openMenu}
        navLabel={d.a11y.primaryNav}
        sheetLabel={d.a11y.menu}
        closeLabel={d.a11y.close}
      />
    </div>
  </div>

  {/* The two fillets. They are the header's own corners inverted, so the
      frame's top rail appears to flow into the header's sides. Hidden with
      the frame below 850px. */}
  <svg
    class="header-fillet -left-[49px] rotate-180"
    width="50"
    height="50"
    viewBox="0 0 50 50"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M5.50871e-06 0C-0.00788227 37.3001 8.99616 50.0116 50 50H5.50871e-06V0Z"
      fill="currentColor"></path>
  </svg>
  <svg
    class="header-fillet -right-[49px] rotate-90"
    width="50"
    height="50"
    viewBox="0 0 50 50"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M5.50871e-06 0C-0.00788227 37.3001 8.99616 50.0116 50 50H5.50871e-06V0Z"
      fill="currentColor"></path>
  </svg>
</header>

<style>
  .site-header {
    position: fixed;
    top: var(--frame-w);
    right: 0;
    left: 0;
    z-index: 60;
    /* The 8rem of side room is exactly what the two 50px fillets need.
       Centred with `margin-inline: auto` rather than a translate: a transform
       on this element would make it a containing block for `position: fixed`
       descendants, which is the exact bug MobileMenu.tsx portals around. */
    width: min(64rem, calc(100vw - 8rem));
    margin-inline: auto;
    background: var(--frame);
    border-bottom-left-radius: var(--radius-slab);
    border-bottom-right-radius: var(--radius-slab);
    box-shadow: 0 18px 44px color-mix(in oklab, var(--foreground) 12%, transparent);
    animation: header-in 0.5s cubic-bezier(0.23, 1, 0.32, 1) both;
  }

  /* Opacity only. A translate would leave a transform on the ancestor, which
     makes it a containing block for `position: fixed` descendants — the exact
     bug MobileMenu.tsx portals around. */
  @keyframes header-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .header-fillet {
    position: absolute;
    top: 0;
    color: var(--frame);
    pointer-events: none;
  }

  @media (max-width: 849px) {
    .site-header {
      top: 0;
      width: 100%;
      border-bottom-left-radius: 1.75rem;
      border-bottom-right-radius: 1.75rem;
    }
    .header-fillet {
      display: none;
    }
  }

  /* A hairline that grows from the left on hover and stays put on the current
     page. The nav is the one place a little motion earns its keep. */
  .nav-link::after {
    content: "";
    position: absolute;
    right: 0.75rem;
    bottom: 0.4rem;
    left: 0.75rem;
    height: 1px;
    background: var(--color-signal-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      animation: none;
    }
    .nav-link::after {
      transition: none;
    }
  }
</style>
