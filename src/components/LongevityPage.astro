---
/**
 * /longevity/ — the peptide and cellular-support program.
 *
 * The page is built around one structural decision. Every preparation here is
 * compounded, prescribed at an independent clinician's discretion, and not
 * FDA-approved for any specific indication, so there is no outcome to sell and
 * the only credible differentiator left is how honestly the evidence is
 * described. Each preparation therefore gets three prose fields rather than
 * one — what it is, what it is studied for, and where the evidence stops — and
 * the third is the only one set in full-strength ink, on a brand rule, so it
 * reads as the point of the panel rather than as a caveat attached to it.
 *
 * The dark band in the middle is the page's boldest claim and it is a
 * negative one: the sentences this category writes and this page refuses to,
 * each with the specific defect that disqualifies it. It uses the same
 * two-column table form as `Roles.astro` on the homepage, because it is the
 * same kind of content — a claim paired with exactly one owner or reason.
 *
 * Every figure — prices, the count of preparations, the sermorelin age floor,
 * and the count of approved indications (derived, not typed: none of the four
 * is anything but compounded) — comes from `src/config/pricing.ts`.
 */
import { type Locale, t, localizedPath } from "@/i18n";
import { Image } from "astro:assets";
import longevityHero from "@/assets/longevity-hero.jpg";
import {
  treatmentsIn,
  monthlyEquivalent,
  eligibility,
  usd,
  usdMonthly,
} from "@/config/pricing";
import Layout from "@/layouts/Layout.astro";
import SeoHead from "@/components/SeoHead.astro";
import TrustTicker from "@/components/sections/TrustTicker.astro";
import Header from "@/components/sections/Header.astro";
import Relay from "@/components/sections/Relay.astro";
import Faq from "@/components/sections/Faq.astro";
import Cta from "@/components/sections/Cta.astro";
import ComplianceBand from "@/components/sections/ComplianceBand.astro";
import Footer from "@/components/sections/Footer.astro";
import { ArrowRight } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const c = d.longevity;

const items = treatmentsIn("longevity");

/**
 * The three prose fields, keyed by treatment id, so a preparation cannot be
 * priced in `pricing.ts` without being described here.
 */
const prose = c.treatments.items as Record<
  string,
  { what: string; studiedFor: string; limits: string }
>;

const cards = items.map((tx, index) => ({
  ...tx,
  index: index + 1,
  copy: prose[tx.id],
  prices: [
    { label: c.treatments.labels.oneMonth, value: usd(tx.oneMonth) },
    { label: c.treatments.labels.threeMonth, value: usd(tx.threeMonth) },
    { label: c.treatments.labels.monthlyEquivalent, value: usdMonthly(monthlyEquivalent(tx)) },
  ],
}));

/**
 * Header figures. The fourth is derived rather than written: every treatment
 * in this program is a compounded preparation, so the number of them with an
 * approved indication is the number that are not compounded.
 */
const headerFigures = c.header.figures.map((figure, index) => ({
  ...figure,
  value: [
    String(items.length),
    usdMonthly(Math.min(...items.map((tx) => tx.fromMonthly))),
    String(eligibility.minAgeSermorelin),
    String(items.filter((tx) => !tx.compounded).length),
  ][index],
}));
---

<Layout
  locale={locale}
  title={d.meta.longevity.title}
  description={d.meta.longevity.description}
>
  <SeoHead slot="head" locale={locale} path="/longevity/" />
  <TrustTicker locale={locale} />
  <Header locale={locale} />

  <main id="main" tabindex="-1" class="outline-none">
    {/* 1 — the header block. The H1 promises nothing; it states the rule the
        rest of the page follows. */}
    <section class="bg-background pb-14 pt-14 sm:pb-16 sm:pt-16">
      <div class="shell">
        <p class="label text-brand-700 dark:text-brand-400">{c.header.eyebrow}</p>
        {/* The break in the title is a rhetorical one — two clauses, one per
            line — and it only helps where there is room for it. Below `sm` the
            headline reflows normally rather than orphaning "stops," on a line
            of its own. */}
        <h1 class="display-1 mt-5 max-w-4xl sm:whitespace-pre-line">{c.header.title}</h1>
        <p class="lead mt-6 text-lg">{c.header.lead}</p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={localizedPath(locale, "/start/")} class="btn-solid">
            {d.cta.primary}
            <ArrowRight className="size-4" />
          </a>
          <a href={localizedPath(locale, "/pricing/")} class="btn-outline">{d.cta.secondary}</a>
        </div>

        <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4 sm:gap-x-8">
          {
            headerFigures.map((figure) => (
              <div class="border-t border-border pt-4">
                <dd class="figure text-2xl text-foreground sm:text-[1.75rem]">{figure.value}</dd>
                <dt class="mt-2">
                  <span class="subhead block text-[0.9375rem]">{figure.label}</span>
                  <span class="mt-1 block text-sm text-muted-foreground">{figure.note}</span>
                </dt>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    {/* The wide photographic band, with the disclosure as its caption rather
        than as small print somewhere below. The aspirational picture and the
        sentence that limits it belong on the same surface. */}
    <section class="relative isolate">
      <div class="relative aspect-[4/3] w-full overflow-hidden sm:aspect-[21/9]">
        <Image
          src={longevityHero}
          alt={c.header.imageAlt}
          widths={[640, 960, 1440, 2000]}
          sizes="100vw"
          class="h-full w-full object-cover object-[50%_32%]"
          loading="lazy"
        />
        {/* The scrim only has to carry one line of mono at the bottom edge, so
            it is a short, steep ramp rather than a wash over the whole photo. */}
        <div
          class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-brand-800/95 via-brand-800/72 to-transparent pt-20"
        >
          <div class="shell pb-6">
            <p class="figure max-w-2xl text-xs leading-relaxed text-brand-50/85 sm:text-[0.8125rem]">
              {c.header.imageNote}
              <sup class="ml-0.5 text-signal-500">‡¶</sup>
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* 2 — the four preparations. */}
    <section class="bg-card section">
      <div class="shell">
        <div class="max-w-3xl">
          <p class="label text-brand-700 dark:text-brand-400">{c.treatments.eyebrow}</p>
          <h2 class="display-2 mt-4">{c.treatments.title}</h2>
          <p class="lead mt-4">{c.treatments.lead}</p>
        </div>

        <div class="mt-12 flex flex-col gap-6">
          {
            cards.map((card) => (
              <article class="panel bg-background p-6 sm:p-8">
                <div class="grid gap-8 lg:grid-cols-[1fr_17rem] lg:gap-12">
                  <div>
                    <div class="flex items-baseline gap-3">
                      <span class="figure shrink-0 text-xs text-brand-700 dark:text-brand-400">
                        {String(card.index).padStart(2, "0")}
                      </span>
                      <h3 class="display-3">
                        {card.display}
                        <sup class="figure ml-0.5 text-[0.45em] text-muted-foreground">
                          ‡¶
                        </sup>
                      </h3>
                    </div>

                    {/* Grouped in `div`s: HTML5 allows a `dl` of dt/dd pairs
                        or a `dl` of div groups, not a mixture of the two, and
                        the third field needs a wrapper to carry its rule. */}
                    <dl class="mt-6">
                      <div>
                        <dt class="label text-muted-foreground">{c.treatments.labels.what}</dt>
                        <dd class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-muted-foreground">
                          {card.copy.what}
                        </dd>
                      </div>

                      <div class="mt-5">
                        <dt class="label text-muted-foreground">
                          {c.treatments.labels.studiedFor}
                        </dt>
                        <dd class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-muted-foreground">
                          {card.copy.studiedFor}
                        </dd>
                      </div>

                      {/* The field the rest of the category omits. It is the
                          only one in full-strength ink, and the only one on a
                          rule, because it is the reason the panel exists. */}
                      <div class="mt-6 border-l-2 border-brand-600 pl-4 dark:border-brand-400 sm:pl-5">
                        <dt class="label text-brand-700 dark:text-brand-400">
                          {c.treatments.labels.limits}
                        </dt>
                        <dd class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-foreground">
                          {card.copy.limits}
                        </dd>
                      </div>
                    </dl>
                  </div>

                  <aside class="lg:border-l lg:border-border lg:pl-8">
                    <dl class="flex flex-col">
                      <div class="border-t border-border py-3">
                        <dt class="label text-muted-foreground">
                          {c.treatments.labels.molecule}
                        </dt>
                        <dd class="mt-1.5 text-sm leading-relaxed">{card.molecule}</dd>
                      </div>
                      <div class="border-t border-border py-3">
                        <dt class="label text-muted-foreground">{c.treatments.labels.form}</dt>
                        <dd class="mt-1.5 text-sm leading-relaxed">{card.form}</dd>
                      </div>
                      <div class="border-t border-border py-3">
                        <dt class="label text-muted-foreground">{c.treatments.labels.cadence}</dt>
                        <dd class="mt-1.5 text-sm leading-relaxed">{card.cadence}</dd>
                      </div>
                    </dl>

                    <table class="mt-4 w-full border-collapse text-left">
                      <tbody>
                        {card.prices.map((price) => (
                          <tr class="border-t border-border">
                            <th scope="row" class="label py-3 pr-3 font-semibold text-muted-foreground">
                              {price.label}
                            </th>
                            <td class="figure py-3 text-right text-base whitespace-nowrap">
                              {price.value}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>

                    <p class="mt-3 border-t border-border pt-3 text-xs leading-relaxed text-muted-foreground">
                      {d.gating.short}
                    </p>
                  </aside>
                </div>
              </article>
            ))
          }
        </div>

        <div class="mt-8 grid max-w-5xl gap-6 sm:grid-cols-2 sm:gap-10">
          <p class="text-[0.9375rem] leading-relaxed text-foreground">{c.treatments.note}</p>
          <p class="text-sm leading-relaxed text-muted-foreground">{d.gating.long}</p>
        </div>
      </div>
    </section>

    {/* 3 — the dark band: the claims this page refuses to make. */}
    <section class="border-b border-brand-50/10 bg-brand-800 py-16 text-brand-50 sm:py-20">
      <div class="shell">
        <div class="max-w-3xl">
          <p class="label text-brand-300">{c.refuse.eyebrow}</p>
          <h2 class="display-2 mt-4 text-brand-50">{c.refuse.title}</h2>
          <p class="mt-4 max-w-2xl text-[1.0625rem] leading-relaxed text-brand-50/65">
            {c.refuse.lead}
          </p>
        </div>

        {/* sm and up: the table. */}
        <div class="mt-10 hidden sm:block">
          <table class="w-full border-collapse text-left">
            <thead>
              <tr class="border-y border-brand-50/15">
                <th scope="col" class="label w-[38%] py-3 pr-6 text-brand-50/60">
                  {c.refuse.header.claim}
                </th>
                <th scope="col" class="label py-3 text-brand-50/60">{c.refuse.header.why}</th>
              </tr>
            </thead>
            <tbody>
              {
                c.refuse.rows.map((row) => (
                  <tr class="border-b border-brand-50/12 align-top">
                    <th scope="row" class="py-5 pr-6 font-normal">
                      <span class="subhead inline text-brand-50">{row.claim}</span>
                    </th>
                    <td class="py-5 text-[0.9375rem] leading-relaxed text-brand-50/60">
                      {row.why}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        {/* Below sm: the same pairs as a definition list. */}
        <dl class="mt-10 flex flex-col sm:hidden">
          {
            c.refuse.rows.map((row) => (
              <div class="border-t border-brand-50/12 py-5">
                <dt class="subhead text-brand-50">{row.claim}</dt>
                <dd class="mt-2 text-sm leading-relaxed text-brand-50/60">{row.why}</dd>
              </div>
            ))
          }
        </dl>

        <p
          class="mt-10 max-w-3xl border-t border-brand-50/12 pt-7 text-[1.0625rem] leading-relaxed text-brand-50/80"
        >
          {c.refuse.concede}
        </p>
      </div>
    </section>

    {/* 4 — gating, interactions, and what self-injection actually involves. */}
    <section class="bg-background section">
      <div class="shell">
        <div class="max-w-3xl">
          <p class="label text-brand-700 dark:text-brand-400">{c.gating.eyebrow}</p>
          <h2 class="display-2 mt-4">{c.gating.title}</h2>
          <p class="lead mt-4">{c.gating.lead}</p>
        </div>

        <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_20rem] lg:gap-14">
          <div>
            <h3 class="label text-muted-foreground">{c.gating.rulesTitle}</h3>
            <dl class="mt-4 flex flex-col">
              {
                c.gating.rules.map((rule) => (
                  <div class="border-t border-border py-5">
                    <dt class="subhead">{rule.rule}</dt>
                    <dd class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-muted-foreground">
                      {rule.why}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <aside class="panel h-fit p-6 lg:sticky lg:top-24">
            <p class="label text-muted-foreground">{c.gating.ageGate.label}</p>
            <p class="figure mt-3 text-4xl text-foreground">{eligibility.minAgeSermorelin}</p>
            <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
              {c.gating.ageGate.body}
            </p>
          </aside>
        </div>

        <div class="panel mt-10 max-w-4xl p-6 sm:p-7">
          <h3 class="subhead text-lg">{c.gating.interactions.title}</h3>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted-foreground">
            {c.gating.interactions.body}
          </p>
        </div>

        <div class="mt-14">
          <h3 class="display-3">{c.gating.injection.title}</h3>
          <p class="lead mt-3">{c.gating.injection.lead}</p>

          <ol class="mt-8 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
            {
              c.gating.injection.steps.map((step, index) => (
                <li class="border-t border-border pt-4">
                  <p class="figure text-xs text-signal-700 dark:text-signal-500">
                    {String(index + 1).padStart(2, "0")}
                  </p>
                  <h4 class="subhead mt-2">{step.label}</h4>
                  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{step.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    {/* 5 — the chain, framed for this program. */}
    <section class="bg-card section">
      <div class="shell">
        <div class="max-w-3xl">
          <p class="label text-brand-700 dark:text-brand-400">{c.relay.eyebrow}</p>
          <h2 class="display-2 mt-4">{c.relay.title}</h2>
          <p class="lead mt-4">{c.relay.lead}</p>
        </div>

        <div class="mt-11">
          <Relay locale={locale} variant="full" onLight />
        </div>

        <a
          href={localizedPath(locale, "/how-it-works/")}
          class="mt-9 inline-flex items-center gap-2 text-sm font-semibold text-brand-700 dark:text-brand-400"
        >
          {c.relay.cta}
          <ArrowRight className="size-4" />
        </a>
      </div>
    </section>

    {/* 6 — FAQ. The full set, and its FAQPage markup, lives on /faq/. */}
    <Faq
      locale={locale}
      eyebrow={c.faq.eyebrow}
      title={c.faq.title}
      items={c.faq.items}
      jsonLd={false}
      ctaHref={localizedPath(locale, "/faq/")}
      ctaLabel={c.faq.cta}
    />

    <Cta locale={locale} />
    <ComplianceBand locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
