---
/**
 * /longevity/ — the peptide and cellular-support program.
 *
 * The page is built around one structural decision. Every preparation here is
 * compounded, prescribed at an independent clinician's discretion, and not
 * FDA-approved for any specific indication, so there is no outcome to sell and
 * the only credible differentiator left is how honestly the evidence is
 * described. Each preparation therefore gets three prose fields rather than
 * one — what it is, what it is studied for, and where the evidence stops — and
 * the third is the only one set in full-strength ink, on a brand rule, so it
 * reads as the point of the panel rather than as a caveat attached to it.
 *
 * The dark band in the middle is the page's boldest claim and it is a
 * negative one: the sentences this category writes and this page refuses to,
 * each with the specific defect that disqualifies it. It uses the same
 * two-column table form as `Roles.astro` on the homepage, because it is the
 * same kind of content — a claim paired with exactly one owner or reason.
 *
 * WHAT THE REBUILD CHANGED, and why:
 *
 * - The four header figures are hero-20's editorial metric strip — rules
 *   above and below, hairline dividers between — and the same device carries
 *   the four self-injection steps further down. One repeated instrument reads
 *   as a system; two grids of bordered cards read as two lists.
 * - The photograph is framed rather than full-bleed, and its disclosure sits
 *   on the frame instead of inside a gradient scrim over the image. The scrim
 *   was the third gradient on a site that allows two, and — worse — it set the
 *   one sentence that limits the picture over the picture it limits.
 * - Each preparation card is now two surfaces in one card, features-12's
 *   idea: the prose on the raised ground, the spec sheet and the prices
 *   recessed beside it. The split is real information — the left half is
 *   argued, the right half is measured.
 * - The refuse band is `slab on-slab`, the page's ONE dark band, and its
 *   table sits in the inverted panel chassis rather than floating on the slab.
 *
 * Every figure — prices, the count of preparations, the sermorelin age floor,
 * and the count of approved indications (derived, not typed: none of the four
 * is anything but compounded) — comes from `src/config/pricing.ts`.
 */
import { type Locale, t, localizedPath } from "@/i18n";
import { Image } from "astro:assets";
import longevityHero from "@/assets/longevity-hero.jpg";
import { treatmentsIn, monthlyEquivalent, eligibility, usd, usdMonthly } from "@/config/pricing";
import Layout from "@/layouts/Layout.astro";
import SeoHead from "@/components/SeoHead.astro";
import TrustTicker from "@/components/sections/TrustTicker.astro";
import Header from "@/components/sections/Header.astro";
import Headline from "@/components/Headline.astro";
import SectionHead from "@/components/SectionHead.astro";
import Relay from "@/components/sections/Relay.astro";
import Faq from "@/components/sections/Faq.astro";
import Cta from "@/components/sections/Cta.astro";
import ComplianceBand from "@/components/sections/ComplianceBand.astro";
import Footer from "@/components/sections/Footer.astro";
import { ArrowRight } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const c = d.longevity;

const items = treatmentsIn("longevity");

/**
 * The three prose fields, keyed by treatment id, so a preparation cannot be
 * priced in `pricing.ts` without being described here.
 */
const prose = c.treatments.items as Record<
  string,
  { what: string; studiedFor: string; limits: string }
>;

const cards = items.map((tx, index) => ({
  ...tx,
  index: index + 1,
  copy: prose[tx.id],
  /* The caption names the preparation so four adjacent two-column price
     grids are distinguishable to a screen reader. The name is data, so it
     is substituted rather than written into the dictionary. */
  priceCaption: c.treatments.priceCaption.replace("{preparation}", tx.display),
  prices: [
    { label: c.treatments.labels.oneMonth, value: usd(tx.oneMonth) },
    { label: c.treatments.labels.threeMonth, value: usd(tx.threeMonth) },
    { label: c.treatments.labels.monthlyEquivalent, value: usdMonthly(monthlyEquivalent(tx)) },
  ],
}));

/**
 * Header figures. The fourth is derived rather than written: every treatment
 * in this program is a compounded preparation, so the number of them with an
 * approved indication is the number that are not compounded.
 */
const headerFigures = c.header.figures.map((figure, index) => ({
  ...figure,
  value: [
    String(items.length),
    usdMonthly(Math.min(...items.map((tx) => tx.fromMonthly))),
    String(eligibility.minAgeSermorelin),
    String(items.filter((tx) => !tx.compounded).length),
  ][index],
}));
---

<Layout locale={locale} title={d.meta.longevity.title} description={d.meta.longevity.description}>
  <SeoHead slot="head" locale={locale} path="/longevity/" />
  <Header locale={locale} />

  <main id="main" tabindex="-1" class="outline-none">
    {/* ---------------------------------------------------------------
        1 — the head block. The h1 promises nothing; it states the rule the
        rest of the page follows, and carries the page's single Fraunces
        word on the verb it is named after.
        --------------------------------------------------------------- */}
    <section class="page-top pb-16 sm:pb-20">
      <div class="shell">
        <p class="label text-signal-700 dark:text-signal-500">{c.header.eyebrow}</p>

        <Headline
          as="h1"
          reveal
          text={c.header.title}
          accent={c.header.titleAccent}
          class="display-1 hl-break-sm mt-5 max-w-4xl"
        />

        <p class="lead mt-6 text-lg">{c.header.lead}</p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          {/* The page's one `.btn-split`. The header pill carries the other,
              which is the whole two-per-page budget. */}
          <a href={localizedPath(locale, "/start/")} class="btn-split">
            <span class="btn-split-label">{d.cta.primary}</span>
            <span class="btn-split-tile"><ArrowRight className="size-5" /></span>
          </a>
          <a href={localizedPath(locale, "/pricing/")} class="btn-outline">{d.cta.secondary}</a>
        </div>

        {/* The strip below quotes a price, so the condition every price on
            this site is subject to is stated beside it rather than left to
            the footnote band. */}
        <p class="mt-7 max-w-2xl text-sm text-muted-foreground">
          {d.gating.short}<sup class="figure ml-0.5">*</sup>
        </p>

        {/* THE METRIC STRIP — hero-20's editorial device, and the page's
            repeated instrument (the self-injection steps use it again). Each
            cell is a `dt`/`dd` pair in DOM order, which is the only order the
            HTML spec allows inside a `dl > div`; `flex-col-reverse` puts the
            figure on top, where the eye wants it. */}
        <h2 class="label mt-14 text-muted-foreground" id="lv-figures">
          {c.header.figuresLabel}
        </h2>
        <dl
          aria-labelledby="lv-figures"
          class="mt-5 grid grid-cols-2 gap-x-6 gap-y-8 border-y border-border py-8 sm:grid-cols-4 sm:gap-x-0 sm:gap-y-0 sm:divide-x sm:divide-border"
        >
          {
            headerFigures.map((figure) => (
              <div class="flex flex-col-reverse justify-end gap-2 sm:px-6 sm:first:pl-0 sm:last:pr-0">
                <dt>
                  <span class="subhead block text-[0.9375rem]">{figure.label}</span>
                  <span class="mt-1 block text-sm text-muted-foreground">{figure.note}</span>
                </dt>
                <dd class="figure text-2xl text-foreground sm:text-[1.75rem]">{figure.value}</dd>
              </div>
            ))
          }
        </dl>

        {/* FRAMED MEDIA. The card's padding is visible frame and the inner
            radius steps down by exactly the inset, so the two curves stay
            concentric — the value is derived from `--radius-card` rather than
            being a new radius. The disclosure is the frame's caption: an
            aspirational photograph and the sentence that limits it belong on
            the same surface, and a sentence set over a photograph is a
            sentence you have chosen to make hard to read. */}
        <figure class="panel mt-12 bg-card p-2">
          <div
            class="aspect-[4/3] overflow-hidden rounded-[calc(var(--radius-card)-0.5rem)] sm:aspect-[21/9]"
          >
            <Image
              src={longevityHero}
              alt={c.header.imageAlt}
              widths={[640, 960, 1440, 2000]}
              sizes="(min-width: 1152px) 66rem, 100vw"
              class="h-full w-full object-cover object-[50%_32%]"
              loading="lazy"
            />
          </div>
          <figcaption class="figure px-3 pt-4 pb-2 text-xs leading-relaxed text-muted-foreground">
            {c.header.imageNote}<sup class="figure ml-0.5 text-signal-700 dark:text-signal-500">‡¶</sup>
          </figcaption>
        </figure>
      </div>
    </section>

    {/* The ticker closes the head block, the same slot it takes under the
        hero on the homepage. It cannot sit above the nav any more: the
        header floats. */}
    <TrustTicker locale={locale} />

    {/* ---------------------------------------------------------------
        2 — the four preparations. Two surfaces per card: the argued half
        on the raised ground, the measured half recessed beside it. The
        recessed column runs to the card's own edge rather than floating
        inside its padding, which is what makes the split read as one card
        with two materials instead of a card containing a box.
        --------------------------------------------------------------- */}
    <section class="bg-card section">
      <div class="shell">
        <SectionHead
          eyebrow={c.treatments.eyebrow}
          title={c.treatments.title}
          lead={c.treatments.lead}
        />

        <div class="reveal mt-12 flex flex-col gap-6">
          {
            cards.map((card) => (
              <article class="panel overflow-hidden bg-background">
                <div class="grid lg:grid-cols-[1fr_19rem]">
                  <div class="p-6 sm:p-8">
                    <div class="flex items-baseline gap-3">
                      <span class="figure shrink-0 text-xs text-signal-700 dark:text-signal-500">
                        {String(card.index).padStart(2, "0")}
                      </span>
                      <h3 class="display-3">
                        {card.display}
                        <sup class="figure ml-0.5 text-[0.45em] text-muted-foreground">‡¶</sup>
                      </h3>
                    </div>

                    {/* Grouped in `div`s: HTML5 allows a `dl` of dt/dd pairs
                        or a `dl` of div groups, not a mixture of the two, and
                        the third field needs a wrapper to carry its rule. */}
                    <dl class="mt-7">
                      <div>
                        <dt class="label text-muted-foreground">{c.treatments.labels.what}</dt>
                        <dd class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-muted-foreground">
                          {card.copy.what}
                        </dd>
                      </div>

                      <div class="mt-5">
                        <dt class="label text-muted-foreground">
                          {c.treatments.labels.studiedFor}
                        </dt>
                        <dd class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-muted-foreground">
                          {card.copy.studiedFor}
                        </dd>
                      </div>

                      {/* The field the rest of the category omits. It is the
                          only one in full-strength ink, and the only one on a
                          rule, because it is the reason the panel exists. The
                          rule is the signal colour: this is the sentence the
                          page is spending its credibility on. */}
                      <div class="mt-7 border-l-2 border-signal-500 pl-4 sm:pl-5">
                        <dt class="label text-signal-700 dark:text-signal-500">
                          {c.treatments.labels.limits}
                        </dt>
                        <dd class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-foreground">
                          {card.copy.limits}
                        </dd>
                      </div>
                    </dl>
                  </div>

                  <aside class="border-t border-border bg-muted p-6 sm:p-8 lg:border-t-0 lg:border-l">
                    <dl class="flex flex-col divide-y divide-hairline border-y border-hairline">
                      <div class="py-3">
                        <dt class="label text-muted-foreground">
                          {c.treatments.labels.molecule}
                        </dt>
                        <dd class="mt-1.5 text-sm leading-relaxed">{card.molecule}</dd>
                      </div>
                      <div class="py-3">
                        <dt class="label text-muted-foreground">{c.treatments.labels.form}</dt>
                        <dd class="mt-1.5 text-sm leading-relaxed">{card.form}</dd>
                      </div>
                      <div class="py-3">
                        <dt class="label text-muted-foreground">{c.treatments.labels.cadence}</dt>
                        <dd class="mt-1.5 text-sm leading-relaxed">{card.cadence}</dd>
                      </div>
                    </dl>

                    <table class="mt-5 w-full border-collapse text-left">
                      <caption class="sr-only">{card.priceCaption}</caption>
                      <tbody>
                        {card.prices.map((price) => (
                          <tr class="border-t border-hairline">
                            <th
                              scope="row"
                              class="label py-3 pr-3 font-semibold text-muted-foreground"
                            >
                              {price.label}
                            </th>
                            <td class="figure py-3 text-right text-base whitespace-nowrap">
                              {price.value}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>

                    <p class="mt-4 border-t border-hairline pt-4 text-xs leading-relaxed text-muted-foreground">
                      {d.gating.short}
                    </p>
                  </aside>
                </div>
              </article>
            ))
          }
        </div>

        <div class="reveal mt-10 grid gap-6 border-t border-border pt-8 sm:grid-cols-2 sm:gap-10">
          <p class="text-[0.9375rem] leading-relaxed text-foreground">{c.treatments.note}</p>
          <p class="text-sm leading-relaxed text-muted-foreground">{d.gating.long}</p>
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------------------
        3 — the page's ONE dark band: the claims this page refuses to make.
        Two columns, no marks, no third state — it is an assignment of a
        defect to a sentence, not a comparison against anyone.
        --------------------------------------------------------------- */}
    <section class="slab on-slab section">
      <div class="shell">
        <SectionHead on="slab" eyebrow={c.refuse.eyebrow} title={c.refuse.title} lead={c.refuse.lead} />

        {/* sm and up: the table, in the inverted panel chassis. */}
        <div class="panel-invert reveal mt-12 hidden overflow-hidden sm:block">
          <table class="w-full border-collapse text-left">
            <caption class="sr-only">{c.refuse.caption}</caption>
            <thead>
              <tr class="border-b border-brand-50/15">
                <th scope="col" class="label w-[38%] px-6 py-4 text-brand-50/70">
                  {c.refuse.header.claim}
                </th>
                <th scope="col" class="label px-6 py-4 text-brand-50/70">{c.refuse.header.why}</th>
              </tr>
            </thead>
            <tbody>
              {
                c.refuse.rows.map((row) => (
                  <tr class="border-b border-brand-50/12 align-top last:border-b-0">
                    <th scope="row" class="px-6 py-6 font-normal">
                      <span class="subhead inline text-brand-50">{row.claim}</span>
                    </th>
                    <td class="px-6 py-6 text-[0.9375rem] leading-relaxed text-brand-50/70">
                      {row.why}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        {/* Below sm: the same pairs as a definition list. */}
        <dl class="reveal mt-12 flex flex-col divide-y divide-brand-50/12 border-y border-brand-50/12 sm:hidden">
          {
            c.refuse.rows.map((row) => (
              <div class="py-5">
                <dt class="subhead text-brand-50">{row.claim}</dt>
                <dd class="mt-2 text-sm leading-relaxed text-brand-50/70">{row.why}</dd>
              </div>
            ))
          }
        </dl>

        {/* The concession, at full strength. It is the loudest sentence on the
            page and it argues against the page. */}
        <p
          class="reveal mt-12 max-w-3xl border-t border-brand-50/12 pt-8 text-[1.0625rem] leading-relaxed text-brand-50"
        >
          {c.refuse.concede}
        </p>
      </div>
    </section>

    {/* ---------------------------------------------------------------
        4 — gating, interactions, and what self-injection actually
        involves. The age floor sticks beside the rules it belongs to:
        the reference template's sticky column, used where the left
        column genuinely outruns the right.
        --------------------------------------------------------------- */}
    <section class="bg-background section">
      <div class="shell">
        <SectionHead eyebrow={c.gating.eyebrow} title={c.gating.title} lead={c.gating.lead} />

        <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_19rem] lg:gap-14">
          <div class="reveal">
            <h3 class="label text-muted-foreground" id="lv-rules">{c.gating.rulesTitle}</h3>
            {/* Hairline-divided rows rather than bordered cards — four rules
                that share one rule are one list, not four objects. */}
            <dl
              aria-labelledby="lv-rules"
              class="mt-5 flex flex-col divide-y divide-hairline border-y border-hairline"
            >
              {
                c.gating.rules.map((rule) => (
                  <div class="py-6">
                    <dt class="subhead">{rule.rule}</dt>
                    <dd class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-muted-foreground">
                      {rule.why}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <aside class="panel h-fit p-6 lg:sticky lg:top-28">
            <p class="label text-muted-foreground">{c.gating.ageGate.label}</p>
            <p class="figure mt-3 text-[1.75rem] leading-none text-foreground">
              {eligibility.minAgeSermorelin}
            </p>
            <p class="mt-4 text-sm leading-relaxed text-muted-foreground">{c.gating.ageGate.body}</p>
          </aside>
        </div>

        <div class="panel reveal mt-12 max-w-4xl p-6 sm:p-8">
          <h3 class="subhead text-lg">{c.gating.interactions.title}</h3>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted-foreground">
            {c.gating.interactions.body}
          </p>
        </div>

        <div class="reveal mt-16">
          <h3 class="display-3">{c.gating.injection.title}</h3>
          <p class="lead mt-4">{c.gating.injection.lead}</p>

          {/* The metric strip again, this time carrying a sequence. Using one
              instrument twice on a page is what makes it read as an
              instrument; two different grids would read as two lists. */}
          <ol
            class="mt-9 grid gap-8 border-y border-border py-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-0 lg:divide-x lg:divide-border"
          >
            {
              c.gating.injection.steps.map((step, index) => (
                <li class="lg:px-6 lg:first:pl-0 lg:last:pr-0">
                  <p class="figure text-xs text-signal-700 dark:text-signal-500">
                    {String(index + 1).padStart(2, "0")}
                  </p>
                  <h4 class="subhead mt-2">{step.label}</h4>
                  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{step.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    {/* 5 — the chain, framed for this program. */}
    <section class="bg-card section">
      <div class="shell">
        <SectionHead
          eyebrow={c.relay.eyebrow}
          title={c.relay.title}
          lead={c.relay.lead}
          actionHref={localizedPath(locale, "/how-it-works/")}
          actionLabel={c.relay.cta}
        />

        <div class="reveal mt-12">
          <Relay locale={locale} variant="full" onLight />
        </div>
      </div>
    </section>

    {/* 6 — FAQ. The full set, and its FAQPage markup, lives on /faq/. */}
    <Faq
      locale={locale}
      eyebrow={c.faq.eyebrow}
      title={c.faq.title}
      items={c.faq.items}
      jsonLd={false}
      ctaHref={localizedPath(locale, "/faq/")}
      ctaLabel={c.faq.cta}
    />

    <Cta locale={locale} />
    <ComplianceBand locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>

<style>
  /**
   * The h1's break is rhetorical — one clause per line — and it only helps
   * where there is room for it. Below `sm` the headline reflows normally
   * rather than orphaning "so does the sentence." on a line of its own.
   *
   * `:global()` because `Headline.astro` emits the `<br>`: Astro's scoping
   * stamps this component's own elements, never a child component's, so a
   * scoped selector would compile to something that can never match.
   */
  :global(.hl-break-sm br) {
    display: none;
  }
  @media (min-width: 640px) {
    :global(.hl-break-sm br) {
      display: revert;
    }
  }
</style>
