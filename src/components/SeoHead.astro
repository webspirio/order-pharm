---
/**
 * Everything in <head> that a crawler reads: canonical, the hreflang set,
 * OG/Twitter, and the one JSON-LD block that declares the primary entity.
 *
 * THE ENTITY IS AN `Organization`, and that is a compliance decision rather
 * than an SEO one — `src/config/site.ts` argues it at length. Structured data
 * is the one place on the site a human reviewer never looks, so it is where a
 * `MedicalBusiness` or a `Pharmacy` could sit for a year saying the opposite
 * of every visible page. `scripts/verify-dist.mjs` now rejects those types on
 * built output, which is the only place they exist.
 *
 * THE @id CONTRACT: `<domain>/#business` is declared here, once per page, and
 * referenced — never redeclared — by `Faq.astro`'s FAQPage and the articles'
 * Article/BreadcrumbList blocks. verify-dist fails a page that references an
 * @id nothing on it declares, so this component must stay on every route and
 * that string must not change on one side alone.
 *
 * The offer catalog is the visible program copy, not a second description of
 * it: `src/i18n/en/programs.ts` is the single source, so the machine-readable
 * offer and the cards a reader sees cannot say different things. That copy is
 * edited often and by whoever owns the page, so nothing here depends on its
 * wording — only on its shape — and verify-dist asserts that each emitted
 * offer still carries the clinician-decides condition.
 */
import { type Locale, locales, defaultLocale, htmlLang, localizedPath, t } from "@/i18n";
import { site } from "@/config/site";
import { assetPath } from "@/config/site";

interface Props {
  locale: Locale;
  /** Default-locale-root path of this page, e.g. "/" or "/imprint/". */
  path?: string;
  /**
   * Skip the cross-locale hreflang loop and self-reference only. For pages
   * that exist as exactly one physical file regardless of locale — currently
   * just 404.astro, which Astro/Cloudflare special-case to a single flat
   * dist/404.html. Without this, the generic alternates loop below would
   * declare e.g. "/ua/404.html" as this locale's alternate even though no
   * such file is ever built (there is no per-locale 404), which
   * verify-dist.mjs's hreflang-reciprocity check correctly rejects.
   */
  selfOnly?: boolean;
}

const { locale, path = "/", selfOnly = false } = Astro.props;
const d = t(locale);

const canonicalHref = new URL(localizedPath(locale, path), site.domain).href;
const alternates = selfOnly
  ? [{ hreflang: htmlLang[locale], href: canonicalHref }]
  : locales.map((l) => ({
      hreflang: htmlLang[l],
      href: new URL(localizedPath(l, path), site.domain).href,
    }));
const xDefault = new URL(localizedPath(defaultLocale, path), site.domain).href;
const canonical = canonicalHref;
// `site.ogImage` is a /public path, so it needs the deployment base before it
// is made absolute — `new URL("/og-image.jpg", origin)` would drop the project
// path and point at a 404 on the github.io root.
const ogImage = new URL(assetPath(site.ogImage), site.domain).href;

/**
 * Recursively drop empty values so a site without an address, VAT id or
 * opening hours emits valid JSON-LD instead of a tree full of nulls.
 * Objects reduced to nothing but an `@type` are dropped entirely.
 */
function compact(value: unknown): unknown {
  if (Array.isArray(value)) {
    const items = value.map(compact).filter((v) => v !== undefined);
    return items.length ? items : undefined;
  }
  if (value && typeof value === "object") {
    const out: Record<string, unknown> = {};
    for (const [key, raw] of Object.entries(value)) {
      const cleaned = compact(raw);
      if (cleaned !== undefined) out[key] = cleaned;
    }
    const meaningful = Object.keys(out).filter((k) => k !== "@type");
    return meaningful.length ? out : undefined;
  }
  if (value === null || value === "" || value === undefined) return undefined;
  return value;
}

const hasAddress = Boolean(site.addressStreet && site.addressCountryCode);

/** Read once, defensively: the dictionary module this comes from is owned by
    whoever owns the program pages, and a head component is the wrong place to
    throw when someone is mid-edit on a card's copy. */
const programs = Array.isArray(d.programs?.items) ? d.programs.items : [];

const jsonLd = compact({
  "@context": "https://schema.org",
  "@type": site.schemaType,
  "@id": `${site.domain}/#business`,
  name: site.name,
  legalName: site.legalName,
  founder: site.owner,
  url: site.domain,
  image: ogImage,
  email: site.email,
  telephone: site.phoneDisplay,
  vatID: site.vatId,
  priceRange: site.priceRange,
  sameAs: site.sameAs,
  knowsLanguage: locales.map((l) => htmlLang[l]),
  address: hasAddress
    ? {
        "@type": "PostalAddress",
        streetAddress: site.addressStreet,
        postalCode: site.addressPostal,
        addressLocality: site.addressLocality,
        addressRegion: site.addressRegion,
        addressCountry: site.addressCountryCode,
      }
    : undefined,
  geo:
    site.geoLat !== undefined && site.geoLng !== undefined
      ? { "@type": "GeoCoordinates", latitude: site.geoLat, longitude: site.geoLng }
      : undefined,
  areaServed: site.areaServed
    ? { "@type": "Place", name: site.areaServed }
    : undefined,
  openingHoursSpecification: site.openingHours
    ? {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: site.openingHours.days,
        opens: site.openingHours.opens,
        closes: site.openingHours.closes,
      }
    : undefined,
  /**
   * The two programs, described with the same words the visible cards use —
   * `src/i18n/en/programs.ts` is the single source for both, so the
   * structured data cannot promise something the page does not say.
   *
   * `Service`, not `Drug` or `MedicalTherapy`: what Ellery offers is
   * coordination. Marking these up as drugs would assert in machine-readable
   * form the exact claim every page on this site disclaims.
   *
   * Guarded on the array rather than mapping it blind: a catalog with a name
   * and no offers is worse than no catalog, and `compact` cannot drop it
   * because the name alone keeps the object alive.
   */
  hasOfferCatalog: programs.length
    ? {
        "@type": "OfferCatalog",
        name: d.programs.title,
        itemListElement: programs.map((program) => ({
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: program.title,
            description: program.desc,
            provider: { "@id": `${site.domain}/#business` },
          },
        })),
      }
    : undefined,
});
---

{/* DEMONSTRATION SITE. robots.txt asks crawlers not to fetch; it does not
    stop a URL discovered elsewhere from being indexed, and only this meta tag
    does that. A fictional telehealth company with an invented pharmacy network
    must not surface for real medical queries. Remove both together — see the
    note at the top of public/robots.txt. */}
<meta name="robots" content="noindex, nofollow" />
<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
<link rel="alternate" hreflang="x-default" href={xDefault} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={site.name} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={site.name} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
