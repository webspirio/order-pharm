---
/**
 * /learn/ — the index, and the argument against a three-up grid.
 *
 * THE STRUCTURE IS THE HONEST ONE. There are three articles here. Three equal
 * cards in a row is the visual signature of a hub that has run out of things
 * to say: it spends the same amount of page on each piece and therefore says
 * nothing about which one to read. The rebuild takes React Bits' `blog-11`
 * arrangement instead — one framed featured essay beside a hairline-divided
 * list of compact rows — because it says "start with this one, and here are
 * the others", which is true of a three-article hub and is the same editorial
 * candour the rest of the site trades on.
 *
 * THE FRAME. The featured card is a `.panel` with a 12px inset around an
 * inner well at `rounded-lg`. The concentric radii are the whole point of the
 * device and they are arithmetic, not taste: an inner radius must equal the
 * outer minus the inset or the two curves visibly disagree. 24 − 12 = 12, so
 * the two radius families the design system allows land exactly on it. The
 * reference's own 28/8/20 does not survive contact with a 24px card, and
 * inventing a third radius to keep it would have been the wrong trade.
 *
 * THE DISCLAIMER MOVED UP, NOT DOWN. It used to sit under the lead; it now
 * takes the opposite pole of the header row. On a page whose whole job is to
 * be read by somebody researching a prescription medication, "information,
 * not medical advice" is the most load-bearing sentence on it, and the signal
 * rule down its left edge makes it the second-loudest object on the page
 * after the closing plate.
 *
 * WHAT WAS PORTED AND DELIBERATELY DROPPED from `blog-11`: the author byline
 * — a circular initials avatar, a name and a role. Ellery has no named
 * author, and attaching a person to "Clinically reviewed" is a possessive
 * over a clinician in everything but grammar. The reviewed-and-updated pair
 * takes that slot instead. Its `line-clamp-3`/`line-clamp-2` went too: the
 * deks carry hedged longevity wording, and a clamp that cuts "may support
 * healthy ageing" to "may support…" changes the claim rather than the layout.
 *
 * `scroll-stack` was offered for this page and rejected — see the note at the
 * foot of this file.
 */
import { type Locale, t, localizedPath } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import SeoHead from "@/components/SeoHead.astro";
import Headline from "@/components/Headline.astro";
import SectionHead from "@/components/SectionHead.astro";
import TrustTicker from "@/components/sections/TrustTicker.astro";
import Header from "@/components/sections/Header.astro";
import Cta from "@/components/sections/Cta.astro";
import ComplianceBand from "@/components/sections/ComplianceBand.astro";
import Footer from "@/components/sections/Footer.astro";
import { Image } from "astro:assets";
import learn01 from "@/assets/learn-01.jpg";
import learn02 from "@/assets/learn-02.jpg";
import learn03 from "@/assets/learn-03.jpg";
import { ArrowUpRight } from "lucide-react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

/** Thumbnails are matched by index, as on the homepage: the images are
    editorial rather than illustrative, so the dictionary does not own them. */
const thumbs = [learn01, learn02, learn03];

const cards = d.learn.articles.map((article, index) => ({
  ...article,
  image: thumbs[index % thumbs.length],
  href: localizedPath(locale, `/learn/${article.slug}/`),
}));

/** The dictionary's order is the editorial order, so the first entry is the
    featured one. Nothing here hard-codes a count: a fourth article joins the
    list, it does not break the layout. */
const [featured, ...rest] = cards;
---

<Layout locale={locale} title={d.meta.learn.title} description={d.meta.learn.description}>
  <SeoHead slot="head" locale={locale} path="/learn/" />
  <Header locale={locale} />
  <main id="main" tabindex="-1" class="outline-none">
    <section class="bg-background page-top pb-14 sm:pb-16">
      <div class="shell">
        {/* The header row's two poles, from blog-11. The reference puts a
            "browse the journal" pill in the right slot; on a hub with three
            articles that button goes to the page you are already on. The
            disclaimer is the thing worth promoting to that position. */}
        <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between lg:gap-14">
          <div class="max-w-2xl">
            <p class="label text-signal-700 dark:text-signal-500">{d.learn.eyebrow}</p>
            <Headline
              as="h1"
              reveal
              text={d.learn.headline}
              accent={d.learn.headlineAccent}
              class="display-1 mt-5 text-balance"
            />
            <p class="lead mt-6">{d.learn.lead}</p>
          </div>

          <aside
            class="panel w-full shrink-0 border-l-2 border-l-signal-500 p-6 lg:mt-2 lg:max-w-sm"
          >
            <p class="label text-signal-700 dark:text-signal-500">
              {d.learn.article.disclaimerLabel}
            </p>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-foreground">{d.learn.disclaimer}</p>
          </aside>
        </div>
      </div>
    </section>

    {/* The ticker closes the head block, the same slot it takes under the
        hero on the homepage. It cannot sit above the nav any more: the
        header floats. */}
    <TrustTicker locale={locale} />

    <section class="bg-card section">
      <div class="shell">
        <div class="reveal grid grid-cols-1 items-start gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
          {/* ---------------- The featured essay ---------------- */}
          <div>
            <p class="label text-muted-foreground">{d.learn.featuredLabel}</p>

            {/* `bg-background` because a `.panel` on a `bg-card` band is the
                same white as the band and disappears. The border recolours to
                the signal on hover, which is what `a.panel:hover` does
                globally — the rule cannot reach here because the link is the
                title rather than the whole card. */}
            <article
              class="panel group relative mt-4 bg-background p-3 transition-colors hover:border-signal-500"
            >
              <div class="relative aspect-[16/10] overflow-hidden rounded-lg bg-muted">
                <Image
                  src={featured.image}
                  alt=""
                  widths={[480, 720, 1080]}
                  sizes="(min-width: 1024px) 32rem, (min-width: 640px) 90vw, 100vw"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  loading="lazy"
                />
                <p
                  class="label absolute left-4 top-4 rounded-lg bg-background/90 px-3 py-1.5 text-foreground backdrop-blur"
                >
                  {featured.category}
                </p>
              </div>

              <div class="px-3 pb-3 pt-6 sm:px-4 sm:pb-4">
                <p class="figure text-xs tracking-normal text-muted-foreground">
                  {featured.readMinutes}{" "}
                  <span class="label font-normal tracking-normal">{d.learn.readTime}</span>
                </p>
                {/* ONE link per card, and it wraps the title only, so the
                    accessible name is the headline rather than the headline
                    with a category and a read time concatenated in front of
                    it. The overlay makes the whole card the hit area. */}
                <h2 class="display-3 mt-3 text-pretty">
                  <a
                    href={featured.href}
                    class="transition-colors after:absolute after:inset-0 group-hover:text-signal-700 dark:group-hover:text-signal-500"
                  >
                    {featured.title}
                  </a>
                </h2>
                <p class="mt-3.5 text-[0.9375rem] leading-relaxed text-pretty text-muted-foreground">
                  {featured.dek}
                </p>

                {/* Where blog-11 puts an author. Ellery has none, and the two
                    facts a reader of a medical explainer actually wants are
                    that a clinician checked it and when. */}
                <div
                  class="mt-7 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-border pt-4"
                >
                  <p class="label text-signal-700 dark:text-signal-500">{d.learn.reviewedBy}</p>
                  <p class="label text-muted-foreground">
                    {d.learn.updated}{" "}
                    <time datetime={featured.updatedIso} class="figure font-normal tracking-normal">
                      {featured.updated}
                    </time>
                  </p>
                </div>
              </div>
            </article>
          </div>

          {/* ---------------- The rest, as rows ---------------- */}
          <div class="lg:pt-1">
            <p class="label text-muted-foreground">{d.learn.moreLabel}</p>

            <ul class="mt-4">
              {
                rest.map((card) => (
                  <li class="group relative grid grid-cols-[auto_1fr_auto] items-center gap-4 border-t border-border py-6 last:border-b sm:gap-5 sm:py-8">
                    <div class="aspect-[4/3] w-24 shrink-0 overflow-hidden rounded-lg bg-muted sm:w-28">
                      <Image
                        src={card.image}
                        alt=""
                        widths={[112, 224, 336]}
                        sizes="7rem"
                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                        loading="lazy"
                      />
                    </div>

                    <div class="min-w-0">
                      <p class="label flex flex-wrap items-center gap-2.5 text-muted-foreground">
                        <span class="text-signal-700 dark:text-signal-500">{card.category}</span>
                        <span aria-hidden="true">·</span>
                        <span class="figure font-normal tracking-normal">
                          {card.readMinutes} {d.learn.readTime}
                        </span>
                        <span aria-hidden="true">·</span>
                        <span>
                          {d.learn.updated}{" "}
                          <time datetime={card.updatedIso} class="figure font-normal tracking-normal">
                            {card.updated}
                          </time>
                        </span>
                      </p>
                      {/* No dek on a row. The alternative is a clamp, and a
                          clamped dek can truncate a hedged claim mid-clause. */}
                      <h2 class="subhead mt-2 text-pretty">
                        <a
                          href={card.href}
                          class="transition-colors after:absolute after:inset-0 group-hover:text-signal-700 dark:group-hover:text-signal-500"
                        >
                          {card.title}
                        </a>
                      </h2>
                    </div>

                    <ArrowUpRight
                      className="size-4 shrink-0 text-muted-foreground transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                      aria-hidden="true"
                    />
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-background section">
      <div class="shell">
        <SectionHead
          eyebrow={d.learn.standards.eyebrow}
          title={d.learn.standards.title}
          class="max-w-3xl"
        />

        {/* Kept as a numbered list on hairlines rather than promoted to cards.
            These are four rules, and a rule is a line of text; putting each in
            a bordered box would be four containers carrying nothing. */}
        <ol class="reveal mt-10 grid max-w-5xl gap-x-10 gap-y-6 sm:grid-cols-2">
          {
            d.learn.standards.items.map((item, index) => (
              <li class="flex gap-4 border-t border-hairline pt-5">
                <span class="figure shrink-0 text-xs text-signal-700 dark:text-signal-500">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <p class="text-[0.9375rem] leading-relaxed text-muted-foreground">{item}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <Cta locale={locale} />
    <ComplianceBand locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>

{/*
  WHY `src/components/react-bits/scroll-stack.tsx` IS NOT HERE, having been
  offered for this page and read:

  1. Its cards are `absolute inset-0` siblings inside a `sticky h-screen`
     viewport, positioned entirely by a rAF loop writing inline transforms.
     Un-hydrated it renders three articles stacked on top of one another. The
     design system's fourth motion rule — the base state is the final state —
     is not a preference here, it is the difference between an index and a
     blank screen with JavaScript disabled.
  2. Hydrating it would put the only client:* island on this route in front of
     the only content on this route, and would cost a viewport height of
     scroll per article. Three links are not worth three screens.
  3. It throws away the thing the reader came for. A stack shows one card at a
     time; the whole argument above is that the reader should be able to see
     which piece is the featured one and what the other two are in a single
     glance. The static arrangement is the better information design, and it
     costs nothing.
*/}
