---
/**
 * /learn/ — the index.
 *
 * Three decisions worth stating:
 *
 * 1. The disclaimer is a designed block directly under the heading, not a grey
 *    line in the footer. On a page whose whole job is to be read by somebody
 *    researching a prescription medication, "information, not medical advice"
 *    is the most load-bearing sentence on it, and burying it is the tell that
 *    a content hub exists to rank rather than to inform.
 * 2. The cards reuse `LearnPreview.astro`'s pattern exactly, reading the same
 *    `d.learn.articles` array, so an article cannot advertise one title on the
 *    homepage and another here.
 * 3. The editorial-standards block is the one differentiator a content hub can
 *    claim that a competitor cannot copy without changing how it works: the
 *    figures are imported from the same file the checkout reads.
 */
import { type Locale, t, localizedPath } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import SeoHead from "@/components/SeoHead.astro";
import TrustTicker from "@/components/sections/TrustTicker.astro";
import Header from "@/components/sections/Header.astro";
import Cta from "@/components/sections/Cta.astro";
import ComplianceBand from "@/components/sections/ComplianceBand.astro";
import Footer from "@/components/sections/Footer.astro";
import { Image } from "astro:assets";
import learn01 from "@/assets/learn-01.jpg";
import learn02 from "@/assets/learn-02.jpg";
import learn03 from "@/assets/learn-03.jpg";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

/** Thumbnails are matched by index, as on the homepage: the images are
    editorial rather than illustrative, so the dictionary does not own them. */
const thumbs = [learn01, learn02, learn03];

const cards = d.learn.articles.map((article, index) => ({
  ...article,
  image: thumbs[index % thumbs.length],
  href: localizedPath(locale, `/learn/${article.slug}/`),
}));
---

<Layout locale={locale} title={d.meta.learn.title} description={d.meta.learn.description}>
  <SeoHead slot="head" locale={locale} path="/learn/" />
  <Header locale={locale} />
  <main id="main" tabindex="-1" class="outline-none">
    <section class="bg-background page-top pb-14 sm:pb-16">
      <div class="shell">
        <p class="label text-brand-700 dark:text-brand-400">{d.learn.eyebrow}</p>
        <h1 class="display-1 mt-5 max-w-4xl">{d.learn.title}</h1>
        <p class="lead mt-6 text-lg">{d.learn.lead}</p>

        <aside class="panel mt-10 max-w-3xl border-l-2 border-l-brand-600 p-6 dark:border-l-brand-400">
          <p class="label text-brand-700 dark:text-brand-400">{d.learn.article.disclaimerLabel}</p>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-foreground">{d.learn.disclaimer}</p>
        </aside>
      </div>
    </section>

    {/* The ticker closes the head block, the same slot it takes under the
        hero on the homepage. It cannot sit above the nav any more: the
        header floats. */}
    <TrustTicker locale={locale} />

    <section class="bg-card section">
      <div class="shell">
        <ul class="grid gap-6 md:grid-cols-3 lg:gap-8">
          {
            cards.map((card) => (
              <li>
                <a
                  href={card.href}
                  class="panel group flex h-full flex-col overflow-hidden bg-background"
                >
                  <div class="aspect-[16/10] overflow-hidden">
                    <Image
                      src={card.image}
                      alt=""
                      widths={[400, 640, 800]}
                      sizes="(min-width: 768px) 22rem, 100vw"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                      loading="lazy"
                    />
                  </div>
                  <div class="flex flex-1 flex-col p-6">
                    <p class="label flex items-center gap-3 text-muted-foreground">
                      <span class="text-brand-700 dark:text-brand-400">{card.category}</span>
                      <span aria-hidden="true">·</span>
                      <span class="figure font-normal tracking-normal">
                        {card.readMinutes} {d.learn.readTime}
                      </span>
                    </p>
                    <h2 class="subhead mt-3 text-[1.0625rem]">{card.title}</h2>
                    <p class="mt-2.5 flex-1 text-sm leading-relaxed text-muted-foreground">
                      {card.dek}
                    </p>
                    <div class="mt-5 flex items-center justify-between gap-3 border-t border-border pt-4">
                      <p class="label text-brand-700 dark:text-brand-400">{d.learn.reviewedBy}</p>
                      <time
                        datetime={card.updatedIso}
                        class="figure shrink-0 text-xs text-muted-foreground"
                      >
                        {card.updated}
                      </time>
                    </div>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="bg-background section">
      <div class="shell">
        <div class="max-w-3xl">
          <p class="label text-brand-700 dark:text-brand-400">{d.learn.standards.eyebrow}</p>
          <h2 class="display-2 mt-4">{d.learn.standards.title}</h2>
        </div>

        <ol class="mt-10 grid max-w-5xl gap-x-10 gap-y-6 sm:grid-cols-2">
          {
            d.learn.standards.items.map((item, index) => (
              <li class="flex gap-4 border-t border-border pt-5">
                <span class="figure shrink-0 text-xs text-signal-500">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <p class="text-[0.9375rem] leading-relaxed text-muted-foreground">{item}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <Cta locale={locale} />
    <ComplianceBand locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
